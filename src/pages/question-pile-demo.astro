---
// Internal concept preview — not a real site page, not linked from
// navigation. Delete once the "question pile" idea has been decided on
// / integrated into google-social-ads.astro (or discarded). Same pattern
// as the earlier campfire-demo.astro.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";
import QuestionPile from "../components/QuestionPile.astro";
---
<Layout title="Question Pile Concept (Internal)">
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/question-pile-demo" />

    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-20 md:pb-28">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <Eyebrow class="mb-3">Internal concept — not a real page</Eyebrow>
        <Heading as="h1" class="mb-4">Question pile, for the Google Ads hero</Heading>
        <p class="text-[var(--color-slate)]">
          v3: questions drop in one at a time, each landing on top of the last&mdash;the
          pile visibly grows taller as more land, rather than spreading sideways or
          bursting across the whole stage. No arrow cue (that was just mockup shorthand
          for "these are falling", not meant to ship). Chips alternate between Anton (a
          bold "stamped headline" font) and Caveat (the campfire toggle's handwritten
          accent font), each at a randomised size, for a more chaotic, overwhelmed feel
          &mdash; deliberately without a distortion/grunge filter for texture, since that
          hurt legibility when tried on the how-we-work icons earlier. The resolution
          line still switches to the site's normal type once the pile finishes, so that
          font change alone still carries the "mess &rarr; clarity" idea.
        </p>
      </div>

      <div class="max-w-3xl mx-auto">
        <QuestionPile />
      </div>

      <p class="text-center text-sm text-[var(--color-slate-light)] mt-6">
        Runs automatically on load, or hit Replay. Try it a few times&mdash;each run
        shuffles a different mix of the question set.
      </p>
    </section>
  </div>

  <Footer />
</Layout>

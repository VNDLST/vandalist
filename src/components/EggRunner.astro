---
// "Interactive Eggs-ercise" — Marketing Support hero graphic, per
// Andrew's supplied CodePen (Chris Gannon, MIT licensed):
// https://codepen.io/chrisgannon/pen/Vbzwyg — a Bodymovin/Lottie
// character running on a treadmill, speed controlled by dragging a
// slider. The animation JSON at public/marketing-support-hero/
// egg-runner.json is Chris Gannon's original data recoloured to the
// site's own tokens (accent pink/ink/slate/paper-dim in place of the
// original blue background + orange/gold character) via a one-off
// script, not hand-edited — see git history if this ever needs
// redoing from a fresh copy of the source. LICENSE.txt in that same
// folder is his original MIT license, kept per its own terms.
//
// **Explicitly provisional per Andrew:** "I am not sure of the license
// type but even if it is in place for now until I am clear if it will
// work or not would be good." Two separate licenses are actually in
// play here, worth keeping distinct: the Pen's own code (MIT,
// permissive) and GSAP itself, newly added as a dependency for the
// drag interaction — GSAP ships under its own "Standard no-charge
// license" (gsap.com/standard-license), not MIT. Don't treat either
// as settled; ask before treating this as a permanent fixture.
//
// Sized to fit within the hero's existing content-height budget
// (aspect-ratio 4:3 matching the source's 800x600 canvas, capped
// height) rather than dictating the hero's height itself — same
// lesson as Google Ads' QuestionPile: an oversized hero graphic just
// re-breaks the "match Home's 706px" fix that was the other half of
// this same request.
---
<div class="egg-runner" aria-hidden="true">
  <div id="eggAnimStage" class="egg-runner__stage"></div>
  <svg viewBox="0 0 800 600" class="egg-runner__drag-svg">
    <g transform="translate(156, 509)">
      <g class="egg-runner__dragger">
        <rect x="1.5" y="1.5" width="60" height="36" rx="18" ry="18" fill="var(--color-ink)" stroke="var(--color-accent)" stroke-width="3" />
        <polyline points="41.5 12.08 48.92 19.5 41.5 26.92" fill="none" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        <polyline points="21.5 26.92 14.08 19.5 21.5 12.08" fill="none" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  </svg>
</div>

<script>
  import lottie from "lottie-web";
  import { gsap } from "gsap";
  import { Draggable } from "gsap/Draggable";

  gsap.registerPlugin(Draggable);

  const stage = document.querySelector("#eggAnimStage");
  const dragger = document.querySelector(".egg-runner__dragger");

  if (stage && dragger) {
    const anim = lottie.loadAnimation({
      wrapper: stage,
      renderer: "svg",
      loop: true,
      autoplay: true,
      prerender: true,
      path: `${import.meta.env.BASE_URL}/marketing-support-hero/egg-runner.json`,
    });

    const dragMaxX = 444;
    const maxRunSpeed = 2;

    function onDrag() {
      const dragPercent = gsap.getProperty(dragger, "x") / dragMaxX;
      anim.setSpeed(dragPercent * maxRunSpeed);
    }

    Draggable.create(dragger, {
      type: "x",
      bounds: { minX: 0, maxX: dragMaxX },
      onDrag,
      onDoubleClick() {
        gsap.to(dragger, { x: dragMaxX / 2, onUpdate: onDrag });
      },
    });

    // Start at the midpoint (half speed) rather than the original pen's
    // stopped-at-zero start, so the character is already moving on load.
    gsap.set(dragger, { x: dragMaxX / 2 });
    onDrag();
  }
</script>

<style>
  .egg-runner {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 320px;
    margin: 0 auto;
  }
  .egg-runner__stage,
  .egg-runner__drag-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .egg-runner__dragger {
    cursor: grab;
    -webkit-tap-highlight-color: transparent;
  }
  .egg-runner__dragger:active {
    cursor: grabbing;
  }
</style>

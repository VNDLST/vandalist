---
// Internal concept preview — not a real site page, not linked from
// navigation. Delete once a treatment (or "none") is decided on for the
// "How engagements are structured" icon set on how-we-work.astro.
//
// Compares CSS-only ways to soften/rough-up the cadence-step icons (align,
// priority, execute, learn, grow) so they sit better next to the line-style
// icons in the section above, without redesigning or replacing the assets:
//   - wash: plain CSS filter (saturate/opacity/contrast) — a softer, less
//     saturated version of the icon, nothing structural.
//   - grunge: an SVG filter (feTurbulence -> feDisplacementMap) that warps
//     the icon's edges using fractal noise, applied via CSS `filter: url(#..)`
//     on a plain <img> — no source file changes needed. Two intensities
//     (light/heavy) so the amount of roughening is easy to compare.
//   - wash + grunge combined, at both intensities.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";

const base = import.meta.env.BASE_URL;
const icons = ["align", "priority", "execute", "learn", "grow"];

const variants = [
  { label: "Current (no treatment)", class: "" },
  { label: "Washed out (saturate/opacity/contrast only)", class: "icon-wash" },
  { label: "Grunge edges — light", class: "icon-grunge-light" },
  { label: "Grunge edges — heavy", class: "icon-grunge-heavy" },
  { label: "Washed out + grunge — light (recommended starting point)", class: "icon-wash icon-grunge-light" },
  { label: "Washed out + grunge — heavy", class: "icon-wash icon-grunge-heavy" },
];
---
<Layout title="Icon Texture Concept (Internal)">
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/icon-texture-demo" />

    <!-- Hidden SVG filter definitions — these are what `filter: url(#...)`
         references from the CSS classes below. feTurbulence generates
         fractal noise; feDisplacementMap uses that noise to warp the
         icon's pixels (including its alpha edge), which is what reads as
         "roughened/torn" rather than just blurred. The -20%/140% region
         keeps displaced pixels from clipping at the icon's bounding box. -->
    <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
      <defs>
        <filter id="grunge-light" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="grunge-heavy" x="-30%" y="-30%" width="160%" height="160%">
          <feTurbulence type="fractalNoise" baseFrequency="0.15" numOctaves="3" seed="3" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="16" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-20 md:pb-28">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <Eyebrow class="mb-3">Internal concept — not a real page</Eyebrow>
        <Heading as="h1" class="mb-4">Icon texture options for "How engagements are structured"</Heading>
        <p class="text-[var(--color-slate)]">
          Same 5 icons (align, priority, execute, learn, grow) across six treatments — CSS only,
          nothing about the source SVG files changes. First row is what's live now, for reference.
        </p>
      </div>

      <div class="space-y-14">
        {variants.map((variant) => (
          <div>
            <p class="text-sm font-semibold text-[var(--color-ink)] mb-5">{variant.label}</p>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
              {icons.map((icon) => (
                <div class="flex flex-col items-center">
                  <div class="w-28 h-28 rounded-full bg-white [box-shadow:var(--shadow-card)] flex items-center justify-center shrink-0">
                    <img
                      src={`${base}/how-we-work-icons/${icon}.svg`}
                      alt={icon}
                      class:list={["w-16 h-16 object-contain", variant.class]}
                    />
                  </div>
                  <p class="text-xs text-[var(--color-slate-light)] mt-2">{icon}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <p class="text-center text-sm text-[var(--color-slate-light)] mt-16">
        Let me know which (if any) reads right, or if the amount needs dialling up/down —
        the scale/frequency numbers behind each treatment are easy to retune.
      </p>
    </section>
  </div>

  <Footer />
</Layout>

<style>
  .icon-wash {
    filter: saturate(55%) opacity(0.85) contrast(0.95);
  }
  .icon-grunge-light {
    filter: url(#grunge-light);
  }
  .icon-grunge-heavy {
    filter: url(#grunge-heavy);
  }
  /* Tailwind's class:list doesn't merge multiple `filter` declarations from
     separate classes (last one wins, it isn't additive like transform
     utilities are) — so the combined wash+grunge rows need their own
     explicit chained-filter class rather than relying on both classes
     applying at once. */
  .icon-wash.icon-grunge-light {
    filter: url(#grunge-light) saturate(55%) opacity(0.85) contrast(0.95);
  }
  .icon-wash.icon-grunge-heavy {
    filter: url(#grunge-heavy) saturate(55%) opacity(0.85) contrast(0.95);
  }
</style>

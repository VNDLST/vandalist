---
// Internal concept preview — not a real site page, not linked from
// navigation. Delete once a treatment (or "none") is decided on for the
// icon set on how-we-work.astro (cadence steps + the "how we fit in" icon).
//
// v1 (scrapped per feedback): CSS-only wash/desaturate + SVG feTurbulence
// "grunge edge" filters. Verdict: changing the colour wasn't wanted at
// all, and the edge-distortion made the heavy variant unreadable while
// the light variant barely reduced how "chunky"/solid the icons felt —
// distorting edges doesn't address solid fill area, which was the actual
// complaint.
//
// v2 (this version): recolour specific sub-paths within each icon rather
// than applying a blanket effect. Every one of these icons already
// separates into a big "main" shape (the recognisable subject) plus small
// "accent" details (dots, connector lines, decorative marks) as distinct
// paths in the source SVG — kept the main shape in the brand pink
// (#ff3d6a, unchanged) and moved just the small accents to --color-ink
// (#1c1b1a, the site's existing dark text/button colour). Reduces how
// much solid pink area each icon covers without touching its silhouette
// or legibility. New files live in public/how-we-work-icons-2tone/,
// originals untouched.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";

const base = import.meta.env.BASE_URL;
const cadenceIcons = ["align", "priority", "execute", "learn", "grow"];
---
<Layout title="Icon Two-Tone Concept (Internal)">
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/icon-texture-demo" />

    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-20 md:pb-28">
      <div class="max-w-2xl mx-auto text-center mb-14">
        <Eyebrow class="mb-3">Internal concept — not a real page</Eyebrow>
        <Heading as="h1" class="mb-4">Two-tone icons: main shape stays pink, accents go dark</Heading>
        <p class="text-[var(--color-slate)]">
          Same icons, colour otherwise untouched — only the small decorative details (dots,
          connector lines, little accent marks) move from pink to <code>--color-ink</code>.
          The big recognisable shape in each one stays exactly the brand pink it already is.
        </p>
      </div>

      <div class="space-y-14">
        <div>
          <p class="text-sm font-semibold text-[var(--color-ink)] mb-5">Current (single tone, for reference)</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
            {cadenceIcons.map((icon) => (
              <div class="flex flex-col items-center">
                <div class="w-28 h-28 rounded-full bg-white [box-shadow:var(--shadow-card)] flex items-center justify-center shrink-0">
                  <img src={`${base}/how-we-work-icons/${icon}.svg`} alt={icon} class="w-16 h-16 object-contain" />
                </div>
                <p class="text-xs text-[var(--color-slate-light)] mt-2">{icon}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <p class="text-sm font-semibold text-[var(--color-ink)] mb-5">Two-tone: main shape pink, accents dark</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
            {cadenceIcons.map((icon) => (
              <div class="flex flex-col items-center">
                <div class="w-28 h-28 rounded-full bg-white [box-shadow:var(--shadow-card)] flex items-center justify-center shrink-0">
                  <img src={`${base}/how-we-work-icons-2tone/${icon}.svg`} alt={icon} class="w-16 h-16 object-contain" />
                </div>
                <p class="text-xs text-[var(--color-slate-light)] mt-2">{icon}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <p class="text-sm font-semibold text-[var(--color-ink)] mb-5">
            "How we fit in" icon — current vs. two-tone
          </p>
          <div class="flex gap-16">
            <div class="flex flex-col items-center">
              <img src={`${base}/how-we-work-icons/interact.svg`} alt="interact" class="w-20 h-20 object-contain" />
              <p class="text-xs text-[var(--color-slate-light)] mt-2">current</p>
            </div>
            <div class="flex flex-col items-center">
              <img src={`${base}/how-we-work-icons-2tone/interact.svg`} alt="interact two-tone" class="w-20 h-20 object-contain" />
              <p class="text-xs text-[var(--color-slate-light)] mt-2">two-tone</p>
            </div>
          </div>
        </div>
      </div>

      <p class="text-center text-sm text-[var(--color-slate-light)] mt-16">
        If the split reads right, this is a straightforward swap into the real page. If the
        specific choice of which bits went dark feels off for any one icon, easy to redo —
        just say which one.
      </p>
    </section>
  </div>

  <Footer />
</Layout>

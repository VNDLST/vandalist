---
// The standard content section: centred 7xl column with the site's side
// padding and ONE standard bottom spacing (pb-16 md:pb-20, i.e. 4rem on phones,
// 5rem from tablet up). Andrew chose that single rhythm on 2026-10-27 (an audit
// had found 8 different recipes, e.g. How We Work and About used 5rem/7rem); if it
// feels too tight, change it here and every section follows.
//
//   top    add the same 4rem / 5rem to the TOP. Use it on the first section under
//          a hero (a hero band must never sit flush against the next section) and
//          wherever the section above has no bottom spacing of its own.
//   class  rare extras only (not spacing: use the standard).
//
// Wide tinted panels are a separate component: <Band>.
interface Props {
  top?: boolean;
  class?: string;
}
const { top = false, class: className } = Astro.props as Props;
---
<section class:list={["max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-20", top && "pt-16 md:pt-20", className]}>
  <slot />
</section>

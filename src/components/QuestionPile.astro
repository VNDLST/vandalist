---
// "Question pile" concept for the Google Ads page's currently-empty hero
// graphic slot: questions drop in one at a time, each landing on top of
// the last — building a genuine pile that visibly grows TALLER (starts
// ~1-2 questions high, ends up ~7-8 high), then it clears to a single
// calm resolution line.
//
// v2 was per Andrew's reference sketch: one question at a time, a visible
// downward arrow cueing each drop, landing with increasing rotation/spread
// anchored to one point. v1 before that was a rapid *scattered burst*
// across the whole stage (~42 chips at random positions, mechanic adapted
// from the idea of mattdesl's "codevember" day 9 sketch — see git history
// on this file for that reasoning).
//
// v3 (this version), per Andrew's feedback after seeing v2 live:
// - Arrow removed entirely — it was only there in his mockup to indicate
//   "these are falling", not meant to ship.
// - v2's landing spread was closer to a radial FAN (jitter growing outward
//   in all directions from one point) than a physical PILE (things stacked
//   on top of each other, growing in height). Reworked the positioning so
//   each chip's resting spot rises a fixed step further up the stage than
//   the last, on top of a much tighter horizontal jitter — reads as a
//   stack gaining height, not a burst spreading sideways.
// - Chips now alternate between Anton (blocky stamp) and Caveat (the same
//   handwritten font as the campfire toggle's label), each at a randomised
//   size, per Andrew's "different sizes and possibly different fonts...
//   to create a feeling of chaos" — more visual variety than a single
//   consistent typeface gives, without reaching for a distortion/grunge
//   filter (shelved earlier for the how-we-work icons specifically because
//   it hurt legibility, and legibility matters even more for sentences).
export interface Props {
  questions?: string[];
  resolutionHeading?: string;
  resolutionText?: string;
}

const {
  questions = [
    "What's my budget?",
    'Why is my CPC so high?',
    'Manual or automatic bidding?',
    "What's Quality Score?",
    "Why aren't my ads showing?",
    'Is this even working?',
    "What's a good CTR?",
    'Negative keywords?',
    'Am I targeting the right people?',
    'Why did conversions drop?',
    "What's ROAS mean?",
    'Should I pause this?',
    'Is my landing page the problem?',
    "Who's managing this daily?",
    "Why is my competitor above me?",
    'Search vs Display campaign?',
    'Is tracking even set up right?',
    "How much is 'too much' to spend?",
    "What's Smart Bidding?",
    'Why did my Quality Score drop?',
    'Should I worry about invalid clicks?',
    'What even is an ad group?',
    'Is this actually bringing in leads?',
    'Why does this dashboard make no sense?',
  ],
  resolutionHeading = 'We handle all of this for you.',
  resolutionText = 'Plain-English updates. None of the jargon headache.',
} = Astro.props;
---

<div class="qpile" data-qpile-root>
  <div class="qpile-stage" data-qpile-stage aria-hidden="true"></div>

  <div class="qpile-resolution" data-qpile-resolution>
    <span class="qpile-resolution-dot" aria-hidden="true"></span>
    <p class="qpile-resolution-heading">{resolutionHeading}</p>
    <p class="qpile-resolution-text">{resolutionText}</p>
  </div>

  <button type="button" class="qpile-replay" data-qpile-replay aria-label="Replay animation">
    ↻ Replay
  </button>
</div>

<style>
  .qpile {
    position: relative;
    width: 100%;
    border-radius: var(--radius-card);
    background: var(--color-paper-dim);
    overflow: hidden;
  }

  .qpile-stage {
    position: relative;
    width: 100%;
    height: 340px;
  }
  @media (min-width: 768px) {
    .qpile-stage {
      height: 420px;
    }
  }

  .qpile-resolution {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 2rem;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 500ms ease, transform 500ms ease;
  }
  .qpile-resolution.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .qpile-resolution-dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    margin-bottom: 1rem;
    background: var(--gradient-orb);
    box-shadow: var(--shadow-orb);
  }
  .qpile-resolution-heading {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
    max-width: 22rem;
  }
  @media (min-width: 768px) {
    .qpile-resolution-heading {
      font-size: 1.625rem;
    }
  }
  .qpile-resolution-text {
    font-size: 0.9375rem;
    color: var(--color-slate);
  }

  .qpile-replay {
    position: absolute;
    bottom: 0.85rem;
    right: 0.85rem;
    z-index: 5;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-slate);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .qpile-replay:hover {
    border-color: var(--color-slate);
    color: var(--color-ink);
  }
</style>

<!-- Deliberately a SEPARATE, global (unscoped) style block: .qchip elements
     are created client-side via document.createElement, not by Astro's own
     render — they never get the data-astro-cid attribute Astro's normal
     scoped-<style> selectors require, so scoping this block would silently
     match nothing. Confirmed via computed style (position/transform coming
     back as the browser defaults, none of this actually applying) before
     splitting it out — this bug predates this session's changes and quietly
     affected the very first "scattered burst" version too, not just this
     rewrite. Class names are specific enough (qchip, qpile-*) that going
     unscoped here is a low collision risk. -->
<style is:global>
  /* Each question: bare bold text (no card/border — matches the reference,
     and keeps it legible; font-family/size are set inline per chip in JS
     for variety, not fixed here). Anchored near the stage's bottom
     (top: 80%); --rise (how far up from that anchor this chip sits, set
     in JS, growing with pile index) is what makes the pile grow TALLER as
     more land, rather than spreading sideways — --jx is a much smaller
     jitter on top of that, just enough to look like a leaning stack, not
     a scattered burst. `scale` is its own standalone CSS property (not
     part of `transform`) specifically so the clearing shrink can
     transition independently of the rotate/translate that live in
     `transform` — both animate at once with no conflict. */
  .qchip {
    position: absolute;
    left: 50%;
    top: 80%;
    transform: translate(-50%, -50%) translate(var(--jx, 0px), 0) translateY(calc(var(--rise, 0px) * -1)) rotate(var(--r, 0deg)) translateY(-70px);
    scale: 0.94;
    max-width: 260px;
    line-height: 1.15;
    color: var(--color-ink);
    text-align: center;
    text-wrap: balance;
    opacity: 0;
    pointer-events: none;
    transition: transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1), scale 520ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 260ms ease;
  }
  .qchip.is-in {
    scale: 1;
    opacity: 1;
    transform: translate(-50%, -50%) translate(var(--jx, 0px), 0) translateY(calc(var(--rise, 0px) * -1)) rotate(var(--r, 0deg));
  }
  .qpile-stage.is-clearing .qchip {
    scale: 0.7;
    opacity: 0;
    transition: scale 320ms ease, opacity 320ms ease;
  }
</style>

<script define:vars={{ questions }}>
  function shuffle(input) {
    const arr = input.slice();
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  // Anton (blocky stamp) and Caveat (the campfire toggle's handwritten
  // accent font) alternate per chip — deliberate variety, not a single
  // consistent typeface, per Andrew's "different sizes and possibly
  // different fonts... to create a feeling of chaos".
  const FONT_ANTON = "'Anton', sans-serif";
  const FONT_CAVEAT = "'Caveat', cursive";

  document.querySelectorAll('[data-qpile-root]').forEach((root) => {
    const stage = root.querySelector('[data-qpile-stage]');
    const resolution = root.querySelector('[data-qpile-resolution]');
    const replayBtn = root.querySelector('[data-qpile-replay]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CHIP_COUNT = reduceMotion ? 4 : 8;
    const STEP_DELAY = reduceMotion ? 0 : 650; // gap between one chip landing and the next dropping

    let timer = null;
    let runToken = 0;

    // Rotation/horizontal jitter grow with pile index (a real stack leans
    // more as it gets taller/more precarious) but stay tight — the visual
    // cue that reads as "a pile getting taller" is --rise, which climbs a
    // fixed step per chip so each one settles further up the stage than
    // the last, on top of the one before it.
    function spawnChip(text, index) {
      const chip = document.createElement('div');
      chip.className = 'qchip';
      chip.textContent = text;

      const rotateMagnitude = Math.min(5 + index * 2.2, 18);
      const rotate = ((Math.random() * 2 - 1) * rotateMagnitude).toFixed(1);
      const jx = ((Math.random() * 2 - 1) * Math.min(6 + index * 3.5, 34)).toFixed(0);
      // 21px/layer, not 24 — found via testing that 24 left the tallest
      // chip in an 8-high pile clipping the top edge of the (shorter)
      // mobile stage by a couple of px on an unlucky rotation/text-wrap
      // combination. 21 leaves comfortable headroom at every size tested.
      const rise = (index * 21 + (Math.random() * 10 - 5)).toFixed(1);

      const isScript = Math.random() < 0.35;
      const fontSize = isScript
        ? (1.3 + Math.random() * 0.5).toFixed(2) // Caveat reads smaller than Anton at the same px size, so run it bigger
        : (1.05 + Math.random() * 0.45).toFixed(2);

      chip.style.setProperty('--r', `${rotate}deg`);
      chip.style.setProperty('--jx', `${jx}px`);
      chip.style.setProperty('--rise', `${rise}px`);
      chip.style.fontFamily = isScript ? FONT_CAVEAT : FONT_ANTON;
      chip.style.fontWeight = isScript ? '600' : '400';
      chip.style.fontSize = `${fontSize}rem`;
      chip.style.zIndex = String(10 + index);
      stage.appendChild(chip);
      // Double rAF so the browser commits the initial (scale: .94, opacity: 0,
      // translateY(-70px)) state to a frame before .is-in flips the
      // transition target — a same-tick class add wouldn't animate, it'd
      // just jump straight to the end state.
      requestAnimationFrame(() => requestAnimationFrame(() => chip.classList.add('is-in')));
    }

    function run() {
      const token = ++runToken;
      clearTimeout(timer);
      stage.classList.remove('is-clearing');
      resolution.classList.remove('is-visible');
      stage.querySelectorAll('.qchip').forEach((c) => c.remove());

      const pool = shuffle(questions).slice(0, CHIP_COUNT);
      let i = 0;

      function step() {
        if (token !== runToken) return;
        if (i >= pool.length) {
          timer = setTimeout(() => {
            if (token !== runToken) return;
            stage.classList.add('is-clearing');
            setTimeout(() => {
              if (token !== runToken) return;
              resolution.classList.add('is-visible');
            }, 380);
          }, 550);
          return;
        }
        spawnChip(pool[i], i);
        i++;
        timer = setTimeout(step, STEP_DELAY);
      }
      step();
    }

    replayBtn.addEventListener('click', run);
    run();
  });
</script>

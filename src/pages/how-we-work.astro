---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Heading from "../components/Heading.astro";
import PageHeading from "../components/PageHeading.astro";
import Eyebrow from "../components/Eyebrow.astro";
import CampfireToggle from "../components/CampfireToggle.astro";
import CadenceSteps from "../components/CadenceSteps.astro";

const base = import.meta.env.BASE_URL;

// --- Section 1: Our working style ---
const styleCards = [
  {
    title: "Responsiveness",
    text: "Access to the right specialists when needed, including strategic planning and training.",
    icon: "responsive",
    tilt: "rotate(-1deg) translateY(-3px)",
  },
  {
    title: "Capability",
    text: "Experienced marketing people working in the marketing areas they specialise in.",
    icon: "capability",
    tilt: "rotate(1deg) translateY(3px)",
  },
  {
    title: "Transparency",
    text: "Clear work-in-progress tracking, agreed deadlines, and regular, useful updates.",
    icon: "transparent",
    tilt: "rotate(-1deg) translateY(-3px)",
  },
  {
    title: "Accountability",
    text: "Monthly action and outcomes reporting, supported by regular planning meetings.",
    icon: "accountable",
    tilt: "rotate(1deg) translateY(3px)",
  },
];

// --- Section 2: How engagements are structured ---
// Icons are external files (public/how-we-work-icons/), not inline paths like
// the other icon sets on this page \u2014 these are filled multi-colour
// illustrations Andrew supplied, not simple currentColor line-icons, so they
// follow the working-style-icons pattern (img + object-contain) instead.
const cadenceSteps = [
  {
    num: "01",
    title: "Discover & Align",
    text: "We get across your goals, context, and constraints and agree on success.",
    icon: "align",
  },
  {
    num: "02",
    title: "Plan & Prioritise",
    text: "We build a focused plan with clear priorities and measurable outcomes.",
    icon: "priority",
  },
  {
    num: "03",
    title: "Execute & Inform",
    text: "We get to work, keep you in the loop, and share progress regularly.",
    icon: "execute",
  },
  {
    num: "04",
    title: "Review & Learn",
    text: "We review results together, learn what worked (and what didn\u2019t).",
    icon: "learn",
  },
  {
    num: "05",
    title: "Adjust & Grow",
    text: "We refine the plan and continue to improve momentum.",
    icon: "grow",
  },
];

// --- Section 3: How we fit in — redesigned per Andrew's supplied mockup,
// replacing the earlier "shared workspace diagram" (dashed circle +
// inward chevrons) entirely. Genuinely different relationship from the
// system-diagram pattern used elsewhere (about.astro's "A small team",
// SystemDiagram.astro) — a bilateral "your team / together / Vandalist"
// split, not a hub-with-facets shape — so real connector lines here are
// consistent with the established rule (a new visual element earns its
// place if it shows a relationship a plain grid can't; this one already
// did before this redesign too, just with a different diagram).
const yourTeamBrings = [
  { title: "Business knowledge", text: "Deep understanding of your business, goals and market.", icon: '<path d="M12 3a6 6 0 0 0-3 11.2c.6.4 1 1.1 1 1.8h4c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"/><path d="M9 18h6M10 21h4"/>' },
  { title: "Customer insight", text: "First-hand knowledge of your customers and their needs.", icon: '<circle cx="9" cy="8" r="3"/><path d="M4 20c0-3 2.2-5.2 5-5.2s5 2.2 5 5.2"/><circle cx="17" cy="9" r="2.3"/><path d="M15 20c0-2.3 1-4.1 2.9-4.7"/>' },
  { title: "Internal relationships", text: "Access to key stakeholders across the business.", icon: '<circle cx="6" cy="12" r="2.2"/><circle cx="18" cy="6" r="2.2"/><circle cx="18" cy="18" r="2.2"/><path d="M8 11l8-3.5M8 13l8 3.5" stroke-linecap="round"/>' },
  { title: "Approvals and decision making", text: "Guidance, feedback and timely sign-off.", icon: '<path d="M6 3h9l3 3v15H6z" stroke-linejoin="round"/><path d="M9 13l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>' },
  { title: "Strategic context", text: "The bigger picture, priorities and what success looks like.", icon: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/>' },
];
const vandalistBrings = [
  { title: "Specialist skills and expertise", text: "Marketing strategy, campaigns, content, SEO, paid and more.", icon: '<circle cx="12" cy="12" r="3"/><path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18 6l-1.5 1.5M7.5 16.5L6 18M18 18l-1.5-1.5M7.5 7.5L6 6"/>' },
  { title: "Practical execution", text: "We turn plans into action, with quality and speed.", icon: '<path d="M9 6h11M9 12h11M9 18h11" stroke-linecap="round"/><path d="M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2" stroke-linecap="round" stroke-linejoin="round"/>' },
  { title: "Systems and reporting", text: "Clear processes, tracking and insights to keep you informed.", icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M7 19v-6M12 19V8M17 19v-9" stroke-linecap="round"/>' },
  { title: "Accountability", text: "We own delivery and keep things moving.", icon: '<path d="M12 3l8 4v5c0 5-3.4 8.4-8 9.5-4.6-1.1-8-4.5-8-9.5V7l8-4z" stroke-linejoin="round"/><path d="M9 12.5l2 2 4-4.5" stroke-linecap="round" stroke-linejoin="round"/>' },
  { title: "Momentum", text: "Proactive support to sustain progress and drive results.", icon: '<path d="M12 2c3 2 5 6 5 10 0 2-.5 3.5-1.2 4.8L12 20l-3.8-3.2C7.5 15.5 7 14 7 12c0-4 2-8 5-10z" stroke-linejoin="round"/><circle cx="12" cy="10" r="1.8"/><path d="M8.5 16.5L6 19M15.5 16.5L18 19" stroke-linecap="round"/>' },
];
const togetherItems = [
  { title: "Clear roles", text: "Everyone knows what they own.", icon: '<circle cx="9" cy="8" r="3"/><path d="M4 20c0-3 2.2-5.2 5-5.2s5 2.2 5 5.2"/><circle cx="17" cy="9" r="2.3"/><path d="M15 20c0-2.3 1-4.1 2.9-4.7"/>' },
  { title: "Faster decisions", text: "Less friction, more progress.", icon: '<path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" stroke-linejoin="round"/>' },
  { title: "Shared outcomes", text: "A bigger impact, together.", icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M7 19v-6M12 19V8M17 19v-9" stroke-linecap="round"/>' },
];
// The "Together" card's puzzle graphic is a real supplied image now
// (public/system-icons/puzzle-together.png), not a hand-drawn icon —
// see that <img> usage below. Two earlier hand-drawn SVG attempts
// (rect+circle approximation, then a plain two-circles placeholder)
// are gone; this file has no icon constant for it anymore.

// --- Section 4: Decision-making & accountability — redesigned per
// Andrew's supplied mockup. Renamed "Tactical" -> "Execution" and "Your
// ownership" -> "Your oversight" (with its text tweaked from "We keep you
// informed" to "You stay informed", matching the "you own this" framing
// of that column). Header cells now carry their own icon + tinted
// background (pink for Vandalist, green for you) rather than plain
// neutral cells; all 4 content-row icons read as a consistent pink
// throughout rather than alternating per column, per the mockup.
const roleHeaders = [
  { title: "Vandalist leads", subtitle: "We advise and run", tone: "accent", icon: '<circle cx="12" cy="6" r="2.4"/><circle cx="6" cy="17" r="2.4"/><circle cx="18" cy="17" r="2.4"/><path d="M12 8.4V12M12 12H6.6M12 12h5.4M6 14.6V15M18 14.6V15" stroke-linecap="round"/>' },
  { title: "You lead", subtitle: "You decide and own", tone: "good", icon: '<circle cx="12" cy="8" r="3.4"/><path d="M5 20c0-3.6 3.1-6.3 7-6.3s7 2.7 7 6.3"/>' },
];
const matrix = [
  {
    rowLabel: "Strategic",
    rowSub: "(the what & why)",
    left: {
      title: "Our advice",
      text: "We provide recommendations and strategic guidance based on data, experience and insight.",
      icon: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/>',
    },
    right: {
      title: "Your decisions",
      text: "You make the final call. We support with information, options and impact.",
      icon: '<rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4" stroke-linecap="round"/>',
    },
  },
  {
    rowLabel: "Execution",
    rowSub: "(the how & when)",
    left: {
      title: "Our execution",
      text: "We own the delivery. Clear plans, transparent progress and quality outcomes.",
      icon: '<circle cx="12" cy="12" r="3"/><path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18 6l-1.5 1.5M7.5 16.5L6 18M18 18l-1.5-1.5M7.5 7.5L6 6"/>',
    },
    right: {
      title: "Your oversight",
      text: "You own the outcomes. You stay informed and accountable to the plan.",
      icon: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z" stroke-linejoin="round"/><circle cx="12" cy="12" r="3"/>',
    },
  },
];
const megaphoneIcon = '<path d="M3 10v4h3l6 4V6l-6 4H3z" stroke-linejoin="round"/><path d="M14 8a4 4 0 0 1 0 8" stroke-linecap="round"/>';
---
<Layout title="How We Work">
  <div class="bg-[var(--color-paper)]">
    <!-- Header + hero share one full-bleed background image (mountains,
         per supplied mockup) — a different pattern from the site's usual
         "bleed-wider band" (which caps at 1400px and keeps side padding);
         this one runs truly edge-to-edge behind the nav too. Header.astro
         itself has no background of its own (it only ever looked opaque
         because it normally sits on this div's bg-[var(--color-paper)]),
         so it drops onto the image here with no changes needed.

         No overflow-hidden here on purpose: the boosted campfire flame is
         taller than its own stage and is meant to visually rise past it —
         clipping it here would just cut the flame off, and (when this div
         still resized on boost) was also forcing the background image's
         object-cover crop to recompute every frame of the transition,
         which read as the image glitching. -->
    <div class="relative">
      <img
        src={`${base}/how-we-work-hero-bg.svg`}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-bottom pointer-events-none"
        aria-hidden="true"
      />
      <div class="relative z-10">
        <Header currentPage="/how-we-work" />

        <!-- Section 0: Hero — padding matches Home hero's exact recipe
             (Hero.astro's inner div: py-20 md:py-28 lg:py-32) rather than a
             one-off value, per Andrew's pointer to that class, so the two
             stay in sync if that recipe is ever retuned. -->
        <section class="max-w-7xl mx-auto px-6 md:px-10 py-20 md:py-28 lg:py-32">
          <div class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10 items-center min-h-[339px] lg:min-h-[322px]">
            <div>
              <PageHeading as="h1" class="mb-6">Marketing support that fits the way your business works</PageHeading>
              <p class="max-w-md text-lg text-[var(--color-slate)]">
                We combine clear priorities, specialist capability and practical collaboration&mdash;without adding unnecessary process or complexity.
              </p>
            </div>

            <!-- self-stretch (overriding the row's items-center default just
                 for this column) so it fills the row's full height, giving
                 the 66%-from-top position below something real to measure
                 against instead of just centering in whatever space the
                 flame itself needs. -->
            <!-- top-% is measured against this column's own box (= the grid
                 row height only, not the section's padding), so it isn't
                 the same number as "66% of the visible hero block" — tuned
                 per breakpoint against the actual rendered section height so
                 the flame's centre lands at ~66% down the real hero area. -->
            <div class="hidden md:block relative self-stretch">
              <div class="absolute left-1/2 md:top-[66%] lg:top-[68%] -translate-y-[110px] md:translate-x-[calc(-50%-70px)] lg:translate-x-[calc(-50%-130px)]">
                <CampfireToggle />
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- Section 1: Our working style (restored to its original layout) -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-20 md:pb-28">
      <div class="grid lg:grid-cols-[minmax(0,36%)_minmax(0,32%)_minmax(0,32%)] gap-x-10 gap-y-12">
        <div>
          <Eyebrow class="mb-3">How we work</Eyebrow>
          <Heading class="mb-4">Practical, sustainable, and easy to work with</Heading>
          <p class="text-[var(--color-slate)] max-w-md">
            We adapt to requirements whether that is being part of the strategic conversations, or being utilised for specific production tasks.
          </p>
        </div>

        <div class="flex flex-col gap-6">
          {styleCards.slice(0, 2).map((card) => (
            <div
              class="flex items-center gap-5 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]"
              style={`transform: ${card.tilt};`}
            >
              <div class="w-[60px] h-[60px] shrink-0 flex items-center justify-center">
                <img src={`${base}/working-style-icons/${card.icon}.svg`} alt="" class="w-full h-full object-contain" />
              </div>
              <div>
                <p class="font-semibold text-[var(--color-ink)] mb-1.5">{card.title}</p>
                <p class="text-sm text-[var(--color-slate)] leading-relaxed">{card.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-col gap-6">
          {styleCards.slice(2, 4).map((card) => (
            <div
              class="flex items-center gap-5 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]"
              style={`transform: ${card.tilt};`}
            >
              <div class="w-[60px] h-[60px] shrink-0 flex items-center justify-center">
                <img src={`${base}/working-style-icons/${card.icon}.svg`} alt="" class="w-full h-full object-contain" />
              </div>
              <div>
                <p class="font-semibold text-[var(--color-ink)] mb-1.5">{card.title}</p>
                <p class="text-sm text-[var(--color-slate)] leading-relaxed">{card.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 2: How engagements are structured -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <SectionHeading
        eyebrow="How engagements are structured"
        heading="A clear rhythm that keeps things moving."
        subtext="We follow a simple cadence to keep priorities clear, feedback flowing, and strategies adapting as we learn."
      />

      <CadenceSteps
        steps={cadenceSteps}
        gridClass="sm:grid-cols-2 lg:grid-cols-5"
        iconMode="image"
        iconBase={`${base}/how-we-work-icons`}
        circleBg="dim"
        shimmerConnector
      />

      <div class="flex items-center justify-center gap-2 mt-14">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.75">
          <path d="M12 20s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z" stroke-linejoin="round" />
        </svg>
        <p class="text-sm italic text-[var(--color-slate-light)]">
          Genuine advice and support you can rely on.
        </p>
      </div>
    </section>

    <!-- Section 3: How we fit in — redesigned per Andrew's mockup (see
         data comment above for why real connector lines are appropriate
         here specifically). -->
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 pb-20 md:pb-28">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-paper-dim)] p-6 md:p-10">
        <div class="max-w-7xl mx-auto">
          <SectionHeading
            eyebrow="How we fit in"
            heading="You stay close to the work. We bring the specialist capability, structure and momentum to move it forward."
            align="center"
          />

          <div class="flex flex-col lg:flex-row gap-8 lg:gap-0">
            <!-- Your team brings -->
            <div class="flex-1 rounded-[var(--radius-card)] bg-white border border-[var(--color-line)] p-6 md:p-7 [box-shadow:var(--shadow-card)]">
              <p class="text-xl font-semibold text-[var(--color-ink)] mb-1.5">Your team brings</p>
              <p class="text-sm text-[var(--color-slate)] mb-2">The business context, internal knowledge and relationships that make it happen.</p>
              <ul>
                {yourTeamBrings.map((item, i) => (
                  <li class:list={["flex items-start gap-3 py-4", i > 0 && "border-t border-[var(--color-line)]"]}>
                    <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </span>
                    <div>
                      <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{item.title}</p>
                      <p class="text-sm text-[var(--color-slate)] leading-snug">{item.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Connector: left card → Together -->
            <div class="hidden lg:flex items-center justify-center w-14 shrink-0 relative" aria-hidden="true">
              <div class="w-full border-t-2 border-dashed border-[rgba(232,70,124,0.4)]"></div>
              <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white border-2 border-[var(--color-accent)] flex items-center justify-center [box-shadow:var(--shadow-card)]">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>

            <!-- Together — same height as the side cards now (Andrew:
                 "middle pink column should be same height as others"), so
                 its content is vertically centered within that taller box
                 rather than sitting jammed at the top. -->
            <div class="lg:w-[300px] shrink-0 relative rounded-[var(--radius-card)] bg-[var(--color-accent-soft)] border border-[rgba(232,70,124,0.3)] p-6 md:p-8 text-center [box-shadow:var(--shadow-panel)] flex flex-col lg:justify-center">
              <!-- Real supplied image, already includes the spark marks
                   above the puzzle pieces — no separate icon row or
                   circular badge wrapper needed. -->
              <img src={`${base}/system-icons/puzzle-together.png`} alt="" class="w-[130px] h-auto mx-auto mb-2" />
              <p class="text-2xl font-semibold text-[var(--color-ink)] mb-2">Together</p>
              <p class="text-sm text-[var(--color-slate)] mb-5">One aligned team, with clear ownership and better delivery.</p>
              <div class="space-y-3">
                {togetherItems.map((item) => (
                  <div class="flex items-center gap-3 rounded-xl bg-white p-3 text-left [box-shadow:var(--shadow-card)]">
                    <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </span>
                    <div class="min-w-0">
                      <p class="font-semibold text-[var(--color-ink)] text-sm leading-snug">{item.title}</p>
                      <p class="text-xs text-[var(--color-slate)] leading-snug">{item.text}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Connector: Together → right card -->
            <div class="hidden lg:flex items-center justify-center w-14 shrink-0 relative" aria-hidden="true">
              <div class="w-full border-t-2 border-dashed border-[rgba(232,70,124,0.4)]"></div>
              <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white border-2 border-[var(--color-accent)] flex items-center justify-center [box-shadow:var(--shadow-card)]">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 5l-7 7 7 7" />
                </svg>
              </span>
            </div>

            <!-- Vandalist brings -->
            <div class="flex-1 rounded-[var(--radius-card)] bg-white border border-[var(--color-line)] p-6 md:p-7 [box-shadow:var(--shadow-card)]">
              <p class="text-xl font-semibold text-[var(--color-ink)] mb-1.5">Vandalist brings</p>
              <p class="text-sm text-[var(--color-slate)] mb-2">The specialist capability, structure and execution to move it forward.</p>
              <ul>
                {vandalistBrings.map((item, i) => (
                  <li class:list={["flex items-start gap-3 py-4", i > 0 && "border-t border-[var(--color-line)]"]}>
                    <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </span>
                    <div>
                      <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{item.title}</p>
                      <p class="text-sm text-[var(--color-slate)] leading-snug">{item.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 4: Decision-making & accountability — redesigned per
         Andrew's supplied mockup: colour-tinted header cells (each with
         its own icon), generously-gapped grid instead of adjacent bordered
         cells, and a "Transparent by default." banner with a title/
         description split by a small vertical divider. -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <div class="grid lg:grid-cols-[minmax(0,34%)_minmax(0,66%)] gap-x-10 gap-y-10">
        <div>
          <Eyebrow class="mb-3">Decision-making & accountability</Eyebrow>
          <Heading class="mb-4">Clear roles. Confident decisions.</Heading>
          <p class="text-[var(--color-slate)] max-w-sm">
            We believe clarity on decisions and responsibility leads to faster progress and better outcomes.
          </p>
        </div>

        <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 md:p-7 [box-shadow:var(--shadow-card)]">
          <!-- Desktop / tablet: full 3-column grid. Below lg the content
               cells shrank to ~65px (minmax(0,...) prevents overflow, but
               that's not the same as being legible) — real usability
               issue, not just an overflow check, so this gets its own
               stacked mobile layout below rather than trying to force one
               grid to do both, same split CoverageTable.astro already
               uses for its own desktop-table/mobile-cards divide. -->
          <div class="hidden lg:grid grid-cols-[minmax(0,auto)_minmax(0,1fr)_minmax(0,1fr)] gap-4 items-stretch">
            <!-- Corner cell: same light-gray tint as the label cells below
                 it, not truly blank — per Andrew's correction, the whole
                 first column reads as one consistent tinted column, not
                 a blank notch. -->
            <div class="rounded-xl bg-[var(--color-paper-dim)]"></div>
            {roleHeaders.map((role) => (
              <div class:list={["rounded-xl px-5 py-4 flex items-center gap-3", role.tone === "accent" ? "bg-[var(--color-accent-soft)]" : "bg-[var(--color-good-soft)]"]}>
                <span
                  class:list={["inline-flex items-center justify-center w-9 h-9 rounded-full shrink-0", role.tone === "accent" ? "bg-white text-[var(--color-accent)]" : "bg-white text-[var(--color-good)]"]}
                >
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={role.icon} />
                </span>
                <div class="min-w-0">
                  <p class="font-semibold text-[var(--color-ink)] text-sm">{role.title}</p>
                  <p class="text-xs text-[var(--color-slate)]">{role.subtitle}</p>
                </div>
              </div>
            ))}

            {matrix.map((row) => (
              <Fragment>
                <div class="rounded-xl bg-[var(--color-paper-dim)] px-5 py-4">
                  <p class="font-semibold text-[var(--color-ink)] leading-snug">{row.rowLabel}</p>
                  <p class="text-sm text-[var(--color-slate)]">{row.rowSub}</p>
                </div>
                <div class="rounded-xl bg-white [box-shadow:var(--shadow-card)] p-5">
                  <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-3">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={row.left.icon} />
                  </span>
                  <p class="font-semibold text-[var(--color-ink)] mb-1">{row.left.title}</p>
                  <p class="text-sm text-[var(--color-slate)] leading-snug">{row.left.text}</p>
                </div>
                <div class="rounded-xl bg-white [box-shadow:var(--shadow-card)] p-5">
                  <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-3">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={row.right.icon} />
                  </span>
                  <p class="font-semibold text-[var(--color-ink)] mb-1">{row.right.title}</p>
                  <p class="text-sm text-[var(--color-slate)] leading-snug">{row.right.text}</p>
                </div>
              </Fragment>
            ))}
          </div>

          <!-- Mobile / tablet: role headers side by side, then each row's
               two cells stacked as their own bordered card. -->
          <div class="lg:hidden space-y-6">
            <div class="grid grid-cols-2 gap-3">
              {roleHeaders.map((role) => (
                <div class:list={["rounded-xl px-4 py-3 flex items-center gap-2.5", role.tone === "accent" ? "bg-[var(--color-accent-soft)]" : "bg-[var(--color-good-soft)]"]}>
                  <span
                    class:list={["inline-flex items-center justify-center w-8 h-8 rounded-full shrink-0", role.tone === "accent" ? "bg-white text-[var(--color-accent)]" : "bg-white text-[var(--color-good)]"]}
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={role.icon} />
                  </span>
                  <div class="min-w-0">
                    <p class="font-semibold text-[var(--color-ink)] text-sm leading-snug">{role.title}</p>
                    <p class="text-xs text-[var(--color-slate)] leading-snug">{role.subtitle}</p>
                  </div>
                </div>
              ))}
            </div>

            {matrix.map((row) => (
              <div>
                <p class="font-semibold text-[var(--color-ink)] mb-3">
                  {row.rowLabel} <span class="font-normal text-sm text-[var(--color-slate)]">{row.rowSub}</span>
                </p>
                <div class="space-y-3">
                  {[row.left, row.right].map((cell) => (
                    <div class="rounded-xl border border-[var(--color-line)] p-4 flex items-start gap-3">
                      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={cell.icon} />
                      </span>
                      <div class="min-w-0">
                        <p class="font-semibold text-[var(--color-ink)] mb-0.5">{cell.title}</p>
                        <p class="text-sm text-[var(--color-slate)] leading-snug">{cell.text}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div class="mt-7 rounded-xl bg-[var(--color-accent-soft)] px-5 py-4 flex flex-wrap items-center gap-4">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-white text-[var(--color-accent)] shrink-0">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={megaphoneIcon} />
            </span>
            <span class="font-semibold text-[var(--color-ink)] shrink-0">Transparent by default.</span>
            <span class="hidden sm:block w-px self-stretch bg-[rgba(232,70,124,0.3)]"></span>
            <p class="text-sm text-[var(--color-slate)]">We communicate proactively, flag risks early, and keep everything visible.</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <CtaBand />
  <Footer />
</Layout>

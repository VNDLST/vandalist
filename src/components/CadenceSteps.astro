---
// Shared "numbered steps joined by a dotted line" row, used by How We Work and
// all six service pages. Originally built one-off for how-we-work.astro, then
// extracted; since 2026-10-27 EVERY use runs the same scroll sequence (Andrew:
// roll it out universally; if one module is updated, update them all).
//
// THE SEQUENCE (plays once, when the row is ~25% on screen): every icon starts
// understated, a pulse travels along the dotted line left to right, each icon it
// reaches goes "active" (bright) and then settles to "done" (soft pink), and the
// line behind the pulse turns pink, ending on a finished pink row. Below the
// breakpoint where the connector shows, the grid wraps and the line is hidden, so
// the icons simply light up in turn with the same timing. Without JS, or with
// prefers-reduced-motion, the row renders in its finished state (an inline
// script arms the idle look before first paint, only when motion is allowed).
// Timing: --cs-start / --cs-gap on .cadence-seq (travel = gap x (steps - 1)).
//
// THREE ICON TREATMENTS (picked by the props below):
//   line icon in a circle (iconMode="inline", or "image" with an SVG file):
//     idle = pale circle + muted grey glyph; active = pink circle + white glyph;
//     done = soft pink circle + pink glyph. Files are recoloured with a CSS mask,
//     so they must be single-colour silhouettes.
//   full-colour artwork with no circle (iconMode="image", iconContainer="bare",
//     the Google Ads PNGs): idle = greyed and faded; active = full colour with a
//     slight lift; done = full colour with its pink glow.
//
// PROPS
//   gridClass            literal Tailwind grid classes written in the CALLING
//                        page (Tailwind's scanner can't see computed classes).
//   connectorBreakpoint  must match the breakpoint at which gridClass becomes one
//                        full row of n columns; the line and chevrons are absolutely
//                        positioned assuming that layout.
//   iconMode             "inline" (step.icon is stroke-path markup, default) or
//                        "image" (step.icon is a filename under iconBase + iconExt).
//   iconContainer        "circle" (default) or "bare" (artwork with no circle).
//
// Text uses the shared type styles (t-eyebrow number, t-title, t-small; global.css).
interface Step {
  num: string;
  title: string;
  text: string;
  icon: string;
}
interface Props {
  steps: Step[];
  gridClass?: string;
  connectorBreakpoint?: "md" | "lg" | "xl";
  iconMode?: "inline" | "image";
  iconBase?: string;
  iconExt?: string;
  iconContainer?: "circle" | "bare";
}
const {
  steps,
  gridClass = "sm:grid-cols-2 lg:grid-cols-5",
  connectorBreakpoint = "lg",
  iconMode = "inline",
  iconBase = "",
  iconExt = "svg",
  iconContainer = "circle",
} = Astro.props as Props;
const n = steps.length;
// Literal strings so Tailwind's static scanner finds whichever one is used.
const connectorVisibility = { md: "hidden md:block", lg: "hidden lg:block", xl: "hidden xl:block" }[connectorBreakpoint];

// Circle radius 56px (w-28), gap-x-10 (40px gap). Column pitch in mixed
// units = (100% + gap)/n. Last circle's centre = (n-1) pitches + radius,
// expressed as a %+px pair so it tracks the container's real width.
const rightInsetPct = 100 / n;
const rightInsetPx = ((n - 1) / n) * 40 + 56;
const lineStyle = `top: 56px; left: 56px; right: calc(${rightInsetPct}% - ${rightInsetPx}px);`;
---
<div class="mt-16 relative cadence-seq" data-cadence-seq style={`--cs-n: ${n - 1}`}>
  <!-- Grey dotted base line, the pink trail that grows behind the pulse, and the pulse -->
  <div class:list={[connectorVisibility, "absolute border-t-2 border-dotted border-[rgba(154,150,142,0.45)] z-0"]} style={lineStyle} aria-hidden="true"></div>
  <div class:list={[connectorVisibility, "cadence-trail absolute border-t-2 border-dotted border-[var(--color-accent-line)] z-0"]} style={lineStyle} aria-hidden="true"></div>
  <div
    class:list={[connectorVisibility, "absolute z-0"]}
    style={`top: 55px; left: 56px; right: calc(${rightInsetPct}% - ${rightInsetPx}px); height: 2px;`}
    aria-hidden="true"
  >
    <div class="cadence-pulse"></div>
  </div>
  {Array.from({ length: n - 1 }, (_, i) => i).map((i) => {
    const coeff = (i + 0.5) / n;
    const px = 56 + coeff * 40;
    const pct = coeff * 100;
    return (
      <div class:list={[connectorVisibility, "absolute z-0"]} style={`left: calc(${pct}% + ${px}px); top: 56px; transform: translate(-50%, -50%);`} aria-hidden="true">
        <svg class="relative cadence-chevron" style={`--i: ${i}`} width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    );
  })}

  <div class:list={["relative z-10 grid gap-y-14 gap-x-10", gridClass]}>
    {steps.map((step, stepIndex) => (
      <div class="flex flex-col">
        <div
          style={`--i: ${stepIndex}`}
          class:list={["w-28 h-28 mb-6 flex items-center justify-center shrink-0", iconContainer === "circle" && "cadence-circle rounded-full [box-shadow:var(--shadow-card)]"]}
        >
          {iconMode === "image" && iconContainer === "circle" ? (
            <span class="cadence-glyph w-16 h-16 block" style={`--icon: url(${iconBase}/${step.icon}.${iconExt})`} role="presentation"></span>
          ) : iconMode === "image" ? (
            <img src={`${iconBase}/${step.icon}.${iconExt}`} alt="" class="cadence-art w-20 h-20 object-contain" />
          ) : (
            <svg class="cadence-svg" width="68" height="68" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
          )}
        </div>
        <p class="t-eyebrow mb-1">{step.num}</p>
        <p class="t-title mb-1.5">{step.title}</p>
        <p class="t-small">{step.text}</p>
      </div>
    ))}
  </div>
</div>
<script is:inline>
  (function () {
    var s = document.currentScript;
    var w = s && s.previousElementSibling;
    if (w && w.hasAttribute("data-cadence-seq") && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      w.classList.add("is-armed");
    }
  })();
</script>

<script>
  // One-time start: when an armed cadence row is ~25% on screen, begin its sequence.
  const rows = document.querySelectorAll<HTMLElement>("[data-cadence-seq].is-armed");
  if (rows.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add("is-playing");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 },
    );
    rows.forEach((el) => io.observe(el));
  } else {
    // No observer support: finish in the pink state rather than stay idle.
    rows.forEach((el) => el.classList.remove("is-armed"));
  }
</script>

<style>
  .cadence-seq { --cs-start: 0.5s; --cs-gap: 1.3s; }

  /* Finished state = the default (no JS / reduced motion). */
  .cadence-seq .cadence-circle { background-color: var(--color-accent-soft); }
  .cadence-seq .cadence-glyph {
    background-color: var(--color-accent);
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
  .cadence-seq .cadence-svg { color: var(--color-accent); }
  .cadence-seq .cadence-art { filter: grayscale(0) drop-shadow(0 10px 18px rgba(255, 61, 107, 0.35)); opacity: 1; }
  .cadence-seq .cadence-chevron { color: var(--color-accent); }
  .cadence-seq .cadence-trail { clip-path: inset(0 0 0 0); }
  .cadence-seq .cadence-pulse { opacity: 0; }

  /* Armed (waiting to scroll into view): everything understated. */
  .cadence-seq.is-armed .cadence-circle { background-color: var(--color-paper-dim); }
  .cadence-seq.is-armed .cadence-glyph { background-color: rgba(154, 150, 142, 0.6); }
  .cadence-seq.is-armed .cadence-svg { color: rgba(154, 150, 142, 0.6); }
  .cadence-seq.is-armed .cadence-art { filter: grayscale(1) drop-shadow(0 10px 18px rgba(255, 61, 107, 0)); opacity: 0.5; }
  .cadence-seq.is-armed .cadence-chevron { color: rgba(154, 150, 142, 0.6); }
  .cadence-seq.is-armed .cadence-trail { clip-path: inset(0 100% 0 0); }

  /* Playing: icon i is reached by the pulse at start + i x gap. */
  .cadence-seq.is-playing .cadence-circle,
  .cadence-seq.is-playing .cadence-glyph,
  .cadence-seq.is-playing .cadence-svg,
  .cadence-seq.is-playing .cadence-art {
    animation-duration: 1.8s;
    animation-timing-function: ease;
    animation-fill-mode: forwards;
    animation-delay: calc(var(--cs-start) + var(--i) * var(--cs-gap) - 0.3s);
  }
  .cadence-seq.is-playing .cadence-circle { animation-name: cs-circle; }
  .cadence-seq.is-playing .cadence-glyph { animation-name: cs-glyph; }
  .cadence-seq.is-playing .cadence-svg { animation-name: cs-svg; }
  .cadence-seq.is-playing .cadence-art { animation-name: cs-art; }
  .cadence-seq.is-playing .cadence-chevron {
    animation: cs-chevron 0.5s ease forwards;
    animation-delay: calc(var(--cs-start) + (var(--i) + 0.5) * var(--cs-gap));
  }
  .cadence-seq.is-playing .cadence-trail {
    animation: cs-trail calc(var(--cs-gap) * var(--cs-n)) linear forwards;
    animation-delay: var(--cs-start);
  }
  .cadence-pulse {
    position: absolute;
    top: 0;
    left: 0;
    width: 96px;
    height: 2px;
    margin-left: -48px;
    background: linear-gradient(to right, transparent, var(--color-accent), transparent);
  }
  .cadence-seq.is-playing .cadence-pulse {
    animation: cs-pulse calc(var(--cs-gap) * var(--cs-n)) linear forwards;
    animation-delay: var(--cs-start);
  }
  @keyframes cs-circle {
    0% { background-color: var(--color-paper-dim); }
    17%, 45% { background-color: var(--color-accent); }
    80%, 100% { background-color: var(--color-accent-soft); }
  }
  @keyframes cs-glyph {
    0% { background-color: rgba(154, 150, 142, 0.6); }
    17%, 45% { background-color: #fff; }
    80%, 100% { background-color: var(--color-accent); }
  }
  @keyframes cs-svg {
    0% { color: rgba(154, 150, 142, 0.6); }
    17%, 45% { color: #fff; }
    80%, 100% { color: var(--color-accent); }
  }
  @keyframes cs-art {
    0% { filter: grayscale(1) drop-shadow(0 10px 18px rgba(255, 61, 107, 0)); opacity: 0.5; transform: scale(1); }
    17%, 45% { filter: grayscale(0) drop-shadow(0 10px 18px rgba(255, 61, 107, 0.35)); opacity: 1; transform: scale(1.06); }
    80%, 100% { filter: grayscale(0) drop-shadow(0 10px 18px rgba(255, 61, 107, 0.35)); opacity: 1; transform: scale(1); }
  }
  @keyframes cs-chevron {
    from { color: rgba(154, 150, 142, 0.6); }
    to { color: var(--color-accent); }
  }
  @keyframes cs-trail {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes cs-pulse {
    0% { left: 0%; opacity: 1; }
    94% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cadence-seq .cadence-circle, .cadence-seq .cadence-glyph, .cadence-seq .cadence-svg, .cadence-seq .cadence-art,
    .cadence-seq .cadence-chevron, .cadence-seq .cadence-trail, .cadence-seq .cadence-pulse { animation: none !important; }
  }
</style>

---
// "Question pile" concept for the Google Ads page's currently-empty hero
// graphic slot: questions drop in one at a time — a small arrow cues each
// drop, the question lands with a bit of rotation, the next one lands
// roughly on top of it — building a genuine pile in one spot, then it
// clears to a single calm resolution line.
//
// v2 (this version), per Andrew's reference sketch: v1 was a rapid
// *scattered burst* across the whole stage (~42 chips at random positions,
// mechanic adapted from the idea of mattdesl's "codevember" day 9 sketch —
// see git history on this file for that reasoning). Andrew's reference
// showed something more controlled — one question at a time, a visible
// downward arrow cueing each drop, landing in the same spot with increasing
// rotation/spread as the pile grows. That's a simpler mechanic than v1's
// scatter-placement, not a harder one: no randomized stage-wide positioning
// needed, just an accumulating fan of rotations anchored to one point.
//
// Font swapped from the handwritten Caveat (still used for the campfire
// toggle's label) to Anton — a bold, condensed, "stamped headline" font
// that matches the reference's blocky look without needing a distortion
// filter for texture. Deliberately did NOT reach for the feTurbulence
// grunge-filter technique explored earlier for the how-we-work icons —
// that was shelved specifically because distorting edges hurt legibility,
// and legibility matters even more for sentences than icons.
export interface Props {
  questions?: string[];
  resolutionHeading?: string;
  resolutionText?: string;
}

const {
  questions = [
    "What's my budget?",
    'Why is my CPC so high?',
    'Manual or automatic bidding?',
    "What's Quality Score?",
    "Why aren't my ads showing?",
    'Is this even working?',
    "What's a good CTR?",
    'Negative keywords?',
    'Am I targeting the right people?',
    'Why did conversions drop?',
    "What's ROAS mean?",
    'Should I pause this?',
    'Is my landing page the problem?',
    "Who's managing this daily?",
    "Why is my competitor above me?",
    'Search vs Display campaign?',
    'Is tracking even set up right?',
    "How much is 'too much' to spend?",
    "What's Smart Bidding?",
    'Why did my Quality Score drop?',
    'Should I worry about invalid clicks?',
    'What even is an ad group?',
    'Is this actually bringing in leads?',
    'Why does this dashboard make no sense?',
  ],
  resolutionHeading = 'We handle all of this for you.',
  resolutionText = 'Plain-English updates. None of the jargon headache.',
} = Astro.props;
---

<div class="qpile" data-qpile-root>
  <div class="qpile-stage" data-qpile-stage aria-hidden="true">
    <div class="qpile-arrow" data-qpile-arrow aria-hidden="true">
      <svg width="20" height="36" viewBox="0 0 20 36" fill="none">
        <path d="M10 0v27M10 27l-7.5-7.5M10 27l7.5-7.5" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>

  <div class="qpile-resolution" data-qpile-resolution>
    <span class="qpile-resolution-dot" aria-hidden="true"></span>
    <p class="qpile-resolution-heading">{resolutionHeading}</p>
    <p class="qpile-resolution-text">{resolutionText}</p>
  </div>

  <button type="button" class="qpile-replay" data-qpile-replay aria-label="Replay animation">
    ↻ Replay
  </button>
</div>

<style>
  .qpile {
    position: relative;
    width: 100%;
    border-radius: var(--radius-card);
    background: var(--color-paper-dim);
    overflow: hidden;
  }

  .qpile-stage {
    position: relative;
    width: 100%;
    height: 320px;
  }
  @media (min-width: 768px) {
    .qpile-stage {
      height: 420px;
    }
  }

  .qpile-arrow {
    position: absolute;
    left: 50%;
    top: 14%;
    z-index: 40;
    transform: translate(-50%, -8px);
    opacity: 0;
    transition: opacity 200ms ease, transform 200ms ease;
  }
  .qpile-arrow.is-active {
    opacity: 1;
    transform: translate(-50%, 8px);
  }


  .qpile-resolution {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 2rem;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 500ms ease, transform 500ms ease;
  }
  .qpile-resolution.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .qpile-resolution-dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    margin-bottom: 1rem;
    background: var(--gradient-orb);
    box-shadow: var(--shadow-orb);
  }
  .qpile-resolution-heading {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
    max-width: 22rem;
  }
  @media (min-width: 768px) {
    .qpile-resolution-heading {
      font-size: 1.625rem;
    }
  }
  .qpile-resolution-text {
    font-size: 0.9375rem;
    color: var(--color-slate);
  }

  .qpile-replay {
    position: absolute;
    bottom: 0.85rem;
    right: 0.85rem;
    z-index: 5;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-slate);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .qpile-replay:hover {
    border-color: var(--color-slate);
    color: var(--color-ink);
  }
</style>

<!-- Deliberately a SEPARATE, global (unscoped) style block: .qchip elements
     are created client-side via document.createElement, not by Astro's own
     render — they never get the data-astro-cid attribute Astro's normal
     scoped-<style> selectors require, so scoping this block would silently
     match nothing. Confirmed via computed style (position/transform coming
     back as the browser defaults, none of this actually applying) before
     splitting it out — this bug predates this session's changes and quietly
     affected the very first "scattered burst" version too, not just this
     rewrite. Class names are specific enough (qchip, qpile-*) that going
     unscoped here is a low collision risk. -->
<style is:global>
  /* Each question: bare bold text (no card/border — matches the reference,
     and keeps it legible; the "distressed" character comes from the font
     choice + accumulating rotation, not a texture filter). Positioned at a
     fixed anchor point; --jx/--jy/--r (jitter + rotation, set per-chip in
     JS, growing with pile index) fan it out from there rather than
     scattering it across the whole stage. `scale` is its own standalone
     CSS property (not part of `transform`) specifically so the clearing
     shrink can transition independently of the rotate/translate that live
     in `transform` — both animate at once with no conflict. */
  .qchip {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%) translate(var(--jx, 0px), var(--jy, 0px)) rotate(var(--r, 0deg)) translateY(-70px);
    scale: 0.94;
    max-width: 260px;
    font-family: 'Anton', sans-serif;
    font-size: var(--fs, 1.3rem);
    line-height: 1.15;
    color: var(--color-ink);
    text-align: center;
    text-wrap: balance;
    opacity: 0;
    pointer-events: none;
    transition: transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1), scale 520ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 260ms ease;
  }
  .qchip.is-in {
    scale: 1;
    opacity: 1;
    transform: translate(-50%, -50%) translate(var(--jx, 0px), var(--jy, 0px)) rotate(var(--r, 0deg));
  }
  .qpile-stage.is-clearing .qchip {
    scale: 0.7;
    opacity: 0;
    transition: scale 320ms ease, opacity 320ms ease;
  }
</style>

<script define:vars={{ questions }}>
  function shuffle(input) {
    const arr = input.slice();
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  document.querySelectorAll('[data-qpile-root]').forEach((root) => {
    const stage = root.querySelector('[data-qpile-stage]');
    const arrow = root.querySelector('[data-qpile-arrow]');
    const resolution = root.querySelector('[data-qpile-resolution]');
    const replayBtn = root.querySelector('[data-qpile-replay]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CHIP_COUNT = reduceMotion ? 4 : 8;
    const STEP_DELAY = 820; // gap between one chip settling and the next arrow cue starting
    const ARROW_LEAD = 260; // how long the arrow shows before the chip actually drops

    let timer = null;
    let runToken = 0;

    // Rotation/spread grows with pile index — early chips land close to
    // upright near-centre, later ones fan out wider, matching the
    // reference's 3-stage progression (1 upright question -> a loose
    // stack -> a wide fanned pile) rather than a flat random scatter.
    function spawnChip(text, index) {
      const chip = document.createElement('div');
      chip.className = 'qchip';
      chip.textContent = text;
      const rotateMagnitude = Math.min(4 + index * 2.4, 16);
      const rotate = ((Math.random() * 2 - 1) * rotateMagnitude).toFixed(1);
      const jx = ((Math.random() * 2 - 1) * Math.min(index * 7, 70)).toFixed(0);
      const jy = ((Math.random() * 2 - 1) * Math.min(index * 3.2, 24)).toFixed(0);
      const fontSize = (1.15 + Math.random() * 0.3).toFixed(2);
      chip.style.setProperty('--r', `${rotate}deg`);
      chip.style.setProperty('--jx', `${jx}px`);
      chip.style.setProperty('--jy', `${jy}px`);
      chip.style.setProperty('--fs', `${fontSize}rem`);
      chip.style.zIndex = String(10 + index);
      stage.appendChild(chip);
      // Double rAF so the browser commits the initial (scale: .94, opacity: 0,
      // translateY(-70px)) state to a frame before .is-in flips the
      // transition target — a same-tick class add wouldn't animate, it'd
      // just jump straight to the end state.
      requestAnimationFrame(() => requestAnimationFrame(() => chip.classList.add('is-in')));
    }

    function run() {
      const token = ++runToken;
      clearTimeout(timer);
      stage.classList.remove('is-clearing');
      resolution.classList.remove('is-visible');
      arrow.classList.remove('is-active');
      stage.querySelectorAll('.qchip').forEach((c) => c.remove());

      const pool = shuffle(questions).slice(0, CHIP_COUNT);
      let i = 0;

      function step() {
        if (token !== runToken) return;
        if (i >= pool.length) {
          timer = setTimeout(() => {
            if (token !== runToken) return;
            stage.classList.add('is-clearing');
            setTimeout(() => {
              if (token !== runToken) return;
              resolution.classList.add('is-visible');
            }, 380);
          }, 550);
          return;
        }
        if (reduceMotion) {
          spawnChip(pool[i], i);
          i++;
          step();
          return;
        }
        arrow.classList.add('is-active');
        timer = setTimeout(() => {
          if (token !== runToken) return;
          arrow.classList.remove('is-active');
          spawnChip(pool[i], i);
          i++;
          timer = setTimeout(step, STEP_DELAY);
        }, ARROW_LEAD);
      }
      step();
    }

    replayBtn.addEventListener('click', run);
    run();
  });
</script>

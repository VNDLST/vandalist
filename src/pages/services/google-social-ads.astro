---
// First of 4-5 service pages, built from Andrew's supplied mockup. Sections
// he marked with blue scribbles in the mockup aren't custom-built here —
// those are meant to just be the site's shared template chrome (CtaBand,
// Footer) rather than a bespoke design. The "how it works" section was
// wholesale replaced by a second, more specific mockup he supplied for
// that section only.
//
// Content is Google Ads only (no social media ads content) even though
// this lives at /services/google-social-ads per Header.astro's existing
// nav — worth flagging back to Andrew rather than silently deciding
// either way (rename the nav label, or fold social ads content in later).
//
// Hero has no decorative graphic yet — deliberate per Andrew ("thinking
// about what we can use there that is meaningful rather than just a dumb
// placeholder"), not an oversight. Single column until that's decided.
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PageHeading from "../../components/PageHeading.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CadenceSteps from "../../components/CadenceSteps.astro";

const base = import.meta.env.BASE_URL;

// --- Section 1: Service cards ---
// Icons supplied by Andrew (public/google-ads-icons/) — filled shapes, not
// stroke line-icons, so rendered via <img> like the working-style-icons /
// how-we-work-icons pattern elsewhere. Fixed height, auto width, so each
// icon's own aspect ratio is respected but they all read as the same size
// — the mockup's "30px" was just an Illustrator artifact per Andrew, not a
// real spec, so this is a judgement call on the actual value, not his.
const services = [
  {
    title: "Search campaigns",
    text: "Target high-intent searches and capture demand when it matters most.",
    image: "search",
  },
  {
    title: "Shopping & Performance Max",
    text: "Show your products across Google's network and drive more qualified sales.",
    image: "shopping",
  },
  {
    title: "Conversion tracking",
    text: "Accurate tracking so you know what's working and what to improve.",
    image: "convert",
  },
  {
    title: "Reporting & optimisation",
    text: "Clear reporting and ongoing optimisation to improve performance over time.",
    image: "report",
  },
];

// --- Section 2: Our approach — rebuilt per Andrew's supplied layout mockup.
// Left column: each point now has its own icon (was a uniform checkmark).
// Right column: was a flat 9-item checklist, now grouped into three
// phases (Plan/Build/Improve), each with its own icon+blurb and a 3-card
// row of the specific deliverables under that phase. ---
const approachPoints = [
  {
    text: "Strategic planning aligned to your goals",
    icon: '<circle cx="10" cy="14" r="7"/><circle cx="10" cy="14" r="3.2"/><circle cx="10" cy="14" r="0.9" fill="currentColor" stroke="none"/><path d="M15 9l5-5M20 4h-4M20 4v4" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    text: "Hands-on management from a certified expert",
    icon: '<circle cx="8.5" cy="8" r="2.6"/><path d="M3.5 19c0-2.8 2.2-4.9 5-4.9s5 2.1 5 4.9"/>',
  },
  {
    text: "Transparent reporting and open communication",
    icon: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  },
  {
    text: "Focused on qualified leads and real outcomes",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
const approachPhases = [
  {
    phase: "Plan",
    text: "We research and plan with purpose.",
    icon: '<rect x="6" y="4" width="12" height="16" rx="2"/><path d="M9 4h6v2a1 1 0 0 1-1 1H10a1 1 0 0 1-1-1V4z"/><path d="M9 13l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>',
    items: [
      { text: "Account audit & strategy", icon: '<circle cx="10" cy="10" r="6.5"/><path d="M19 19l-4.5-4.5" stroke-linecap="round"/>' },
      { text: "Keyword research & intent mapping", icon: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l3 3M14 9l2 2" stroke-linecap="round" stroke-linejoin="round"/>' },
      { text: "Campaign structure & ad groups", icon: '<circle cx="12" cy="5" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/><path d="M12 7v4M12 11l-6 4M12 11l6 4" stroke-linecap="round"/>' },
    ],
  },
  {
    phase: "Build",
    text: "We build campaigns that connect.",
    icon: '<path d="M4 20l1-4.5L15.5 5l3.5 3.5L8.5 19 4 20z" stroke-linejoin="round"/><path d="M13.5 6.5l3.5 3.5" stroke-linecap="round"/>',
    items: [
      { text: "Ad copy & extensions", icon: '<path d="M4 20l1-4.5L15.5 5l3.5 3.5L8.5 19 4 20z" stroke-linejoin="round"/><path d="M13.5 6.5l3.5 3.5" stroke-linecap="round"/>' },
      { text: "Landing page alignment", icon: '<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 9h16" stroke-linecap="round"/><circle cx="7" cy="7" r="0.6" fill="currentColor" stroke="none"/>' },
      { text: "Conversion tracking setup", icon: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none"/>' },
    ],
  },
  {
    phase: "Improve",
    text: "We optimise to drive better results.",
    icon: '<rect x="4" y="13" width="3" height="7" rx="1"/><rect x="10" y="9" width="3" height="11" rx="1"/><rect x="16" y="5" width="3" height="15" rx="1"/>',
    items: [
      { text: "Budget management & optimisation", icon: '<circle cx="12" cy="12" r="9"/><path d="M12 6.8v10.4M9.3 9.5c0-1.2 1.2-2.1 2.7-2.1s2.7.8 2.7 2-1.1 1.9-2.7 2.1-2.7 1-2.7 2.1 1.2 2 2.7 2 2.7-.9 2.7-2" stroke-linecap="round" stroke-linejoin="round"/>' },
      { text: "Ongoing testing & improvements", icon: '<path d="M9 3h6M10 3v6.5L5.5 18a2 2 0 0 0 1.7 3h9.6a2 2 0 0 0 1.7-3L14 9.5V3" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 15h8" stroke-linecap="round"/>' },
      { text: "Regular reporting & insights", icon: '<path d="M4 18V6M4 18h16" stroke-linecap="round"/><path d="M7 14l4-4 3 3 5-6" stroke-linecap="round" stroke-linejoin="round"/>' },
    ],
  },
];

// --- Section 3: How this typically works (supplied as its own mockup,
// wholesale replacing whatever the full-page mockup originally sketched
// for a process section) ---
// Icons here are raster PNGs (public/google-ads-icons/), not the flat
// single-tone SVGs used everywhere else on the site — a deliberate style
// departure per Andrew's supplied assets, flagged back to him rather than
// silently normalised to match the rest of the page.
const processSteps = [
  {
    num: "01",
    title: "Targeting & planning",
    text: "We define goals, audiences and search intent to focus on the right opportunities.",
    icon: "Targeting",
  },
  {
    num: "02",
    title: "Campaign setup",
    text: "We build campaigns with clean structure, relevant keywords and smart settings.",
    icon: "Setup",
  },
  {
    num: "03",
    title: "Ad creation",
    text: "We write compelling ads and test variations to find what resonates.",
    icon: "Creating",
  },
  {
    num: "04",
    title: "Tracking & launch",
    text: "We implement tracking, QA everything, and launch with confidence.",
    icon: "Launch",
  },
  {
    num: "05",
    title: "Ongoing optimisation",
    text: "We refine targeting, bids and creatives to improve results and efficiency.",
    icon: "Optimisation",
  },
  {
    num: "06",
    title: "Reporting & recommendations",
    text: "We report on what matters and recommend clear next steps for growth.",
    icon: "Reporting",
  },
];

// --- Section 4: Who it's for ---
// Retitled/reordered per Andrew, icons supplied (public/google-ads-icons/).
// Descriptions deliberately left as-is against the new titles for now —
// Andrew's coming back to rewrite them later, not an oversight that they
// don't semantically match yet.
const audiences = [
  {
    title: "Trade services",
    text: "Capture more qualified leads and reduce cost per enquiry with targeted search ads.",
    image: "trade-services",
  },
  {
    title: "Professional services",
    text: "Drive more sales and revenue with Shopping and Performance Max campaigns.",
    image: "professional-services",
  },
  {
    title: "Ecommerce and retail",
    text: "Generate more opportunities from people actively searching for your services.",
    image: "ecommerce",
  },
];

// --- Section 5: Results that matter (static illustrative reporting card —
// numbers/labels are placeholder content matching the mockup, not live
// data; see the "reporting mockup" decision above) ---
const stats = [
  { label: "Clicks", value: "4,238", change: "16%", up: true },
  { label: "Conversions", value: "276", change: "22%", up: true },
  { label: "Cost/conv.", value: "$42.17", change: "14%", up: false },
  { label: "Conv. value", value: "$26,840", change: "31%", up: true },
];
---
<Layout title="Google Ads Management" description="Google Ads management that turns search intent into qualified leads.">
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/services/google-social-ads" />

    <!-- Section 0: Hero -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-16 md:pb-20">
      <div class="max-w-xl">
        <PageHeading as="h1" class="mb-6">Google Ads management that turns search intent into qualified leads</PageHeading>
        <p class="text-lg text-[var(--color-slate)] mb-10">
          We plan, build, and optimise Google Ads that connect you with people who are already looking for what you offer&mdash;so you get more enquiries at a better cost.
        </p>
        <a
          href={`${base}/contact`}
          class="inline-flex items-center gap-4 rounded-2xl bg-[var(--color-paper)] border border-[var(--color-line)] px-8 py-5 text-lg text-[var(--color-ink)] hover:border-[var(--color-slate)] transition-colors"
        >
          <span
            class="w-9 h-9 rounded-full shrink-0 ring-2 ring-white"
            style="background: var(--gradient-orb); box-shadow: var(--shadow-orb);"
          ></span>
          Book a strategy call
        </a>
      </div>
    </section>

    <!-- Section 1: Service cards -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-20">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {services.map((service) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6">
            <img src={`${base}/google-ads-icons/${service.image}.svg`} alt="" class="h-9 w-auto object-contain mb-4" />
            <p class="font-semibold text-[var(--color-ink)] mb-1.5">{service.title}</p>
            <p class="text-sm text-[var(--color-slate)] leading-relaxed">{service.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 2: Our approach — bleed-wider band -->
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 pb-16 md:pb-20">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-paper-dim)] p-6 md:p-10">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-[34%_66%] gap-10 items-start">
          <div>
            <Eyebrow class="mb-3">Our approach</Eyebrow>
            <h2 class="text-2xl md:text-3xl font-semibold text-[var(--color-ink)] mb-4">How we help with Google Ads</h2>
            <p class="text-[var(--color-slate)] mb-6 max-w-md">
              Great results come from the right strategy, clean execution, and constant optimisation. We handle everything so you can focus on running your business.
            </p>
            <ul class="space-y-3">
              {approachPoints.map((point) => (
                <li class="flex items-center gap-3">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-white text-[var(--color-accent)] shrink-0 [box-shadow:var(--shadow-card)]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={point.icon} />
                  </span>
                  <span class="text-sm text-[var(--color-ink)]">{point.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <Eyebrow class="mb-2">What's included</Eyebrow>
            <p class="text-sm text-[var(--color-slate)] mb-6">The practical pieces we manage across the life of a campaign.</p>
            <div class="space-y-6">
              {approachPhases.map((phase) => (
                <div class="grid sm:grid-cols-[minmax(0,140px)_minmax(0,1fr)] gap-4">
                  <div class="flex flex-col items-start gap-1.5">
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={phase.icon} />
                    </span>
                    <p class="font-semibold text-[var(--color-ink)] text-sm">{phase.phase}</p>
                    <p class="text-xs text-[var(--color-slate)]">{phase.text}</p>
                  </div>
                  <div class="grid sm:grid-cols-3 gap-3 sm:max-w-[480px]">
                    {phase.items.map((item) => (
                      <div class="rounded-xl border border-[var(--color-line)] bg-white p-3 flex items-center gap-2.5">
                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                        </span>
                        <span class="text-xs font-medium text-[var(--color-ink)] leading-snug">{item.text}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 3: How this typically works -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-20">
      <SectionHeading
        eyebrow="How this typically works"
        heading="A simple rhythm for running paid search well"
      />
      <CadenceSteps
        steps={processSteps}
        gridClass="sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6"
        connectorBreakpoint="xl"
        iconMode="image"
        iconBase={`${base}/google-ads-icons`}
        iconExt="png"
        iconContainer="bare"
      />
    </section>

    <!-- Section 4: Who it's for -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-20">
      <SectionHeading
        eyebrow="Who it's for"
        heading="Built for businesses that want more qualified enquiries and sales"
      />
      <div class="grid sm:grid-cols-3 gap-5">
        {audiences.map((item) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6">
            <img src={`${base}/google-ads-icons/${item.image}.svg`} alt="" class="w-20 h-20 object-contain mb-4" />
            <p class="font-semibold text-[var(--color-ink)] mb-1.5">{item.title}</p>
            <p class="text-sm text-[var(--color-slate)] leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 5: Results that matter -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <div class="grid lg:grid-cols-[1fr_1.3fr] gap-10 items-center">
        <div>
          <Eyebrow class="mb-3">Results that matter</Eyebrow>
          <h2 class="text-2xl md:text-3xl font-semibold text-[var(--color-ink)] mb-4">Transparent reporting. Better decisions. Stronger results.</h2>
          <p class="text-[var(--color-slate)] mb-6 max-w-md">
            We give you clear visibility of what's working, what's improving, and where the opportunities are.
          </p>
          <!-- Upgraded from a plain text link per feedback — same tokens as
               every other card/button on the site (shadow-card/panel,
               accent-soft badge, the chevron already used elsewhere), just
               composed into something with more visual weight and a small
               hover lift so it reads as an actual invitation to click. -->
          <a
            href={`${base}/contact`}
            class="group inline-flex items-center gap-3 rounded-[var(--radius-pill)] bg-white border border-[var(--color-line)] pl-2.5 pr-5 py-2.5 [box-shadow:var(--shadow-card)] transition-all hover:[box-shadow:var(--shadow-panel)] hover:-translate-y-0.5"
          >
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 18V6M4 18h16" stroke-linecap="round"/><path d="M7 14l4-4 3 3 5-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="text-sm font-semibold text-[var(--color-ink)]">See reporting example</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" class="transition-transform group-hover:translate-x-1">
              <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>

        <!-- Static illustrative card — numbers/labels are placeholder
             content matching the mockup, not a live/functional dashboard.
             Dropdowns are styled chrome only, not interactive. -->
        <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 md:p-6 [box-shadow:var(--shadow-panel)]" aria-hidden="true">
          <div class="flex items-center gap-3 mb-5">
            <span class="inline-flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-[var(--color-line)] px-3 py-1.5 text-xs text-[var(--color-slate)]">
              Last 30 days
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-[var(--color-line)] px-3 py-1.5 text-xs text-[var(--color-slate)]">
              All campaigns
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
            {stats.map((stat) => (
              <div class="rounded-lg bg-[var(--color-paper-dim)] p-3">
                <p class="text-xs text-[var(--color-slate)] mb-1">{stat.label}</p>
                <p class="text-lg font-semibold text-[var(--color-ink)] mb-0.5">{stat.value}</p>
                <p class:list={["text-xs font-medium", stat.up ? "text-[var(--color-good)]" : "text-[var(--color-accent)]"]}>
                  {stat.up ? "↑" : "↓"} {stat.change}
                </p>
              </div>
            ))}
          </div>

          <div class="flex items-center gap-4 mb-3 text-xs text-[var(--color-slate)]">
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[var(--color-slate-light)]"></span>Clicks</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)]"></span>Conversions</span>
          </div>
          <svg viewBox="0 0 300 90" class="w-full h-20" preserveAspectRatio="none">
            <polyline points="0,55 30,40 60,60 90,35 120,50 150,25 180,45 210,30 240,48 270,20 300,38" fill="none" stroke="var(--color-slate-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <polyline points="0,75 30,68 60,72 90,58 120,65 150,45 180,55 210,38 240,50 270,30 300,42" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div class="flex justify-between mt-2 text-[10px] text-[var(--color-slate-light)]">
            <span>May 6</span><span>May 13</span><span>May 20</span><span>May 27</span><span>Jun 3</span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <CtaBand />
  <Footer />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Heading from "../components/Heading.astro";
import PageHeading from "../components/PageHeading.astro";
import Eyebrow from "../components/Eyebrow.astro";
import CampfireToggle from "../components/CampfireToggle.astro";

const base = import.meta.env.BASE_URL;

// --- Section 1: Our working style ---
const styleCards = [
  {
    title: "Responsiveness",
    text: "Access to the right specialists when needed, including strategic planning and training.",
    icon: "responsive",
    tilt: "rotate(-1deg) translateY(-3px)",
  },
  {
    title: "Capability",
    text: "Experienced marketing people working in the marketing areas they specialise in.",
    icon: "capability",
    tilt: "rotate(1deg) translateY(3px)",
  },
  {
    title: "Transparency",
    text: "Clear work-in-progress tracking, agreed deadlines, and regular, useful updates.",
    icon: "transparent",
    tilt: "rotate(-1deg) translateY(-3px)",
  },
  {
    title: "Accountability",
    text: "Monthly action and outcomes reporting, supported by regular planning meetings.",
    icon: "accountable",
    tilt: "rotate(1deg) translateY(3px)",
  },
];

// --- Section 2: How engagements are structured ---
const cadenceSteps = [
  {
    num: "01",
    title: "Discover & Align",
    text: "We get across your goals, context, and constraints and agree on success.",
    icon: '<circle cx="10" cy="14" r="7"/><circle cx="10" cy="14" r="3.2"/><circle cx="10" cy="14" r="0.9" fill="currentColor" stroke="none"/><path d="M15 9l5-5M20 4h-4M20 4v4" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    num: "02",
    title: "Plan & Prioritise",
    text: "We build a focused plan with clear priorities and measurable outcomes.",
    icon: '<rect x="6" y="4" width="12" height="16" rx="2"/><path d="M9 4h6v2a1 1 0 0 1-1 1H10a1 1 0 0 1-1-1V4z"/><path d="M9 13l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    num: "03",
    title: "Execute & Inform",
    text: "We get to work, keep you in the loop, and share progress regularly.",
    icon: '<path d="M22 2L11 13" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 2L15 22L11 13L2 9L22 2z" stroke-linejoin="round"/>',
  },
  {
    num: "04",
    title: "Review & Learn",
    text: "We review results together, learn what worked (and what didn\u2019t).",
    icon: '<circle cx="10" cy="10" r="6.5"/><path d="M19 19l-4.5-4.5" stroke-linecap="round"/>',
  },
  {
    num: "05",
    title: "Adjust & Grow",
    text: "We refine the plan and continue to improve momentum.",
    icon: '<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/><circle cx="9" cy="7" r="1.6" fill="var(--color-paper)"/><circle cx="15" cy="12" r="1.6" fill="var(--color-paper)"/><circle cx="10" cy="17" r="1.6" fill="var(--color-paper)"/>',
  },
];

// --- Section 3: How we fit with internal teams ---
const teamBrings = [
  { text: "Deep knowledge of your business and customers", icon: '<circle cx="8.5" cy="8" r="2.6"/><path d="M3.5 19c0-2.8 2.2-4.9 5-4.9s5 2.1 5 4.9"/><circle cx="16" cy="8" r="2.2"/><path d="M14.5 12.6c2.2.3 3.9 2 3.9 4.4"/>' },
  { text: "Existing plans, processes and tools", icon: '<rect x="6" y="4" width="12" height="16" rx="2"/><path d="M9 4h6v2a1 1 0 0 1-1 1H10a1 1 0 0 1-1-1V4z"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>' },
  { text: "Internal relationships and approvals", icon: '<path d="M4 8h5M4 16h5M9 8v8" stroke-linecap="round"/><circle cx="9" cy="8" r="1.4" fill="currentColor" stroke="none"/><circle cx="9" cy="16" r="1.4" fill="currentColor" stroke="none"/><circle cx="18" cy="12" r="2.4"/><path d="M13.5 12h2" stroke-linecap="round"/>' },
  { text: "Context, history and constraints", icon: '<circle cx="11" cy="11" r="7"/><path d="M16 16l4.5 4.5" stroke-linecap="round"/><path d="M11 8v3l2 1.5" stroke-linecap="round" stroke-linejoin="round"/>' },
];
const vandalistBrings = [
  { text: "Marketing strategy and fresh perspective", icon: '<path d="M3 11l17-8-6 17-3.5-7L3 11z" stroke-linejoin="round"/>' },
  { text: "Specialist skills and proven methods", icon: '<path d="M9 3h6l3 5-6 13L6 8l3-5z" stroke-linejoin="round"/><path d="M6 8h12M9.5 3l2.5 5 2.5-5" stroke-linejoin="round"/>' },
  { text: "Structured execution and clear comms", icon: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>' },
  { text: "Tools, templates and continuous improvement", icon: '<circle cx="5.5" cy="7" r="1" fill="currentColor" stroke="none"/><circle cx="5.5" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="5.5" cy="17" r="1" fill="currentColor" stroke="none"/><path d="M9 7h11M9 12h11M9 17h11" stroke-linecap="round"/>' },
];

// --- Section 4: Decision-making & accountability ---
const matrix = [
  {
    title: "Our advice",
    text: "We provide recommendations and strategic guidance based on data, experience and insight.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5 5-2z" stroke-linejoin="round"/>',
  },
  {
    title: "Your decisions",
    text: "You make the final call. We support with information, options and impact.",
    icon: '<circle cx="12" cy="8" r="3.4"/><path d="M5 20c0-3.6 3.1-6.3 7-6.3s7 2.7 7 6.3"/>',
  },
  {
    title: "Our execution",
    text: "We own the delivery. Clear plans, transparent progress and quality outcomes.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    title: "Your ownership",
    text: "You own the outcomes. We keep you informed and accountable to the plan.",
    icon: '<path d="M6 21V4" stroke-linecap="round"/><path d="M6 4h12l-2.5 3.5L18 11H6" stroke-linejoin="round"/>',
  },
];
---
<Layout title="How We Work">
  <div class="bg-[var(--color-paper)]">
    <!-- Header + hero share one full-bleed background image (mountains,
         per supplied mockup) — a different pattern from the site's usual
         "bleed-wider band" (which caps at 1400px and keeps side padding);
         this one runs truly edge-to-edge behind the nav too. Header.astro
         itself has no background of its own (it only ever looked opaque
         because it normally sits on this div's bg-[var(--color-paper)]),
         so it drops onto the image here with no changes needed.

         No overflow-hidden here on purpose: the boosted campfire flame is
         taller than its own stage and is meant to visually rise past it —
         clipping it here would just cut the flame off, and (when this div
         still resized on boost) was also forcing the background image's
         object-cover crop to recompute every frame of the transition,
         which read as the image glitching. -->
    <div class="relative">
      <img
        src={`${base}/how-we-work-hero-bg.svg`}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-bottom pointer-events-none"
        aria-hidden="true"
      />
      <div class="relative z-10">
        <Header currentPage="/how-we-work" />

        <!-- Section 0: Hero -->
        <section class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-12 md:pb-16">
          <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10 items-center">
            <div>
              <PageHeading as="h1" class="mb-6">Marketing support that fits the way your business works</PageHeading>
              <p class="max-w-md text-lg text-[var(--color-slate)]">
                We combine clear priorities, specialist capability and practical collaboration&mdash;without adding unnecessary process or complexity.
              </p>
            </div>

            <div class="hidden md:flex items-center justify-center self-end -translate-x-5">
              <CampfireToggle />
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- Section 1: Our working style (restored to its original layout) -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-20 md:pb-28">
      <div class="grid lg:grid-cols-[minmax(0,36%)_minmax(0,32%)_minmax(0,32%)] gap-x-10 gap-y-12">
        <div>
          <Eyebrow class="mb-3">How we work</Eyebrow>
          <Heading class="mb-4">Practical, sustainable, and easy to work with</Heading>
          <p class="text-[var(--color-slate)] max-w-md">
            We adapt to requirements whether that is being part of the strategic conversations, or being utilised for specific production tasks.
          </p>
        </div>

        <div class="flex flex-col gap-6">
          {styleCards.slice(0, 2).map((card) => (
            <div
              class="flex items-center gap-5 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]"
              style={`transform: ${card.tilt};`}
            >
              <div class="w-20 h-20 shrink-0 flex items-center justify-center">
                <img src={`${base}/working-style-icons/${card.icon}.svg`} alt="" class="w-full h-full object-contain" />
              </div>
              <div>
                <p class="font-semibold text-[var(--color-ink)] mb-1.5">{card.title}</p>
                <p class="text-sm text-[var(--color-slate)] leading-relaxed">{card.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-col gap-6">
          {styleCards.slice(2, 4).map((card) => (
            <div
              class="flex items-center gap-5 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]"
              style={`transform: ${card.tilt};`}
            >
              <div class="w-20 h-20 shrink-0 flex items-center justify-center">
                <img src={`${base}/working-style-icons/${card.icon}.svg`} alt="" class="w-full h-full object-contain" />
              </div>
              <div>
                <p class="font-semibold text-[var(--color-ink)] mb-1.5">{card.title}</p>
                <p class="text-sm text-[var(--color-slate)] leading-relaxed">{card.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 2: How engagements are structured -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <SectionHeading
        eyebrow="How engagements are structured"
        heading="A clear rhythm that keeps things moving."
        subtext="We follow a simple cadence to keep priorities clear, feedback flowing, and strategies adapting as we learn."
      />

      <div class="mt-16 relative">
        <!-- Connector line spans the full row behind the circles — the opaque
             white circles occlude it, so it reads as "connecting" each icon
             without needing pixel-exact math against the column widths. -->
        <div class="hidden lg:block absolute border-t-2 border-dotted border-[var(--color-accent)]/40 z-0" style="top: 56px; left: 56px; right: calc(20% - 88px);" aria-hidden="true"></div>
        {[0, 1, 2, 3].map((i) => {
          // 5 equal-fr columns (gap-x-10 = 40px), circle is w-28 (112px, radius
          // 56px) left-aligned in its column. Column pitch = (100% + 40px)/5,
          // so the midpoint between circle i and i+1 sits at a fixed px offset
          // plus a percentage of the row width — not a plain round percentage,
          // since the circles are narrower than their (text-driven) columns.
          const coeff = (i + 0.5) / 5;
          const px = 56 + coeff * 40;
          const pct = coeff * 100;
          return (
            <div class="hidden lg:block absolute z-0" style={`left: calc(${pct}% + ${px}px); top: 56px; transform: translate(-50%, -50%);`} aria-hidden="true">
              <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[var(--color-accent)]/25 blur-md"></div>
              <svg class="relative" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="3">
                <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          );
        })}

        <div class="relative z-10 grid sm:grid-cols-2 lg:grid-cols-5 gap-y-14 gap-x-10">
          {cadenceSteps.map((step) => (
            <div class="flex flex-col">
              <div class="w-28 h-28 mb-6 rounded-full bg-white [box-shadow:var(--shadow-card)] flex items-center justify-center shrink-0">
                <svg width="68" height="68" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
              </div>
              <p class="text-sm font-bold text-[var(--color-accent)] mb-1">{step.num}</p>
              <p class="text-lg font-semibold text-[var(--color-ink)] mb-1.5">{step.title}</p>
              <p class="text-sm text-[var(--color-slate)] leading-relaxed">{step.text}</p>
            </div>
          ))}
        </div>

        <div class="flex items-center justify-center gap-2 mt-14">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.75">
            <path d="M12 20s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z" stroke-linejoin="round" />
          </svg>
          <p class="text-sm italic text-[var(--color-slate-light)]">
            Genuine advice and support you can rely on.
          </p>
        </div>

        <div class="mt-8 border-t border-[var(--color-line)]"></div>
      </div>
    </section>

    <!-- Section 3: How we fit with internal teams -->
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 pb-20 md:pb-28">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-paper-dim)] p-6 md:p-10">
        <div class="max-w-7xl mx-auto">
          <SectionHeading
            eyebrow="How we fit in"
            heading="We play nice with others"
            subtext="We work alongside your team, existing suppliers and partners, to enhance your marketing ecosystem."
          />

          <div class="grid lg:grid-cols-[1fr_1.3fr_1fr] gap-6 lg:gap-8 items-center">
            <!-- Your team brings -->
            <div class="rounded-[var(--radius-card)] bg-white border border-[var(--color-line)] p-6 md:p-7 [box-shadow:var(--shadow-card)]">
              <p class="text-sm font-semibold text-[var(--color-accent)] mb-5">Your team brings</p>
              <ul class="space-y-5">
                {teamBrings.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </span>
                    <span class="text-sm text-[var(--color-ink)] pt-2 leading-snug">{item.text}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Shared workspace diagram -->
            <div class="relative flex items-center justify-center py-6">
              <!-- inward arrows: left side -->
              <div class="hidden lg:flex flex-col gap-2.5 absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1/2 z-10">
                {[0, 1, 2].map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 5l7 7-7 7" />
                  </svg>
                ))}
              </div>
              <!-- inward arrows: right side -->
              <div class="hidden lg:flex flex-col gap-2.5 absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 z-10">
                {[0, 1, 2].map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-good)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 5l-7 7 7 7" />
                  </svg>
                ))}
              </div>

              <div class="relative w-full max-w-[300px] lg:max-w-[420px] aspect-square mx-auto">
                <span class="absolute top-1 left-1/2 -translate-x-1/2 text-xs font-bold text-[var(--color-ink)] whitespace-nowrap">Collaborative</span>
                <span class="absolute bottom-1 left-1/2 -translate-x-1/2 text-xs font-bold text-[var(--color-ink)] whitespace-nowrap">Practical</span>
                <span class="absolute left-1 text-xs font-bold text-[var(--color-ink)]" style="top: calc(50% - 20px);">Aligned</span>
                <span class="absolute right-1 text-xs font-bold text-[var(--color-ink)]" style="top: calc(50% - 20px);">Open</span>

                <svg class="absolute inset-0 w-full h-full" viewBox="0 0 280 280" fill="none" aria-hidden="true">
                  <circle cx="140" cy="140" r="120" stroke="var(--color-slate-light)" stroke-width="2" stroke-dasharray="4 6" />
                </svg>

                <div
                  class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white flex flex-col items-center justify-center text-center px-5 [box-shadow:var(--shadow-card)]"
                  style="width: 52.9%; height: 52.9%; border: 8px solid var(--color-paper-dim);"
                >
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-paper-dim)] text-[var(--color-ink)] mb-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="8.5" cy="8" r="2.6"/><path d="M3.5 19c0-2.8 2.2-4.9 5-4.9s5 2.1 5 4.9"/><circle cx="16" cy="8" r="2.2"/><path d="M14.5 12.6c2.2.3 3.9 2 3.9 4.4"/>
                    </svg>
                  </span>
                  <p class="text-sm font-semibold text-[var(--color-ink)] leading-snug">Shared workspace</p>
                </div>
              </div>
            </div>

            <!-- Vandalist brings -->
            <div class="rounded-[var(--radius-card)] bg-[var(--color-good-soft)] border border-[var(--color-line)]/50 p-6 md:p-7 [box-shadow:var(--shadow-card)]">
              <p class="text-sm font-semibold text-[var(--color-good)] mb-5">Vandalist brings</p>
              <ul class="space-y-5">
                {vandalistBrings.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white/70 text-[var(--color-good)] shrink-0">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </span>
                    <span class="text-sm text-[var(--color-ink)] pt-2 leading-snug">{item.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 4: Decision-making & accountability -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <div class="grid lg:grid-cols-[34%_66%] gap-x-10 gap-y-10">
        <div>
          <Eyebrow class="mb-3">Decision-making & accountability</Eyebrow>
          <Heading class="mb-4">Clear roles. Confident decisions.</Heading>
          <p class="text-[var(--color-slate)] max-w-sm">
            We believe clarity on decisions and responsibility leads to faster progress and better outcomes.
          </p>
        </div>

        <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white overflow-hidden">
          <div class="grid grid-cols-[auto_1fr_1fr]">
            <!-- header row -->
            <div class="border-b border-[var(--color-line)]"></div>
            <div class="border-b border-l border-[var(--color-line)] px-5 py-4">
              <p class="text-sm font-semibold text-[var(--color-ink)]">Vandalist leads</p>
              <p class="text-xs text-[var(--color-slate)]">We decide and own</p>
            </div>
            <div class="border-b border-l border-[var(--color-line)] px-5 py-4">
              <p class="text-sm font-semibold text-[var(--color-ink)]">You lead</p>
              <p class="text-xs text-[var(--color-slate)]">You decide and own</p>
            </div>

            <!-- row: strategic -->
            <div class="border-b border-[var(--color-line)] px-4 py-5 flex items-start">
              <p class="text-sm font-semibold text-[var(--color-ink)] leading-snug">Strategic<br /><span class="font-normal text-[var(--color-slate)]">(the what &amp; why)</span></p>
            </div>
            <div class="border-b border-l border-[var(--color-line)] px-5 py-5">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={matrix[0].icon} />
              </span>
              <p class="text-sm font-semibold text-[var(--color-ink)] mb-1">{matrix[0].title}</p>
              <p class="text-sm text-[var(--color-slate)] leading-snug">{matrix[0].text}</p>
            </div>
            <div class="border-b border-l border-[var(--color-line)] px-5 py-5">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[var(--color-paper-dim)] text-[var(--color-ink)] mb-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={matrix[1].icon} />
              </span>
              <p class="text-sm font-semibold text-[var(--color-ink)] mb-1">{matrix[1].title}</p>
              <p class="text-sm text-[var(--color-slate)] leading-snug">{matrix[1].text}</p>
            </div>

            <!-- row: tactical -->
            <div class="border-b border-[var(--color-line)] px-4 py-5 flex items-start">
              <p class="text-sm font-semibold text-[var(--color-ink)] leading-snug">Tactical<br /><span class="font-normal text-[var(--color-slate)]">(the how &amp; when)</span></p>
            </div>
            <div class="border-b border-l border-[var(--color-line)] px-5 py-5">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={matrix[2].icon} />
              </span>
              <p class="text-sm font-semibold text-[var(--color-ink)] mb-1">{matrix[2].title}</p>
              <p class="text-sm text-[var(--color-slate)] leading-snug">{matrix[2].text}</p>
            </div>
            <div class="border-l border-[var(--color-line)] px-5 py-5">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[var(--color-paper-dim)] text-[var(--color-ink)] mb-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={matrix[3].icon} />
              </span>
              <p class="text-sm font-semibold text-[var(--color-ink)] mb-1">{matrix[3].title}</p>
              <p class="text-sm text-[var(--color-slate)] leading-snug">{matrix[3].text}</p>
            </div>

            <!-- transparency row -->
            <div class="col-span-3 border-t border-[var(--color-line)] bg-[var(--color-paper-dim)] px-5 py-4 flex items-center gap-3">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-white text-[var(--color-accent)] shrink-0">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <p class="text-sm text-[var(--color-ink)]">
                <span class="font-semibold">Transparent by default</span>
                <span class="text-[var(--color-slate)]"> &mdash; We communicate proactively, flag risks early, and keep everything visible.</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <CtaBand />
  <Footer />
</Layout>

---
// The "Client / Industry / Engagement / Timeframe / Location" row on an
// individual case study. Every field is optional per the content schema —
// only the ones actually provided render, so an anonymised/lighter case
// study doesn't show empty slots.
interface Props {
  client?: string;
  industry?: string;
  engagement?: string;
  timeframe?: string;
  location?: string;
}
const { client, industry, engagement, timeframe, location } = Astro.props as Props;

const items = [
  {
    label: "Client",
    value: client,
    icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6" stroke-linecap="round"/>',
  },
  {
    label: "Industry",
    value: industry,
    icon: '<rect x="4" y="9" width="16" height="11" rx="1"/><path d="M9 9V6a3 3 0 0 1 6 0v3" stroke-linecap="round"/>',
  },
  {
    label: "Engagement",
    value: engagement,
    icon: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4" stroke-linecap="round"/>',
  },
  {
    label: "Timeframe",
    value: timeframe,
    icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    label: "Location",
    value: location,
    icon: '<path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21z" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.3"/>',
  },
].filter((item) => item.value);
---
{items.length > 0 && (
  <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 md:p-6 [box-shadow:var(--shadow-card)] grid sm:grid-cols-3 lg:grid-cols-5 gap-5">
    {items.map((item) => (
      <div class="flex items-start gap-2.5">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" set:html={item.icon} />
        </span>
        <div class="min-w-0">
          <p class="text-xs font-medium text-[var(--color-slate-light)] uppercase tracking-wide mb-0.5">{item.label}</p>
          <p class="text-sm font-medium text-[var(--color-ink)] leading-snug">{item.value}</p>
        </div>
      </div>
    ))}
  </div>
)}

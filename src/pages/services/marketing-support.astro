---
// Second of 4-5 service pages, built from Andrew's supplied mockup ("get a
// start on" — first-pass template, not final). Nav, CtaBand and Footer are
// the site's shared chrome and untouched here per Andrew's instruction.
//
// Hero: the supplied mockup had this page's 4 service cards INSIDE the hero
// itself, above the fold with the H1/paragraph/CTA — a mockup error per
// Andrew ("that is an error"), fixed here by moving them into their own
// section below the hero, matching google-social-ads.astro's Section 1
// pattern exactly (same card markup/tokens, not a new one-off style).
//
// Second hero column: was deliberately empty pending a graphic idea, then
// briefly Chris Gannon's egg-shaped runner (2026-08-20), then swapped for
// TreadmillRunner.astro (Bram van Dijk's "Running Dude" Pen). Moved on
// 2026-09-11 to websites-optimisation.astro instead — Andrew's call, not
// a quality issue with this page; his supplied fix for the "legs backwards,
// walks like an alien" report was a real bug in the recoloured Lottie data
// itself (front arm::Wrist and front leg::Ankle layers had been corrupted
// to absurd/negative scale values, e.g. front leg::Ankle at
// [17882,-16215,100] vs. its mirror back leg::Ankle's correct [100,100,100])
// — fixed directly in public/marketing-support-hero/runner.json, not
// something that needed rebuilding, and the fix travels with the component
// wherever it's used.
//
// **2026-11-10 (Andrew): the camp-site background + CampfireToggle came back to
// this page** ("it's more relevant to this specific service": add a little
// capability, turned up or down, is this page's pitch). The still-life image
// (public/vandalist-hero.png) went back to the homepage as a stand-in until he
// redoes the homepage, which is planned as the LAST page. The paragraph below is
// history.
//
// **2026-10-12 hero swap (Andrew):** the homepage took this page's camp-site
// background + CampfireToggle hero ("make the homepage more dynamic"), and
// this page took the homepage's old hero image (public/vandalist-hero.png)
// on the standard tinted service-page band, with the "Book a strategy call"
// button restored. The camp background moved with it (now
// public/home-hero-bg.svg). Everything below about the camp hero describes
// the previous state and is kept only as history.
//
// Hero rebuilt 2026-09-11 to match how-we-work.astro's exact pattern
// instead of this page's own original one, per Andrew directly ("replace
// the full marketing support hero with everything from the how we work
// hero"): full-bleed background image behind Header+hero (edge-to-edge,
// no side padding cut), same heading/subtext copy, CampfireToggle in the
// second column. Background image is marketing-support-bg.svg — a
// distinct supplied asset, not a copy of how-we-work-hero-bg.svg.
// **Dropped the "Book a strategy call" CTA button this page's hero used
// to have** — how-we-work.astro's hero (the thing being copied wholesale)
// has no CTA at all, and Andrew's instruction was "the FULL hero", not an
// addition to it. Flagged rather than silently kept, since a CTA
// disappearing is the one part of "copy everything" that's easy to miss
// mattering.
import Layout from "../../layouts/Layout.astro";
import Band from "../../components/Band.astro";
import Section from "../../components/Section.astro";
import IconChip from "../../components/IconChip.astro";
import PageHero from "../../components/PageHero.astro";
import OrbButton from "../../components/OrbButton.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CadenceSteps from "../../components/CadenceSteps.astro";
import CampfireToggle from "../../components/CampfireToggle.astro";
import TeamScene from "../../components/TeamScene.astro";

const base = import.meta.env.BASE_URL;

// --- Section 1: Service cards (moved out of the hero — see note above) ---
// 2026-11-11 (Andrew's mock-up + four supplied illustrations): the cards now carry
// Andrew's own artwork (a pink blob + black outline icon each), plain images like the
// SEO page's approach icons. The four files share ONE crop frame so their relative
// sizes match his mock-up; the source images are in his Assets folder, the repo copies
// are cropped/converted to webp. His mock-up also drew little pink "spark" lines at the
// top right of each icon; left OUT here (he asked for the same sparks to be removed on
// the SEO page icons), say if he wants them. Card copy follows his mock-up (cards 2 and
// 3 reworded; card 4 keeps "expertise" where the mock-up read "expert brain", spaced
// hyphen per his house style).
const services = [
  {
    title: "Strategic support",
    text: "Clear thinking and practical plans that keep your marketing focused and effective.",
    image: "strategic-support",
  },
  {
    title: "Content & campaigns",
    text: "Copy, content and campaign assets coordinated around what needs attention now.",
    image: "content-and-campaigns",
  },
  {
    title: "Reporting & optimisation",
    text: "Meaningful reporting and ongoing performance tuning to keep progress moving.",
    image: "reporting-and-optimisation",
  },
  {
    title: "Team support",
    text: "Extra hands and expertise when you need it - seamlessly alongside your internal team.",
    image: "team-support",
  },
];

// --- Section 2: "How we work" (rebuilt 2026-11-11 from Andrew's mock-up) ---
// Left: eyebrow, heading, paragraph, three ticks. Right: four white cards (Plan / Make
// / Improve / Support) in a 2x2 around a circle, "Built around your priorities", that
// overlaps their inner corners. Copy is Andrew's mock-up copy (new paragraph, three
// ticks instead of four, "Design assets", "Reporting insights"). The items are plain
// grey rows with no icons (his mock-up; he said it makes them look less like a slide).
//
// HOW THE CIRCLE STAYS SUSTAINABLE: it is absolutely centred on the 2x2 grid and sized
// as a share of the grid's width (26%), so it can never drift from the corners whatever
// the card heights or widths are; the column gap is a matching share (17%) so the
// overlap is always about the same slice of each card's inner corner, which is kept
// free of text (top cards get extra bottom padding, bottom cards a taller header zone).
// Breakpoints: below lg the cards go 2-up/1-up and the circle becomes a normal badge
// above them; lg+ the circle overlaps; xl+ (1280) adds the thin pink connector lines,
// drawn as an SVG in the grid's own percentage space (so they follow the grid) with
// their dots as HTML so they stay round. The lines run behind the cards and circle and
// end INSIDE the circle, so a few px of circle-size drift never leaves a gap.
const workPoints = [
  "Flexible, goal-led support that fits your business and priorities.",
  "A mix of planning, making, improving and day-to-day support.",
  "Scales with you, from one-off needs to ongoing partnership.",
];

const workGroups = [
  {
    label: "Plan",
    icon: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
    cardClass: "lg:pb-9",
    items: ["Strategy input", "Planning & roadmaps", "Campaign guidance"],
  },
  {
    label: "Make",
    icon: '<path d="M17 3.5a2.1 2.1 0 0 1 3 3L8.5 18 4 19l1-4.5L17 3.5z" stroke-linejoin="round"/>',
    cardClass: "lg:pb-9",
    items: ["Copy & content", "Design assets", "Website updates", "Email support"],
  },
  {
    label: "Improve",
    icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M7 19v-6M12 19V8M17 19v-9" stroke-linecap="round"/>',
    cardClass: "lg:pt-9",
    items: ["Reporting insights", "Optimisation", "Performance reviews"],
  },
  {
    label: "Support",
    icon: '<path d="M12 3l9 5-9 5-9-5 9-5z" stroke-linejoin="round"/><path d="M3 12.5l9 5 9-5" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 17l9 5 9-5" stroke-linecap="round" stroke-linejoin="round"/>',
    cardClass: "lg:pt-9",
    items: ["Ad-hoc requests & fixes", "Coordination & projects", "Automation support", "Feedback & ideas"],
  },
];

// xl connector lines + dots, in % of the 2x2 grid (x across, y down). Card edges sit at
// x 41.3 / 58.7 and y 44.1 / 55.9 (17% column gap; 80px row gap on ~676px of height, measured at 1440).
// Every line ends well inside the circle (centre 50,50), which hides the join.
const connectors = {
  paths: [
    "M41.3 22 C46 22 46.5 24 46.5 30 L46.5 44", // Plan -> circle top
    "M58.7 22 C54 22 53.5 24 53.5 30 L53.5 44", // Make -> circle top
    "M21 55.9 V53 C21 50.5 22.5 50 25 50 H44", // Improve (top edge) -> circle left
    "M74.5 55.9 V53 C74.5 50.5 73 50 70.5 50 H56", // Support (top edge) -> circle right
    "M41.3 78 C46 78 46.5 76 46.5 70 L46.5 56", // Improve (right edge) -> circle bottom
    "M58.7 78 C54 78 53.5 76 53.5 70 L53.5 56", // Support (left edge) -> circle bottom
  ],
  dots: [
    [41.3, 22],
    [58.7, 22],
    [21, 55.9],
    [74.5, 55.9],
    [41.3, 78],
    [58.7, 78],
  ],
};

// --- Section 3: Our engagement rhythm ---
// Icons: Lucide (ISC licence), Andrew's picks 2026-11-12: arrow-up-wide-narrow, pencil-sparkles,
// text-search, sliders-horizontal; files in public/marketing-support-rhythm-icons/.
const rhythmSteps = [
  { num: "01", title: "Prioritise", text: "We align on goals, focus areas, and the next most valuable things to tackle.", icon: "prioritise" },
  { num: "02", title: "Produce", text: "We get to work—creating, writing, running campaigns, or solving what's on the list.", icon: "produce" },
  { num: "03", title: "Review", text: "We share progress, results, and make sure we remain on the same page.", icon: "review" },
  { num: "04", title: "Adjust", text: "We refine the plan, shift priorities, and keep improving as things move forward.", icon: "adjust" },
];

// --- Section 4: Who it's for ---
// Rebuilt 2026-11-11 from Andrew's mock-up. Illustrations are his, recoloured to the site
// pink (the mauve bars and the crimson badge were off-brand) with a pink blob added behind
// each to match the row-1 cards; see public/marketing-support-audiences/. His third image
// (layers + plus) replaces the mock-up's calendar.
const audiences = [
  {
    title: "Lean internal teams",
    text: "Get specialist support to extend your team and keep essential marketing moving.",
    image: "lean-internal-teams",
  },
  {
    title: "Growing businesses",
    text: "Access practical strategy and execution to support growth without adding overhead.",
    image: "growing-businesses",
  },
  {
    title: "Extra capability when it matters",
    text: "Scale support up or down for campaigns, launches, busy periods, or key projects.",
    image: "extra-capability",
  },
];

// --- Section 5: How we fit in (Your team / Vandalist / Your other suppliers) ---
// Built from Andrew's second mock-up on 2026-11-11, then reworked 2026-11-12 on his notes:
// only the site's shared type styles (the same three the original How We Work "How we fit
// in" uses: t-subheading panel titles, t-small items, t-small-strong for the one bold line),
// no ring and no "Vandalist" wording or arrow in the middle: just a small white circle
// holding the real square logo, with the exchange of information shown as chevrons that
// flow in from the left, then in from the right, every few seconds (CSS only; static when
// the visitor prefers reduced motion). Icons are original inline paths on the 24-box.
// Flows (2026-11-12): two rows of chevrons each side, a 6s "conversation" (delays in
// seconds, listed left to right so the sweep starts at the right chevron): 0s team to
// Vandalist, 1.5s Vandalist back to the team, 3s suppliers to Vandalist, 4.5s Vandalist
// back to the suppliers.
const fitFlows = {
  left: [
    { dir: "right", delays: [0, 0.25, 0.5] },
    { dir: "left", delays: [2, 1.75, 1.5] },
  ],
  right: [
    { dir: "left", delays: [3.5, 3.25, 3] },
    { dir: "right", delays: [4.5, 4.75, 5] },
  ],
};
const fitTeam = {
  title: "Your team…",
  icon: '<path d="M17 21a5 5 0 00-10 0"/><path d="M22 10.5a3.5 3.5 0 00-5.507-2.868"/><path d="M7.507 7.632A3.5 3.5 0 002 10.5"/><circle cx="12" cy="13" r="3"/><circle cx="18.5" cy="4.5" r="2.5"/><circle cx="5.5" cy="4.5" r="2.5"/>', // Lucide "user-round-group" (ISC licence)
  items: [
    "Knows your business and customers",
    "Sets goals and direction",
    "Owns key relationships",
    "Has complete access to our team",
  ],
};
const fitSuppliers = {
  title: "Your other suppliers…",
  icon: '<path d="M10 12h4"/><path d="M10 8h4"/><path d="M14 21v-3a2 2 0 0 0-4 0v3"/><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"/><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/>', // Lucide "building-complex" (ISC licence)
  items: [
    "Specialist delivery",
    "Technical expertise",
    "Platform or channel management",
    "Can work with us to simplify your life",
  ],
};

---
<Layout title="Marketing Support" description="Flexible marketing support that fits the way your business works.">
  <!-- Section 0: Hero — the camp-site background with the "Add a little Vandalist"
       CampfireToggle, back on this page (2026-11-10, Andrew: "bring the hero design
       across, which is the background and the campfire animation"; the heading,
       intro and button stay this page's own). Same recipe the homepage used while it
       had the campfire: full-bleed image behind Header + hero, no overflow-hidden
       (the boosted flame rises past its stage), the image runs 2rem/2.5rem into the
       next section's top padding so its curves clear the hero text, and the campfire
       offsets are copied verbatim. -->
  <div class="relative">
    <img
      src={`${base}/home-hero-bg.svg`}
      alt=""
      class="absolute left-0 top-0 w-full h-[calc(100%+2rem)] md:h-[calc(100%+2.5rem)] object-cover object-bottom pointer-events-none"
      aria-hidden="true"
    />
    <div class="relative z-10">
      <Header currentPage="/services/marketing-support" />
      <PageHero from="md" artClass="hidden md:block relative self-stretch" introClass="max-w-md">
        <Fragment slot="title">Marketing support that fits the way your business works</Fragment>
        <Fragment slot="intro">We combine clear priorities, specialist capability and practical collaboration&mdash;without adding unnecessary process or complexity.</Fragment>
        <OrbButton href={`${base}/contact`}>Book a strategy call</OrbButton>
        <Fragment slot="art">
          <div class="absolute left-1/2 md:top-[66%] lg:top-[68%] -translate-y-[110px] md:translate-x-[calc(-50%-70px)] lg:translate-x-[calc(-50%-130px)]">
            <CampfireToggle />
          </div>
        </Fragment>
      </PageHero>
    </div>
  </div>

  <div class="bg-[var(--color-paper)]">
    <!-- Section 1: Service cards -->
    <Section top>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {services.map((service) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]">
            <img
              src={`${base}/marketing-support-services/${service.image}.webp`}
              alt=""
              width="520"
              height="442"
              loading="lazy"
              class="h-[132px] w-auto mb-3 -ml-1"
              aria-hidden="true"
            />
            <p class="t-title mb-1.5">{service.title}</p>
            <p class="t-small">{service.text}</p>
          </div>
        ))}
      </div>
    </Section>
  </div>

  <!-- Section 2: How we work — bleed-wider band (rebuilt from Andrew's mock-up, see the
       data comment above for how the overlapping circle is kept sustainable) -->
  <Band>
      <div class="max-w-7xl mx-auto grid xl:grid-cols-[minmax(0,34%)_minmax(0,66%)] gap-10 xl:gap-12 items-center">
        <div>
          <Eyebrow class="mb-3">How we work</Eyebrow>
          <h2 class="t-heading text-balance mb-4">Support shaped around your priorities</h2>
          <p class="t-body mb-8 max-w-lg">
            You choose the focus, and the support mix adapts to your goals &mdash; whether that&rsquo;s planning ahead, creating campaigns, improving results or keeping things running smoothly.
          </p>
          <ul class="space-y-4">
            {workPoints.map((point) => (
              <li class="flex items-start gap-3">
                <IconChip icon={'<path d="M5 13l4 4L19 7"/>'} shape="lg" class="shrink-0" />
                <span class="t-body text-[var(--color-ink)] pt-1">{point}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="relative">
          <!-- xl: connector lines, behind everything (below the cards) -->
          <svg class="hidden xl:block absolute inset-0 w-full h-full z-0 pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" aria-hidden="true">
            {connectors.paths.map((d) => (
              <path d={d} stroke="var(--color-accent-line-soft)" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linecap="round" />
            ))}
          </svg>

          <!-- below lg: the circle becomes a plain badge above the cards -->
          <div class="lg:hidden flex justify-center mb-6">
            <span class="t-title rounded-full bg-white border-4 border-[var(--color-accent-soft)] [box-shadow:var(--shadow-card)] px-6 py-3 text-center">Built around your priorities</span>
          </div>

          <div class="relative z-10 grid sm:grid-cols-2 gap-5 lg:gap-x-[17%] lg:gap-y-20">
            {workGroups.map((group) => (
              <div class:list={["rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 [box-shadow:var(--shadow-card)]", group.cardClass]}>
                <div class="flex items-center gap-3 mb-4">
                  <IconChip icon={group.icon} size="md" shape="lg" class="shrink-0" />
                  <p class="t-subheading">{group.label}</p>
                </div>
                <ul class="space-y-2">
                  {group.items.map((item) => (
                    <li class="rounded-xl border border-[var(--color-line)] bg-[var(--color-paper-dim)] px-3.5 py-2 t-small text-[var(--color-ink)]">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- lg+: the circle, centred on the grid, over the cards' inner corners -->
          <div class="hidden lg:flex absolute z-20 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[26%] aspect-square items-center justify-center rounded-full bg-white border-8 border-[var(--color-accent-soft)] [box-shadow:var(--shadow-card)] p-3 pointer-events-none">
            <p class="t-subheading text-center text-balance">Built around your priorities</p>
          </div>

          <!-- xl: the dots where each line meets a card edge (HTML so they stay round) -->
          <div class="hidden xl:block absolute inset-0 z-20 pointer-events-none" aria-hidden="true">
            {connectors.dots.map(([x, y]) => (
              <span class="absolute block w-2 h-2 rounded-full bg-[var(--color-accent)] -translate-x-1/2 -translate-y-1/2" style={`left:${x}%;top:${y}%`}></span>
            ))}
          </div>
        </div>
      </div>
    </Band>

  <!-- Section 3: Our engagement rhythm -->
  <Section>
    <SectionHeading
      eyebrow="Our engagement rhythm"
      heading="A support rhythm that keeps work moving"
    />
    <CadenceSteps
      steps={rhythmSteps}
      gridClass="sm:grid-cols-2 lg:grid-cols-4"
      connectorBreakpoint="lg"
      iconMode="image"
      iconBase={`${base}/marketing-support-rhythm-icons`}
    />
  </Section>

  <!-- Section 4: Who it's for -->
  <Section>
    <SectionHeading
      eyebrow="Who it's for"
      heading="Useful for teams that need capability without unnecessary complexity"
    />
    <div class="grid sm:grid-cols-3 gap-5">
      {audiences.map((item) => (
        <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]">
          <img
            src={`${base}/marketing-support-audiences/${item.image}.webp`}
            alt=""
            width="547"
            height="355"
            loading="lazy"
            class="h-[140px] w-full object-contain object-left mb-3 -ml-1"
            aria-hidden="true"
          />
          <p class="t-title mb-1.5">{item.title}</p>
          <p class="t-small">{item.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Section 5: How we fit in (see the data comment above) -->
  <Band>
      <div class="max-w-7xl mx-auto">
        <SectionHeading
          eyebrow="How we fit in"
          heading="Built to work alongside you and your existing partners"
          subtext="We integrate with your team and suppliers to add value where it's needed most."
        />

        <div>
          <div class="grid md:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_72px_auto_72px_minmax(0,1fr)] min-[1400px]:grid-cols-[minmax(0,1fr)_84px_auto_84px_minmax(0,1fr)] gap-6 xl:gap-0 xl:items-center">
            <!-- Your team -->
            <div class="rounded-[var(--radius-card)] bg-[var(--color-accent-soft)] border border-[rgba(255,61,107,0.15)] p-6 [box-shadow:var(--shadow-card)]">
              <div class="flex items-center gap-3 mb-4">
                <svg class="w-11 h-11 shrink-0 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={fitTeam.icon} />
                <p class="t-subheading">{fitTeam.title}</p>
              </div>
              <ul class="space-y-3">
                {fitTeam.items.map((text) => (
                  <li class="flex items-start gap-3">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[rgba(255,61,107,0.14)] text-[var(--color-accent)] shrink-0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                    </span>
                    <span class="t-small text-[var(--color-ink)] pt-0.5">{text}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- flows in from the left (lg+) -->
            <div class="hidden xl:flex flex-col justify-center gap-3 text-[var(--color-accent)]" aria-hidden="true">
              {fitFlows.left.map((row) => (
                <div class="relative flex items-center justify-center">
                  <span class="absolute inset-x-0 top-1/2 border-t-2 border-dotted border-[rgba(255,61,107,0.3)]"></span>
                  <span class="relative flex items-center gap-1 bg-[var(--color-paper-dim)] px-1">
                    {row.delays.map((d) => (
                      <svg class="fit-chev" style={`--d:${d}s`} width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d={row.dir === "right" ? "M9 5l7 7-7 7" : "M15 5l-7 7 7 7"}/></svg>
                    ))}
                  </span>
                </div>
              ))}
            </div>

            <!-- Vandalist: the square logo in a small circle that "receives" each flow -->
            <div class="relative mx-auto w-[200px] h-[200px] md:col-span-2 md:order-first xl:col-span-1 xl:order-none xl:w-[240px] xl:h-[240px] min-[1400px]:w-[330px] min-[1400px]:h-[330px] min-[1400px]:-my-[17px]">
              <span class="fit-ripple absolute inset-0 rounded-full pointer-events-none" aria-hidden="true"></span>
              <div class="w-full h-full rounded-full bg-white border-8 border-[var(--color-accent-soft)] flex items-center justify-center [box-shadow:var(--shadow-card)]">
                <!-- TRIAL (2026-11-12): the homepage TeamScene instead of the square logo (public/vandalist-square-logo-grey-pink.webp, kept for reverting).
                     Cropped by the circle; its pop-in is held until the section scrolls into view (script at the foot of the page). -->
                <div class="fit-scene relative w-full h-full overflow-hidden rounded-full">
                  <div class="absolute left-1/2 top-[57%] w-[122%] -translate-x-1/2 -translate-y-1/2">
                    <TeamScene />
                  </div>
                </div>
              </div>
            </div>

            <!-- flows in from the right (lg+) -->
            <div class="hidden xl:flex flex-col justify-center gap-3 text-[var(--color-accent)]" aria-hidden="true">
              {fitFlows.right.map((row) => (
                <div class="relative flex items-center justify-center">
                  <span class="absolute inset-x-0 top-1/2 border-t-2 border-dotted border-[rgba(255,61,107,0.3)]"></span>
                  <span class="relative flex items-center gap-1 bg-[var(--color-paper-dim)] px-1">
                    {row.delays.map((d) => (
                      <svg class="fit-chev" style={`--d:${d}s`} width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d={row.dir === "right" ? "M9 5l7 7-7 7" : "M15 5l-7 7 7 7"}/></svg>
                    ))}
                  </span>
                </div>
              ))}
            </div>

            <!-- Your other suppliers -->
            <div class="rounded-[var(--radius-card)] bg-white border border-[var(--color-line)] p-6 [box-shadow:var(--shadow-card)]">
              <div class="flex items-center gap-3 mb-4">
                <svg class="w-11 h-11 shrink-0 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={fitSuppliers.icon} />
                <p class="t-subheading">{fitSuppliers.title}</p>
              </div>
              <ul class="space-y-3">
                {fitSuppliers.items.map((text) => (
                  <li class="flex items-start gap-3">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                    </span>
                    <span class="t-small text-[var(--color-ink)] pt-0.5">{text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-10 flex items-center justify-center gap-3">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[var(--color-good-soft)] text-[var(--color-good)] shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <p class="t-small-strong text-balance">
              Clear communication, aligned goals and practical support that helps everything work better together.
            </p>
          </div>
        </div>
      </div>
    </Band>

  <CtaBand />
  <Footer />
</Layout>

<style>
  /* "How we fit in": exchange flows. Chevrons light up in turn flowing in from the left, then
     in from the right, every 6s; the logo circle gives a soft ripple as each one arrives.
     Static (finished picture) when the visitor prefers reduced motion. */
  /* the hub's team scene holds its pop-in (all its animations) until scrolled into view */
  .fit-scene.is-armed:not(.is-in) :global(.team-scene *) { animation-play-state: paused !important; }
  .fit-chev { opacity: 0.55; }
  .fit-ripple { box-shadow: 0 0 0 0 rgba(255, 61, 107, 0); }
  @media (prefers-reduced-motion: no-preference) {
    .fit-chev { opacity: 0.25; animation: fit-chev 6s ease-in-out infinite; animation-delay: var(--d); }
    .fit-ripple { animation: fit-ripple 6s ease-out infinite; }
  }
  @keyframes fit-chev {
    0% { opacity: 0.25; transform: scale(1); }
    6% { opacity: 1; transform: scale(1.25); }
    16% { opacity: 0.25; transform: scale(1); }
    100% { opacity: 0.25; transform: scale(1); }
  }
  @keyframes fit-ripple {
    0%, 12% { box-shadow: 0 0 0 0 rgba(255, 61, 107, 0); }
    13% { box-shadow: 0 0 0 0 rgba(255, 61, 107, 0.35); }
    27% { box-shadow: 0 0 0 22px rgba(255, 61, 107, 0); }
    62% { box-shadow: 0 0 0 0 rgba(255, 61, 107, 0); }
    63% { box-shadow: 0 0 0 0 rgba(255, 61, 107, 0.35); }
    77% { box-shadow: 0 0 0 22px rgba(255, 61, 107, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 61, 107, 0); }
  }
</style>

<script>
  // "How we fit in": the team scene in the hub waits (paused at its first frame) until it is on
  // screen, so the visitor sees the crew pop in. No JS = it simply runs on load.
  const scene = document.querySelector<HTMLElement>(".fit-scene");
  if (scene) {
    if (!("IntersectionObserver" in window)) {
      scene.classList.add("is-in");
    } else {
      scene.classList.add("is-armed");
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          scene.classList.add("is-in");
          io.disconnect();
        }
      }, { threshold: 0.6 });
      io.observe(scene);
    }
  }
</script>

---
// Campfire toggle concept for the "How We Work" page.
//
// Animation technique adapted from "CSSspark" by Ivan Grozdic (MIT licensed):
// https://codepen.io/ig_design/pen/NeRxzj
// Recoloured to the Vandalist palette, simplified (scene chrome removed —
// no moon/stars/trees/dark backdrop, since this needs to sit on the site's
// light background), and rebuilt as a proper toggle switch. The flame itself
// is a from-scratch gradient teardrop shape (v1 used three separately-
// flickering glow blobs, which read as disjointed rather than one fire —
// see PR feedback) with an outer body and a brighter inner core, both moving
// together so it reads as a single flame.
//
// v3 feedback (Andrew): keep the calm/small state exactly as-is (an "egg
// shape... under control"). On boost, don't shift toward pink — it read as
// looking chemical, not fiery — keep it in warm amber/orange tones instead.
//
// v4 feedback: the v3 "side lick" divs (positioned outside the main flame,
// left/right) read as separate flames stuck on the side — removed. Instead,
// on boost, two extra semi-transparent "twist" layers appear that share the
// exact same base pivot point as the main flame (transform-origin: 50% 100%,
// like the main flame) rather than sitting beside it, using an asymmetric
// border-radius (inspired by the layered-blob technique in "Campfire --
// Codevember #15" by Rose Liu: https://codepen.io/Rosefae/pen/oQBRXe, which
// builds a fire from several lopsided rounded shapes pivoting around one
// shared corner rather than a single symmetric blob). Overlapping at a
// shared base reads as one twisting flame, not several separate ones. The
// main flame's own border-radius also shifts asymmetric on boost — since
// border-radius transitions smoothly in CSS, this genuinely morphs shape
// rather than just resizing.
---
<div class="campfire-demo" data-campfire-root>
  <div class="campfire-stage">
    <div class="campfire-glow" aria-hidden="true"></div>
    <div class="campfire-embers" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="campfire-logs" aria-hidden="true"></div>
    <div class="campfire-fire" aria-hidden="true">
      <div class="flame-twist flame-twist-a"></div>
      <div class="flame-twist flame-twist-b"></div>
      <div class="flame-outer"></div>
      <div class="flame-inner"></div>
    </div>
  </div>

  <div class="campfire-control">
    <span class="campfire-control-label">Add a little Vandalist</span>
    <button
      type="button"
      class="campfire-switch"
      role="switch"
      aria-checked="false"
      aria-label="Increase flame intensity"
      data-campfire-switch
    >
      <span class="campfire-knob"></span>
    </button>
  </div>
</div>

<style>
  .campfire-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  /* No background/border here on purpose — this sits directly on whatever
     the page behind it is, so we can judge it against the real site bg.
     Sized as a rough approximation of an in-page footprint, not a big
     standalone hero demo — exact final size depends on where this lands. */
  .campfire-stage {
    position: relative;
    width: 100%;
    max-width: 300px;
    height: 220px;
    margin: 0 auto;
  }

  /* Soft warm pool of light at the base — subtle on purpose; a hazy radial
     glow that read fine over black turns into a muddy smudge over white. */
  .campfire-glow {
    position: absolute;
    left: 50%;
    bottom: 48px;
    width: 65%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 157, 31, 0.22), rgba(255, 157, 31, 0) 70%);
    filter: blur(8px);
    transition: transform 900ms cubic-bezier(0.4, 0, 0.2, 1), background 900ms ease;
  }
  .is-boosted .campfire-glow {
    transform: translateX(-50%) scale(1.35);
    background: radial-gradient(circle, rgba(255, 122, 26, 0.32), rgba(255, 122, 26, 0) 70%);
  }

  /* Simple crossed logs, no external image asset */
  .campfire-logs {
    position: absolute;
    left: 50%;
    bottom: 58px;
    width: 80px;
    height: 12px;
    transform: translateX(-50%);
  }
  .campfire-logs::before,
  .campfire-logs::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 12px;
    border-radius: 6px;
    background: linear-gradient(#4a3a2e, #2e2319);
  }
  .campfire-logs::before {
    transform: rotate(-7deg);
  }
  .campfire-logs::after {
    transform: rotate(7deg);
  }

  /* Flame — body + brighter inner core, moving as a single unit (the sway
     animation lives on the shared parent) so it reads as one flame. Two
     "twist" layers share the exact same base pivot as the main flame and
     only become visible on boost, giving the bigger flame a twisting,
     multi-layered character instead of reading as separate tongues. */
  .campfire-fire {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 63px;
    width: 50px;
    height: 76px;
    margin-left: -25px;
    transform-origin: 50% 100%;
    animation: campfire-sway 3.2s ease-in-out infinite;
    transition:
      width 900ms cubic-bezier(0.4, 0, 0.2, 1),
      height 900ms cubic-bezier(0.4, 0, 0.2, 1),
      margin-left 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .is-boosted .campfire-fire {
    width: 70px;
    height: 106px;
    margin-left: -35px;
    animation: campfire-sway-wild 2s ease-in-out infinite;
  }

  .flame-outer {
    position: absolute;
    inset: 0;
    border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    background: linear-gradient(180deg, #ffd23f 0%, #ff9d1f 45%, #f4560f 100%);
    filter: drop-shadow(0 10px 16px rgba(244, 86, 15, 0.32));
    animation: campfire-flicker-shape 2.4s ease-in-out infinite alternate;
    transition: background 900ms ease, filter 900ms ease;
  }
  .is-boosted .flame-outer {
    background: linear-gradient(180deg, #ffe066 0%, #ff7a1a 45%, #e2380c 100%);
    filter: drop-shadow(0 14px 22px rgba(226, 56, 12, 0.4));
    animation: campfire-flicker-shape-wild 1.7s ease-in-out infinite alternate;
  }

  .flame-inner {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 56%;
    height: 62%;
    margin-left: -28%;
    border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    background: linear-gradient(180deg, #fff6da 0%, #ffd23f 55%, #ff9d1f 100%);
    animation: campfire-shimmer 2.1s ease-in-out infinite;
    transition: background 900ms ease;
  }
  .is-boosted .flame-inner {
    background: linear-gradient(180deg, #fffbe6 0%, #ffcf4d 45%, #ff5a1f 100%);
  }

  /* Twist layers — same footprint and pivot as the main flame, invisible
     and shape-matched at rest (so there's no seam before boost). On boost
     they rotate slightly from that shared base and switch to a lopsided
     border-radius, overlapping the main flame to build a twisting
     composite silhouette rather than separate tongues. */
  .flame-twist {
    position: absolute;
    inset: 0;
    border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    background: linear-gradient(180deg, #ffd23f 0%, #ff9d1f 45%, #f4560f 100%);
    opacity: 0;
    transform-origin: 50% 100%;
    transition:
      opacity 700ms ease,
      transform 900ms cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 900ms cubic-bezier(0.4, 0, 0.2, 1),
      background 900ms ease;
  }
  .flame-twist-b {
    transform: scaleX(-1);
  }
  .is-boosted .flame-twist {
    opacity: 0.5;
    background: linear-gradient(180deg, #ffe066 0%, #ff7a1a 45%, #e2380c 100%);
  }
  .is-boosted .flame-twist-a {
    transform: rotate(16deg) scale(1.05);
    border-radius: 4% 72% 30% 62% / 58% 62% 38% 46%;
  }
  .is-boosted .flame-twist-b {
    transform: scaleX(-1) rotate(16deg) scale(1.05);
    border-radius: 4% 72% 30% 62% / 58% 62% 38% 46%;
  }

  @keyframes campfire-flicker-shape {
    0%,
    100% {
      transform: scale(1, 1);
      border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    }
    50% {
      transform: scale(0.94, 1.04);
      border-radius: 48% 52% 46% 54% / 60% 65% 35% 40%;
    }
  }
  /* Boosted flicker swings between two clearly asymmetric shapes (not just
     a bigger wobble on a centred one) so the main flame itself twists as
     it flickers, morphing toward the "traditional fire" reference rather
     than just pulsing size. */
  @keyframes campfire-flicker-shape-wild {
    0%,
    100% {
      transform: scale(1, 1) rotate(-2deg);
      border-radius: 10% 68% 26% 58% / 60% 56% 42% 46%;
    }
    50% {
      transform: scale(0.9, 1.08) rotate(3deg);
      border-radius: 56% 20% 62% 16% / 64% 44% 40% 60%;
    }
  }
  @keyframes campfire-shimmer {
    0%,
    100% {
      opacity: 0.92;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.05);
    }
  }
  @keyframes campfire-sway {
    0%,
    100% {
      transform: rotate(-1.5deg);
    }
    50% {
      transform: rotate(1.5deg);
    }
  }
  @keyframes campfire-sway-wild {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }

  /* Embers — small sparks drifting up, brighter/faster once boosted, still
     warm amber-red rather than shifting to brand pink */
  .campfire-embers span {
    position: absolute;
    bottom: 108px;
    left: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #febd08;
    opacity: 0;
    animation: campfire-ember 3.2s linear infinite;
    transition: background 900ms ease;
  }
  .campfire-embers span:nth-child(1) {
    left: 46%;
    animation-delay: 0s;
    --drift: 8px;
  }
  .campfire-embers span:nth-child(2) {
    left: 54%;
    animation-delay: 0.6s;
    --drift: -6px;
  }
  .campfire-embers span:nth-child(3) {
    left: 50%;
    animation-delay: 1.2s;
    --drift: 4px;
  }
  .campfire-embers span:nth-child(4) {
    left: 44%;
    animation-delay: 1.8s;
    --drift: -10px;
  }
  .campfire-embers span:nth-child(5) {
    left: 56%;
    animation-delay: 2.4s;
    --drift: 6px;
  }
  .campfire-embers span:nth-child(6) {
    left: 48%;
    animation-delay: 3s;
    --drift: -4px;
  }
  @keyframes campfire-ember {
    0% {
      transform: translateY(0) translateX(0) scale(1);
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(-110px) translateX(var(--drift, 6px)) scale(0.4);
      opacity: 0;
    }
  }
  .is-boosted .campfire-embers span {
    background: #ff5a1f;
    animation-duration: 2s;
  }

  /* Toggle switch */
  .campfire-control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .campfire-control-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .campfire-switch {
    width: 52px;
    height: 30px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-paper-dim);
    position: relative;
    cursor: pointer;
    padding: 0;
    transition: background 300ms ease, border-color 300ms ease;
  }
  .campfire-switch[aria-checked="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-orb);
  }
  .campfire-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 2px 4px rgba(28, 27, 26, 0.25);
    transition: transform 300ms cubic-bezier(0.54, 1.6, 0.5, 1);
  }
  .campfire-switch[aria-checked="true"] .campfire-knob {
    transform: translateX(22px);
  }

  @media (prefers-reduced-motion: reduce) {
    .campfire-fire,
    .flame-outer,
    .flame-inner,
    .flame-twist,
    .campfire-embers span {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-campfire-switch]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const root = btn.closest("[data-campfire-root]");
      const boosted = btn.getAttribute("aria-checked") === "true";
      btn.setAttribute("aria-checked", String(!boosted));
      root?.classList.toggle("is-boosted", !boosted);
    });
  });
</script>

---
// The wide tinted panel ("bleed-wider band"): a 1400px column holding a rounded
// --color-paper-dim panel with the real content inside, followed by the same
// standard bottom spacing as <Section> (pb-16 md:pb-20).
//
//   padding   inside the panel: "default" p-6 md:p-10 (most) | "roomy" p-6 md:p-12 |
//             "wide" p-6 md:py-10 md:px-16 (the homepage coverage table)
//   as        "div" (default) or "section"
//   class     rare extras on the outer wrapper
interface Props {
  as?: "div" | "section";
  padding?: "default" | "roomy" | "wide";
  class?: string;
}
const { as: Tag = "div", padding = "default", class: className } = Astro.props as Props;
// Literal strings so Tailwind's scanner sees every class.
const paddings = { default: "p-6 md:p-10", roomy: "p-6 md:p-12", wide: "p-6 md:py-10 md:px-16" };
---
<Tag class:list={["max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 pb-16 md:pb-20", className]}>
  <div class:list={["rounded-[var(--radius-card)] bg-[var(--color-paper-dim)]", paddings[padding]]}>
    <slot />
  </div>
</Tag>

---
// Fourth of 4-5 service pages, built from Andrew's supplied mockup ("get a
// start on" — first-pass template, not final). Nav, CtaBand and Footer are
// the site's shared chrome and untouched here.
//
// Per Andrew: "Disregard any new colours or inconsistent designs or
// elements." Two things in the mockup were dropped/simplified rather than
// reproduced faithfully, since nothing like them exists anywhere else on
// the site and building them would just add a second one-off pattern
// instead of removing the first:
// - The "Three pillars" section showed a center-circle + 3 orbiting-
//   satellite diagram with dotted connector lines. Rebuilt as a plain
//   icon+title+description row, matching the site's existing bullet-list
//   convention (google-social-ads.astro's approachPoints, etc.) instead of
//   introducing a new radial-diagram visual language.
// - "Everything your website needs to work better"'s right column was a
//   bespoke browser-chrome wireframe illustration (page layout mockup with
//   coloured bars). Dropped — the pills grid now runs full width instead.
// - "Better structure..."'s before/after was a pair of hand-drawn wireframe
//   thumbnails. Dropped in favour of just the results checklist, reusing
//   the exact checkmark-list pattern from HowWeWork.astro's "What we are"
//   section rather than a new illustration style.
//
// Hero gets the darker bg-paper-dim band behind Header+hero, proactively
// matching the treatment already applied to Home/Google Ads/Marketing
// Support/Consulting & Mentoring — Andrew's own consistency directive
// extends to this page too, even though he didn't ask again explicitly.
// Second hero column left empty, same reasoning as the other new pages.
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PageHeading from "../../components/PageHeading.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CadenceSteps from "../../components/CadenceSteps.astro";

const base = import.meta.env.BASE_URL;

// --- Section 1: Three pillars of a high-performing website ---
const pillars = [
  {
    title: "Clarity",
    text: "Clear messaging and structure help people instantly understand what you do and why it matters.",
    icon: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" stroke-linejoin="round"/><circle cx="12" cy="12" r="3"/>',
  },
  {
    title: "Usability",
    text: "Thoughtful layouts, intuitive navigation, and fast load times make the experience effortless.",
    icon: '<path d="M8 3v9l3-2 2 5 2-.8-2-5h4L8 3z" stroke-linejoin="round"/>',
  },
  {
    title: "Conversion",
    text: "Strategic calls to action and frictionless journeys turn interest into enquiries, bookings, and sales.",
    icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M4 15l5-5 4 3 6-7" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];

// --- Section 2: Everything your website needs to work better ---
const helpItems = [
  { text: "Page structure & information architecture", icon: '<circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M12 7v6M12 13l-7 6M12 13l7 6"/>' },
  { text: "Messaging & content hierarchy", icon: '<path d="M4 6h16M4 12h11M4 18h7" stroke-linecap="round"/>' },
  { text: "UX & layout refinement", icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/>' },
  { text: "SEO-friendly content structure", icon: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5" stroke-linecap="round"/>' },
  { text: "Forms & conversion paths", icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5" stroke-linecap="round"/>' },
  { text: "Performance & speed basics", icon: '<path d="M12 21a9 9 0 1 1 9-9" stroke-linecap="round"/><path d="M12 12l4-4M12 7v1" stroke-linecap="round"/>' },
  { text: "Landing pages that convert", icon: '<path d="M3 11l17-7-6 17-3-7-8-3z" stroke-linejoin="round"/>' },
  { text: "Ongoing optimisation & testing", icon: '<path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 17v-4.5H7.5"/>' },
];

// --- Section 3: How we work ---
const processSteps = [
  { num: "01", title: "Discover", text: "We audit your site, user journey, analytics and feedback to find what's holding it back.", icon: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5" stroke-linecap="round"/>' },
  { num: "02", title: "Plan", text: "We define priorities, structure, messaging and conversion goals that matter.", icon: '<path d="M4 7h16M4 12h10M4 17h6" stroke-linecap="round"/>' },
  { num: "03", title: "Improve", text: "We design and build improvements with focus on clarity, speed and usability.", icon: '<path d="M17 3.5a2.1 2.1 0 0 1 3 3L8.5 18 4 19l1-4.5L17 3.5z" stroke-linejoin="round"/>' },
  { num: "04", title: "Test", text: "We test with data and real users to validate what works and what needs adjusting.", icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M7 19v-6M12 19V8M17 19v-9" stroke-linecap="round"/>' },
  { num: "05", title: "Refine", text: "We iterate and optimise continuously to keep performance improving over time.", icon: '<path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 17v-4.5H7.5"/>' },
];

// --- Section 4: Better structure. Clearer message. Stronger results. ---
const outcomes = [
  "Stronger first impression with clear hierarchy",
  "Easier navigation and clearer value proposition",
  "Frictionless journey to the right action",
  "Improved speed and mobile experience",
  "More qualified enquiries and conversions",
];

// --- Section 5: Best suited for ---
const audiences = [
  {
    title: "Outdated or underperforming sites",
    text: "When your site no longer reflects your business or isn't delivering the results it should.",
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/>',
  },
  {
    title: "Better landing pages that convert",
    text: "When you need focused pages that clearly explain your offer and drive action.",
    icon: '<path d="M12 3l1.6 4.9H19l-4.2 3 1.6 5-4.4-3.2L7.6 16l1.6-5-4.2-3h5.4z" stroke-linejoin="round"/>',
  },
  {
    title: "Ongoing optimisation & growth",
    text: "For businesses that want continuous improvement, testing, and evolving their digital presence.",
    icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M4 15l5-5 4 3 6-7" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
---
<Layout title="Websites & Optimisation" description="Websites & optimisation that make it easier for people to act.">
  <div class="bg-[var(--color-paper-dim)]">
    <Header currentPage="/services/websites-optimisation" />

    <!-- Section 0: Hero -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-16 md:pb-20">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10 items-center">
        <div>
          <PageHeading as="h1" class="mb-6">Websites &amp; optimisation that make it easier for people to act</PageHeading>
          <p class="text-lg text-[var(--color-slate)] mb-10">
            We plan, design, and refine websites that are clearer, faster, and built to guide people to the right next step.
          </p>
          <a
            href={`${base}/contact`}
            class="inline-flex items-center gap-4 rounded-2xl bg-[var(--color-paper)] border border-[var(--color-line)] px-8 py-5 text-lg text-[var(--color-ink)] hover:border-[var(--color-slate)] transition-colors"
          >
            <span
              class="w-9 h-9 rounded-full shrink-0 ring-2 ring-white"
              style="background: var(--gradient-orb); box-shadow: var(--shadow-orb);"
            ></span>
            Book a strategy call
          </a>
        </div>

        <!-- Deliberately empty — see frontmatter note. -->
        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </section>
  </div>

  <div class="bg-[var(--color-paper)]">
    <!-- Section 1: Three pillars of a high-performing website -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-16 md:pt-20 pb-16 md:pb-20">
      <SectionHeading
        eyebrow="What makes a website actually useful"
        heading="Three pillars of a high-performing website"
      />
      <div class="grid sm:grid-cols-3 gap-8">
        {pillars.map((pillar) => (
          <div class="flex items-start gap-4">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={pillar.icon} />
            </span>
            <div>
              <p class="font-semibold text-[var(--color-ink)] mb-1">{pillar.title}</p>
              <p class="text-sm text-[var(--color-slate)] leading-relaxed">{pillar.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 2: Everything your website needs to work better -->
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 pb-16 md:pb-20">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-paper-dim)] p-6 md:p-10">
        <div class="max-w-7xl mx-auto">
          <SectionHeading
            eyebrow="Where we help"
            heading="Everything your website needs to work better"
          />
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
            {helpItems.map((item) => (
              <div class="rounded-xl border border-[var(--color-line)] bg-white p-4 flex items-center gap-3 min-w-0">
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                </span>
                <span class="text-sm font-medium text-[var(--color-ink)] leading-snug min-w-0">{item.text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Section 3: How we work -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-20">
      <SectionHeading
        eyebrow="How we work"
        heading="A clear process from insight to impact"
      />
      <CadenceSteps
        steps={processSteps}
        gridClass="sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
        connectorBreakpoint="xl"
      />
    </section>

    <!-- Section 4: Better structure. Clearer message. Stronger results. -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-20">
      <SectionHeading
        eyebrow="From site that exists to site that performs"
        heading="Better structure. Clearer message. Stronger results."
      />
      <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white max-w-2xl [box-shadow:var(--shadow-card)]">
        <ul>
          {outcomes.map((item, i) => (
            <li class:list={["flex items-center gap-3 px-6 py-4", i < outcomes.length - 1 && "border-b border-[var(--color-line)]"]}>
              <span class="w-6 h-6 rounded-full bg-[var(--color-good)] flex items-center justify-center shrink-0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="text-[var(--color-ink)]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Section 5: Best suited for -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <SectionHeading
        eyebrow="When this is useful"
        heading="Best suited for"
      />
      <div class="grid sm:grid-cols-3 gap-5">
        {audiences.map((item) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6">
            <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-4">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </span>
            <p class="font-semibold text-[var(--color-ink)] mb-1.5">{item.title}</p>
            <p class="text-sm text-[var(--color-slate)] leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <CtaBand />
  <Footer />
</Layout>

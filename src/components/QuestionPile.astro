---
// "Question pile" concept for the Google Ads page's currently-empty hero
// graphic slot: questions drop in one at a time, each landing on top of
// the last — building a genuine pile that visibly grows TALLER (starts
// ~1-2 questions high, ends up ~7-8 high), then it clears to a single
// calm resolution line.
//
// v2 was per Andrew's reference sketch: one question at a time, a visible
// downward arrow cueing each drop, landing with increasing rotation/spread
// anchored to one point. v1 before that was a rapid *scattered burst*
// across the whole stage (~42 chips at random positions, mechanic adapted
// from the idea of mattdesl's "codevember" day 9 sketch — see git history
// on this file for that reasoning).
//
// v3 was per Andrew's feedback after seeing v2 live: arrow removed
// entirely (mockup shorthand for "these are falling", not meant to
// ship); reworked v2's radial-fan landing spread (jitter growing outward
// in all directions from one point) into a genuine vertical stack (each
// chip's resting spot rises a fixed step further up the stage than the
// last); chips alternate between Anton (blocky stamp) and Caveat (the
// campfire toggle's handwritten accent font) at randomised sizes, for
// variety instead of a single consistent typeface.
//
// v4 (this version), after seeing v3 live and in isolation only — per
// Andrew, "we'd need to get it set to the right size and speed on the
// page to really see how it works":
// - Now integrated into the real google-social-ads.astro hero (see that
//   file) instead of only living on the standalone demo page.
// - Much higher volume (8 chips -> 24, i.e. the full question set once
//   through) at a much faster drop rate (650ms/chip -> 160ms/chip) and
//   noticeably larger type, per "a heap more questions that come down a
//   lot quicker... larger in terms of font size and presence" — the
//   intensity/overwhelm is meant to build up hard before the resolution
//   line arrives, not ease into it.
// - The pile now aims each chip's rise at a bold target (close to the
//   very top of the stage by the last chip) instead of a conservative
//   fixed fraction, then corrects any individual chip that would clip —
//   not by predicting its bounding box via trigonometry (tried that
//   first; it disagreed with the real rendered position by tens of px,
//   because it's genuinely fiddly to know which axis a translateY moves
//   along inside a transform list that also contains a rotate()), but by
//   applying the candidate position, measuring where it ACTUALLY lands
//   with getBoundingClientRect(), and dialling back by exactly however
//   far it overshot. Happens synchronously before the chip's first paint,
//   so there's nothing to see. Robust across any stage height (standalone
//   demo vs. the real hero's grid cell, mobile vs. desktop) and any
//   text/font/size/rotation combination, since it's checking reality
//   rather than predicting it.
export interface Props {
  questions?: string[];
  resolutionHeading?: string;
  resolutionText?: string;
}

const {
  questions = [
    "What's my budget?",
    'Why is my CPC so high?',
    'Manual or automatic bidding?',
    "What's Quality Score?",
    "Why aren't my ads showing?",
    'Is this even working?',
    "What's a good CTR?",
    'Negative keywords?',
    'Am I targeting the right people?',
    'Why did conversions drop?',
    "What's ROAS mean?",
    'Should I pause this?',
    'Is my landing page the problem?',
    "Who's managing this daily?",
    "Why is my competitor above me?",
    'Search vs Display campaign?',
    'Is tracking even set up right?',
    "How much is 'too much' to spend?",
    "What's Smart Bidding?",
    'Why did my Quality Score drop?',
    'Should I worry about invalid clicks?',
    'What even is an ad group?',
    'Is this actually bringing in leads?',
    'Why does this dashboard make no sense?',
  ],
  resolutionHeading = 'We handle all of this for you.',
  resolutionText = 'Plain-English updates. None of the jargon headache.',
} = Astro.props;
---

<div class="qpile" data-qpile-root>
  <div class="qpile-stage" data-qpile-stage aria-hidden="true"></div>

  <div class="qpile-resolution" data-qpile-resolution>
    <span class="qpile-resolution-dot" aria-hidden="true"></span>
    <p class="qpile-resolution-heading">{resolutionHeading}</p>
    <p class="qpile-resolution-text">{resolutionText}</p>
  </div>

  <button type="button" class="qpile-replay" data-qpile-replay aria-label="Replay animation">
    ↻ Replay
  </button>
</div>

<style>
  .qpile {
    position: relative;
    width: 100%;
    border-radius: var(--radius-card);
    background: var(--color-paper-dim);
    overflow: hidden;
  }

  .qpile-stage {
    position: relative;
    width: 100%;
    height: 280px;
  }
  @media (min-width: 768px) {
    .qpile-stage {
      height: 370px;
    }
  }

  .qpile-resolution {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 2rem;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 500ms ease, transform 500ms ease;
  }
  .qpile-resolution.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .qpile-resolution-dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    margin-bottom: 1rem;
    background: var(--gradient-orb);
    box-shadow: var(--shadow-orb);
  }
  .qpile-resolution-heading {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
    max-width: 22rem;
  }
  @media (min-width: 768px) {
    .qpile-resolution-heading {
      font-size: 1.625rem;
    }
  }
  .qpile-resolution-text {
    font-size: 0.9375rem;
    color: var(--color-slate);
  }

  .qpile-replay {
    position: absolute;
    bottom: 0.85rem;
    right: 0.85rem;
    z-index: 5;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-slate);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .qpile-replay:hover {
    border-color: var(--color-slate);
    color: var(--color-ink);
  }
</style>

<!-- Deliberately a SEPARATE, global (unscoped) style block: .qchip elements
     are created client-side via document.createElement, not by Astro's own
     render — they never get the data-astro-cid attribute Astro's normal
     scoped-<style> selectors require, so scoping this block would silently
     match nothing. Confirmed via computed style (position/transform coming
     back as the browser defaults, none of this actually applying) before
     splitting it out — this bug predates this session's changes and quietly
     affected the very first "scattered burst" version too, not just this
     rewrite. Class names are specific enough (qchip, qpile-*) that going
     unscoped here is a low collision risk. -->
<style is:global>
  /* Each question: bare bold text (no card/border — matches the reference,
     and keeps it legible; font-family/size are set inline per chip in JS
     for variety, not fixed here). Anchored near the stage's bottom
     (top: 80%); --rise (how far up from that anchor this chip sits, set
     in JS, growing with pile index) is what makes the pile grow TALLER as
     more land, rather than spreading sideways — --jx is a much smaller
     jitter on top of that, just enough to look like a leaning stack, not
     a scattered burst. `scale` is its own standalone CSS property (not
     part of `transform`) specifically so the clearing shrink can
     transition independently of the rotate/translate that live in
     `transform` — both animate at once with no conflict. */
  .qchip {
    position: absolute;
    left: 50%;
    top: 80%;
    transform: translate(-50%, -50%) translate(var(--jx, 0px), 0) translateY(calc(var(--rise, 0px) * -1)) rotate(var(--r, 0deg)) translateY(-70px);
    scale: 0.94;
    max-width: 260px;
    line-height: 1.15;
    color: var(--color-ink);
    text-align: center;
    text-wrap: balance;
    opacity: 0;
    pointer-events: none;
    transition: transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1), scale 400ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 200ms ease;
  }
  .qchip.is-in {
    scale: 1;
    opacity: 1;
    transform: translate(-50%, -50%) translate(var(--jx, 0px), 0) translateY(calc(var(--rise, 0px) * -1)) rotate(var(--r, 0deg));
  }
  .qpile-stage.is-clearing .qchip {
    scale: 0.7;
    opacity: 0;
    transition: scale 320ms ease, opacity 320ms ease;
  }
</style>

<script define:vars={{ questions }}>
  function shuffle(input) {
    const arr = input.slice();
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  // Anton (blocky stamp) and Caveat (the campfire toggle's handwritten
  // accent font) alternate per chip — deliberate variety, not a single
  // consistent typeface, per Andrew's "different sizes and possibly
  // different fonts... to create a feeling of chaos".
  const FONT_ANTON = "'Anton', sans-serif";
  const FONT_CAVEAT = "'Caveat', cursive";

  document.querySelectorAll('[data-qpile-root]').forEach((root) => {
    const stage = root.querySelector('[data-qpile-stage]');
    const resolution = root.querySelector('[data-qpile-resolution]');
    const replayBtn = root.querySelector('[data-qpile-replay]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 24 = the whole question set once through, no repeats needed for "a
    // heap more questions". 160ms/chip (was 650) is deliberately fast —
    // Andrew wants intensity building hard before the resolution line,
    // not an easing-in.
    const CHIP_COUNT = reduceMotion ? 6 : 24;
    const STEP_DELAY = reduceMotion ? 0 : 160;

    let timer = null;
    let runToken = 0;

    const SAFE_MARGIN = 12; // px kept clear above the topmost chip at all times

    // Rotation/horizontal jitter grow with pile index (a real stack leans
    // more as it gets taller/more precarious) but stay tight — the visual
    // cue that reads as "a pile getting taller" is --rise, which climbs
    // toward the top of the stage per chip. The DESIRED rise aims boldly
    // (near the very top by the last chip) but gets corrected per-chip
    // against its own ACTUAL rendered position — not predicted via
    // trigonometry from its measured width/height/rotation, which turned
    // out to disagree with reality by tens of px (confirmed by testing:
    // a trig-based predictive clamp still clipped ~35px off the top on a
    // real run, because it's genuinely fiddly to know which axis a
    // translateY inside a transform list moves along once a rotate() is
    // also in that same list, without just checking). Instead: apply the
    // candidate rise, measure where the chip *actually* lands with
    // getBoundingClientRect(), and dial the rise back by exactly however
    // far it overshot. This happens synchronously before the chip's first
    // paint (see the double-rAF below), so there's nothing to see.
    function spawnChip(text, index, anchorY, desiredRiseStep) {
      const chip = document.createElement('div');
      chip.className = 'qchip';
      chip.textContent = text;

      const rotateMagnitude = Math.min(5 + index * 0.9, 20);
      const rotate = (Math.random() * 2 - 1) * rotateMagnitude;
      const jx = ((Math.random() * 2 - 1) * Math.min(8 + index * 1.6, 44)).toFixed(0);

      const isScript = Math.random() < 0.35;
      const fontSize = isScript
        ? (1.5 + Math.random() * 0.8).toFixed(2) // Caveat reads smaller than Anton at the same px size, so run it bigger
        : (1.25 + Math.random() * 0.75).toFixed(2);

      chip.style.setProperty('--r', `${rotate.toFixed(1)}deg`);
      chip.style.setProperty('--jx', `${jx}px`);
      chip.style.fontFamily = isScript ? FONT_CAVEAT : FONT_ANTON;
      chip.style.fontWeight = isScript ? '600' : '400';
      chip.style.fontSize = `${fontSize}rem`;
      chip.style.zIndex = String(10 + index);

      let rise = index * desiredRiseStep + (Math.random() * desiredRiseStep * 0.6 - desiredRiseStep * 0.3);
      rise = Math.max(rise, 0);
      chip.style.setProperty('--rise', `${rise.toFixed(1)}px`);
      stage.appendChild(chip);

      // Measure against the settled (.is-in) transform, then dial back if
      // it overshoots — a couple of passes to converge regardless of the
      // exact relationship between --rise and the rendered position.
      // transition is forced off for this whole measure/correct cycle:
      // the FIRST is-in add is this element's first-ever style change so
      // it wouldn't transition anyway, but adjusting --rise again on pass
      // 2+ (while is-in is already applied) is a genuine before/after
      // style change on an element the browser HAS already observed —
      // that would actually start a real transition, and reading
      // getBoundingClientRect() a moment later would catch it mid-flight
      // rather than at its final value. Confirmed by testing: without
      // this, single-correction chips measured fine but anything needing
      // a second pass measured its pass-0 (not fully corrected) position.
      chip.style.transition = 'none';
      chip.classList.add('is-in');
      for (let pass = 0; pass < 3; pass++) {
        const stageTop = stage.getBoundingClientRect().top;
        const chipTop = chip.getBoundingClientRect().top;
        const overflow = SAFE_MARGIN - (chipTop - stageTop);
        if (overflow <= 0) break;
        rise = Math.max(rise - overflow, 0);
        chip.style.setProperty('--rise', `${rise.toFixed(1)}px`);
      }
      chip.classList.remove('is-in'); // back to pre-animation state
      void chip.offsetHeight; // force the browser to commit that reverted state...
      chip.style.transition = ''; // ...before restoring the real transition for the pop-in below

      // Double rAF so the browser commits the initial (scale: .94, opacity: 0,
      // translateY(-70px)) state to a frame before .is-in flips the
      // transition target — a same-tick class add wouldn't animate, it'd
      // just jump straight to the end state.
      requestAnimationFrame(() => requestAnimationFrame(() => chip.classList.add('is-in')));
    }

    function run() {
      const token = ++runToken;
      clearTimeout(timer);
      stage.classList.remove('is-clearing');
      resolution.classList.remove('is-visible');
      stage.querySelectorAll('.qchip').forEach((c) => c.remove());

      const pool = shuffle(questions).slice(0, CHIP_COUNT);
      let i = 0;

      // The anchor point sits at top: 80% (see .qchip below), so anchorY
      // (0.8 * stage height) is the spare room above it before any rise
      // is applied. Aim boldly — try to have the pile reach almost all
      // the way to the very top by the last chip — since spawnChip's own
      // per-chip clamp (based on that chip's actual measured size) is
      // what actually prevents clipping, not this target fraction.
      const stageHeight = stage.clientHeight;
      const anchorY = stageHeight * 0.8;
      const desiredRiseStep = (anchorY - 12) / Math.max(pool.length - 1, 1);

      function step() {
        if (token !== runToken) return;
        if (i >= pool.length) {
          timer = setTimeout(() => {
            if (token !== runToken) return;
            stage.classList.add('is-clearing');
            setTimeout(() => {
              if (token !== runToken) return;
              resolution.classList.add('is-visible');
            }, 380);
          }, 550);
          return;
        }
        spawnChip(pool[i], i, anchorY, desiredRiseStep);
        i++;
        timer = setTimeout(step, STEP_DELAY);
      }
      step();
    }

    replayBtn.addEventListener('click', run);

    // Anton/Caveat are only ever requested by these dynamically-created
    // chips (nothing in the server-rendered HTML uses them), so without
    // this the browser wouldn't start fetching either font until the very
    // first chip sets fontFamily — meaning the first couple of chips on a
    // cold load could render (and get measured/corrected against) a
    // fallback font, then visibly swap to the real one a moment later.
    // spawnChip's own measure-and-correct clamp makes that a cosmetic
    // flash-of-fallback-font issue rather than a clipping one now, but
    // preloading here avoids the flash too.
    Promise.all([
      document.fonts.load("400 2rem Anton"),
      document.fonts.load("600 2rem Caveat"),
    ]).catch(() => {}).then(run);
  });
</script>

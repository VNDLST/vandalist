---
// Shared closing CTA band (every page). Copy + layout per Andrew's mockup
// (2026-10-12): left-aligned inside the same centred max-w-3xl column the
// band always used, a small "Brain dump or specific requirements:" line,
// then a large headline whose pink word rotates through direction /
// support / resources / concepts / clarity. Button and band background
// are unchanged.
//
// The rotating-word technique is Cruip's "Sliding Text Animation with
// Tailwind CSS" CodePen (MIT, https://codepen.io/cruip/pen/dywRwNV),
// re-authored here rather than vendored: a fixed one-line-high window
// (overflow hidden) over a stacked list that steps up one line at a time.
// Its keyframe percentages assume exactly six rows — five words plus a
// repeat of the first so the loop wraps seamlessly — which is what the
// five words below give. The `word-slide` keyframes live in global.css.
// The word is sized 1.4em of the headline (larger than the surrounding
// text, as in the mockup) and uses --color-accent, which is now #FF3D6B.
//
// Accessibility: the animated markup is aria-hidden and a single sr-only
// sentence carries the full meaning, so screen readers don't hear the
// words cycling. prefers-reduced-motion freezes it on the first word.
const words = ["direction", "support", "resources", "concepts", "clarity"];
---
<section class="relative z-10 bg-[var(--color-paper-dim)] border-t-2 border-[var(--color-paper-deep)]">
  <div class="max-w-3xl mx-auto px-6 md:px-10 py-16 md:py-20 text-left">
    <p class="text-sm text-[var(--color-ink)] mb-1.5">Brain dump or specific requirements:</p>
    <h2 class="text-2xl md:text-[28px] font-bold text-[var(--color-ink)] mb-6">
      <span class="sr-only">We’ll provide the {words.slice(0, -1).join(", ")} or {words[words.length - 1]} you’re looking for.</span>
      <span aria-hidden="true">
        We’ll provide the
        <span class="inline-flex flex-col overflow-hidden align-middle mx-1.5 h-[1.2em] text-[1.4em] leading-[1.2] font-semibold text-[var(--color-accent)]">
          <span class="block word-slide text-left [&>span]:block">
            {words.map((w) => <span>{w}</span>)}
            <span>{words[0]}</span>
          </span>
        </span>
        you’re looking for.
      </span>
    </h2>
    <a
      href={`${import.meta.env.BASE_URL}/contact`}
      class="inline-flex items-center gap-4 rounded-2xl bg-[var(--color-paper)] border border-[var(--color-line)] px-7 py-4 text-base text-[var(--color-ink)] hover:border-[var(--color-slate)] transition-colors"
    >
      <span
        class="w-8 h-8 rounded-full shrink-0 ring-2 ring-white orb-pulse"
        style="background: var(--gradient-orb); box-shadow: var(--shadow-orb);"
      ></span>
      How can we help?
    </a>
  </div>
</section>

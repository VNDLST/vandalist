---
// Internal concept preview — not a real site page, not linked from
// navigation. Delete once the "Add a little Vandalist" idea has been
// decided on / integrated into how-we-work.astro (or discarded).
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";
import PageHeading from "../components/PageHeading.astro";
import CampfireToggle from "../components/CampfireToggle.astro";
---
<Layout title="Campfire Concept (Internal)">
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/campfire-demo" />

    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-20 md:pb-28">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <Eyebrow class="mb-3">Internal concept — not a real page</Eyebrow>
        <Heading as="h1" class="mb-4">Campfire toggle, adapted for Vandalist</Heading>
        <p class="text-[var(--color-slate)]">
          Concept for the "How We Work" page: a small campfire that gets bigger and
          wilder when you flip the switch — stays in warm amber/orange throughout
          rather than shifting toward brand pink, which read as chemical rather than
          fiery. The bigger flame twists via two extra layers sharing the same base
          as the main flame (not separate tongues stuck on the side), a technique
          borrowed from&nbsp;
          <a
            href="https://codepen.io/Rosefae/pen/oQBRXe"
            class="text-[var(--color-accent)] underline underline-offset-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            "Campfire" by Rose Liu
          </a>. Base toggle mechanic adapted from&nbsp;
          <a
            href="https://codepen.io/ig_design/pen/NeRxzj"
            class="text-[var(--color-accent)] underline underline-offset-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            "CSSspark" by Ivan Grozdic
          </a>
          (both MIT licensed) — recoloured and rebuilt from scratch either way.
        </p>
      </div>

      <div class="flex justify-center">
        <CampfireToggle />
      </div>

      <p class="text-center text-sm text-[var(--color-slate-light)] mt-10">
        Flip the switch a few times, try it at different widths, then let&rsquo;s talk about whether
        (and how) this fits on the real page.
      </p>
    </section>

    <!-- In-context mockup: roughly the real how-we-work.astro hero layout
         (text left ~2/5, graphic right ~3/5), with the campfire standing in
         for that section's placeholder graphic, so size/placement can be
         judged against actual page proportions instead of in isolation. -->
    <section class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 pb-20 md:pb-28">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-paper-dim)] p-6 md:p-10">
        <p class="text-sm font-medium text-[var(--color-slate-light)] mb-6">
          ↓ Mockup only — not a real section, just the how-we-work.astro hero grid for scale reference
        </p>
        <div class="grid lg:grid-cols-[2fr_3fr] gap-10 items-center">
          <div>
            <PageHeading as="h2" class="mb-6">Practical, sustainable, and easy to work with</PageHeading>
            <p class="max-w-md text-lg text-[var(--color-slate)]">
              We adapt to requirements whether that is being part of the strategic
              conversations, or being utilised for specific production tasks.
            </p>
          </div>
          <div class="relative flex justify-center">
            <!-- Minimalist backdrop so the fire reads as part of a scene
                 rather than floating alone — composition (receding trees +
                 a hill it sits on) borrowed from the reference mockup, but
                 recoloured into the site's muted paper/ink palette instead
                 of that reference's own pink. Static, no animation. -->
            <svg
              class="absolute inset-0 w-full h-full pointer-events-none"
              viewBox="0 0 500 240"
              preserveAspectRatio="xMidYMax slice"
              aria-hidden="true"
            >
              <path
                d="M0 205 Q 110 165 250 182 T 500 195 L 500 240 L 0 240 Z"
                fill="var(--color-paper-deep)"
                opacity="0.7"
              />
              <polygon points="36,212 44,212 40,188" fill="var(--color-slate)" opacity="0.28" />
              <polygon points="82,210 93,210 87.5,178" fill="var(--color-slate)" opacity="0.32" />
              <polygon points="138,207 152,207 145,168" fill="var(--color-slate)" opacity="0.36" />
              <polygon points="200,204 217,204 208.5,158" fill="var(--color-slate)" opacity="0.4" />
              <polygon points="298,201 319,201 308.5,142" fill="var(--color-slate)" opacity="0.44" />
            </svg>
            <div class="relative">
              <CampfireToggle />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Footer />
</Layout>

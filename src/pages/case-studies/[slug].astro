---
// Reusable individual case-study template — one file renders every case
// study in the content collection. The design is driven by whichever
// fields a given case study actually has (see src/content/config.ts): a
// minimal, anonymised, or lighter case study is a fully valid page, not a
// broken/incomplete one.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import ServiceTagPill from "../../components/ServiceTagPill.astro";
import CaseStudyImage from "../../components/CaseStudyImage.astro";
import CaseStudyMetaStrip from "../../components/CaseStudyMetaStrip.astro";
import CaseStudySection from "../../components/CaseStudySection.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import { serviceLabel } from "../../lib/services";
import { getRelatedCaseStudies } from "../../lib/caseStudies";

export async function getStaticPaths() {
  const entries = await getCollection("case-studies");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, allEntries: entries },
  }));
}

const { entry, allEntries } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;

const related = getRelatedCaseStudies(entry, allEntries, 3);

const icons = {
  situation: '<path d="M6 3h9l3 3v15H6z" stroke-linejoin="round"/><path d="M9 10h6M9 13.5h6M9 17h4"/>',
  problem: '<path d="M12 3l9 16H3z" stroke-linejoin="round"/><path d="M12 10v4" stroke-linecap="round"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/>',
  findings: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5" stroke-linecap="round"/>',
  work: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
  reasoning: '<path d="M12 3a6 6 0 0 0-3 11.2c.6.4 1 1.1 1 1.8h4c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"/><path d="M9 18h6M10 21h4"/>',
  outcome: '<path d="M4 19h16" stroke-linecap="round"/><path d="M4 14l5-5 4 4 6-7" stroke-linecap="round" stroke-linejoin="round"/>',
  evidence: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 15l-5-5-9 9" stroke-linecap="round" stroke-linejoin="round"/>',
};
---
<Layout title={data.title} description={data.summary}>
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/case-studies" />

    <div class="max-w-7xl mx-auto px-6 md:px-10 pb-10 md:pb-14">
      <a href={`${base}/case-studies`} class="inline-flex items-center gap-1.5 text-sm text-[var(--color-slate)] hover:text-[var(--color-ink)] transition-colors mb-8">
        <span aria-hidden="true">&larr;</span> Back to all case studies
      </a>

      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 items-start mb-8">
        <div>
          <p class="font-semibold text-[var(--color-ink)] mb-2">{data.title}</p>
          <h1 class="text-3xl md:text-4xl font-semibold leading-[1.1] tracking-[-0.02em] text-[var(--color-ink)] mb-4">
            {data.outcomeHeadline}
          </h1>
          {data.context && <p class="text-[var(--color-slate)] mb-5 max-w-lg">{data.context}</p>}
          {data.confidential && (
            <p class="text-sm text-[var(--color-slate-light)] italic mb-5">Client details withheld for confidentiality.</p>
          )}
          <div class="flex flex-wrap gap-2">
            {data.services.map((s) => <ServiceTagPill label={serviceLabel(s)} />)}
          </div>
        </div>
        <div class="aspect-[16/10] rounded-2xl overflow-hidden">
          <CaseStudyImage src={data.featuredImage} alt={data.title} rounded="rounded-none" />
        </div>
      </div>

      <CaseStudyMetaStrip
        client={data.confidential ? undefined : data.title}
        industry={data.industry}
        engagement={data.engagement}
        timeframe={data.timeframe}
        location={data.location}
      />
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28 space-y-14 md:space-y-16">
      {data.situation && (
        <CaseStudySection title="The situation" icon={icons.situation}>
          <p>{data.situation}</p>
        </CaseStudySection>
      )}

      {data.problem && (
        <CaseStudySection title="The problem" icon={icons.problem}>
          <p>{data.problem}</p>
          {data.results?.length ? (
            <Fragment slot="aside">
              <div class="rounded-[var(--radius-card)] bg-[var(--color-accent-soft)] p-5">
                <p class="flex items-center gap-2 font-semibold text-[var(--color-ink)] mb-4">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.75"><path d="M4 19h16" stroke-linecap="round"/><path d="M7 19v-6M12 19V8M17 19v-9" stroke-linecap="round"/></svg>
                  Results
                </p>
                <div class="grid grid-cols-2 gap-4">
                  {data.results.map((r) => (
                    <div>
                      <p class="text-xl font-semibold text-[var(--color-accent)]">{r.value}</p>
                      <p class="text-xs text-[var(--color-slate)] leading-snug">{r.label}</p>
                    </div>
                  ))}
                </div>
              </div>
            </Fragment>
          ) : null}
        </CaseStudySection>
      )}

      {data.findings && (
        <CaseStudySection title="What we found" icon={icons.findings}>
          <p>{data.findings}</p>
        </CaseStudySection>
      )}

      {data.workstreams?.length ? (
        <CaseStudySection title="What we did" icon={icons.work}>
          <div class="grid sm:grid-cols-2 gap-5">
            {data.workstreams.map((w) => (
              <div class="flex items-start gap-3">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0 mt-0.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <div>
                  <p class="font-semibold text-[var(--color-ink)] mb-0.5">{w.label}</p>
                  <p class="text-sm text-[var(--color-slate)] leading-relaxed">{w.description}</p>
                </div>
              </div>
            ))}
          </div>
        </CaseStudySection>
      ) : null}

      {data.reasoning && (
        <CaseStudySection title="Why we took that approach" icon={icons.reasoning}>
          <p>{data.reasoning}</p>
        </CaseStudySection>
      )}

      {(data.outcome || data.quote) && (
        <CaseStudySection title="Outcome" icon={icons.outcome}>
          {data.outcome && <p>{data.outcome}</p>}
          {data.quote && (
            <blockquote class="rounded-[var(--radius-card)] bg-[var(--color-accent-soft)] p-6 not-italic">
              <p class="text-[var(--color-ink)] mb-3">&ldquo;{data.quote.text}&rdquo;</p>
              <cite class="text-sm text-[var(--color-slate)] not-italic">&mdash; {data.quote.attribution}</cite>
            </blockquote>
          )}
        </CaseStudySection>
      )}

      {data.evidenceImages?.length ? (
        <CaseStudySection title="The work" icon={icons.evidence}>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {data.evidenceImages.map((img) => (
              <div class="aspect-[4/5] rounded-xl overflow-hidden">
                <CaseStudyImage src={img.src} alt={img.alt} rounded="rounded-none" />
              </div>
            ))}
          </div>
        </CaseStudySection>
      ) : null}

      <div class="text-[var(--color-slate)] leading-relaxed [&>*+*]:mt-4">
        <Content />
      </div>

      {related.length > 0 && (
        <div>
          <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-ink)] mb-6">Related case studies</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map((r) => <CaseStudyCard entry={r} />)}
          </div>
        </div>
      )}
    </div>
  </div>

  <CtaBand />
  <Footer />
</Layout>

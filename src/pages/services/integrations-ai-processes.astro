---
// Fifth (last) of the planned service pages, built from Andrew's supplied
// mockup ("get a start on" — first-pass template, not final). Nav, CtaBand
// and Footer are the site's shared chrome and untouched here.
//
// Per Andrew: "Disregard any new colours or inconsistent designs or
// elements." Several things simplified rather than reproduced faithfully:
// - Icons in "A practical enablement system..." were drawn in a teal/green
//   the token system doesn't have — recoloured to the standard
//   --color-accent pink used for every other icon on the site, not a new
//   colour.
// - "From manual and messy to clear and assisted"'s two elaborate
//   dotted-branching flowcharts simplified to two plain columns of small
//   labelled steps with coloured status tags — but its RED/GREEN tag
//   colours map exactly onto --color-bad/--color-bad-soft and
//   --color-good/--color-good-soft, which already exist in the token
//   system and (per global.css's own comment) had nothing using
//   --color-bad yet. Genuine reuse of an existing-but-unused token, not a
//   new colour — the one part of this mockup kept close to as-drawn.
// - "Where AI actually helps"'s center-circle-with-6-orbiting-cards
//   diagram: briefly rebuilt as a hand-rolled hub-and-spoke diagram with
//   SVG connector lines (see git history — a shared HubDiagram component
//   was even extracted for it and reused on the SEO page), then Andrew
//   pointed out an already-live section doing almost exactly this —
//   about.astro's "A small team. A complete ecosystem." — as his
//   preferred model, since it says the same "central thing + supporting
//   facets" idea without needing connector lines at all (a stable
//   3-column grid, per that section's own original comment). Reusing that
//   ALREADY-EXISTING pattern (now extracted as SystemDiagram.astro) rather
//   than the connector-line version, which just said the same thing with
//   a fussier tool — HubDiagram.astro was removed.
//
// Hero gets the darker bg-paper-dim band + empty second column, same
// reasoning as every other service page.
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PageHeading from "../../components/PageHeading.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CadenceSteps from "../../components/CadenceSteps.astro";
import SystemDiagram from "../../components/SystemDiagram.astro";

const base = import.meta.env.BASE_URL;

// --- Section 1: Where AI actually helps ---
// 3 left / 3 right, hub alone in the middle — matches Andrew's actual
// mockup for this page (a plain 3+3 split, not the 2+2+top/bottom split
// SystemDiagram was first wired up with here — see SystemDiagram.astro's
// comment on why topCard/bottomCard are optional).
const hubIcon = '<circle cx="12" cy="5" r="1.8"/><circle cx="6" cy="12" r="1.8"/><circle cx="18" cy="12" r="1.8"/><circle cx="9" cy="19" r="1.8"/><circle cx="15" cy="19" r="1.8"/><path d="M12 6.8L7.2 10.6M12 6.8l4.8 3.8M7.2 13.4L9 17.4M16.8 13.4L15 17.4" stroke-linecap="round"/>';
const helpLeft = [
  { sub: "Research & insights" },
  { sub: "Ideation & strategy" },
  { sub: "Content drafting" },
];
const helpRight = [
  { sub: "Repurposing at scale" },
  { sub: "Reporting & analysis" },
  { sub: "Admin & operations" },
];
const helpIcons: Record<string, string> = {
  "Research & insights": '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5" stroke-linecap="round"/>',
  "Ideation & strategy": '<path d="M12 3a6 6 0 0 0-3 11.2c.6.4 1 1.1 1 1.8h4c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"/><path d="M9 18h6M10 21h4"/>',
  "Content drafting": '<path d="M17 3.5a2.1 2.1 0 0 1 3 3L8.5 18 4 19l1-4.5L17 3.5z" stroke-linejoin="round"/>',
  "Repurposing at scale": '<path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 17v-4.5H7.5"/>',
  "Reporting & analysis": '<path d="M4 19h16" stroke-linecap="round"/><path d="M7 19v-6M12 19V8M17 19v-9" stroke-linecap="round"/>',
  "Admin & operations": '<circle cx="12" cy="12" r="3"/><path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18 6l-1.5 1.5M7.5 16.5L6 18M18 18l-1.5-1.5M7.5 7.5L6 6"/>',
};
const withIcon = (c: { sub: string }) => ({ ...c, icon: helpIcons[c.sub] });

// --- Section 2: A practical enablement system your team can use every day ---
const systemItems = [
  { num: "01", title: "Use cases", text: "Identify high-impact, low-risk opportunities aligned to your goals and team capacity.", icon: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>' },
  { num: "02", title: "Workflows", text: "Map and design clear workflows that show when, how, and by whom AI is used.", icon: '<rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="4" width="7" height="7" rx="1"/><rect x="3" y="15" width="7" height="7" rx="1"/><rect x="14" y="15" width="7" height="7" rx="1"/>' },
  { num: "03", title: "Prompts & standards", text: "Create reusable prompts, templates, and brand guidelines for consistent output.", icon: '<path d="M4 5h16v10H9l-4 4v-4H4z" stroke-linejoin="round"/>' },
  { num: "04", title: "Training & adoption", text: "Run practical training that builds confidence and real-world skills.", icon: '<path d="M2 8l10-4 10 4-10 4-10-4z" stroke-linejoin="round"/><path d="M6 10v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>' },
  { num: "05", title: "Governance & guardrails", text: "Set policies, approvals, and quality checks to manage risk and protect your brand.", icon: '<path d="M12 3l8 4v5c0 5-3.4 8.4-8 9.5-4.6-1.1-8-4.5-8-9.5V7l8-4z" stroke-linejoin="round"/>' },
  { num: "06", title: "Ongoing refinement", text: "Measure results, gather feedback, and continuously improve how you work.", icon: '<path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 17v-4.5H7.5"/>' },
];

// --- Section 3: How enablement typically works ---
const processSteps = [
  { num: "01", title: "Assess", text: "Understand your current state, goals, tools, and team readiness.", icon: '<circle cx="12" cy="12" r="9"/><path d="M12 3a6 6 0 0 0 0 18c1.4 0 2-.8 2-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H16a5 5 0 0 0 5-5 8 8 0 0 0-9-7z"/>' },
  { num: "02", title: "Prioritise", text: "Identify the best use cases and quick wins to start with confidence.", icon: '<path d="M4 7h16M4 12h10M4 17h6" stroke-linecap="round"/>' },
  { num: "03", title: "Pilot", text: "Build and test real workflows with your team in short cycles.", icon: '<path d="M3 11l17-7-6 17-3-7-8-3z" stroke-linejoin="round"/>' },
  { num: "04", title: "Train", text: "Equip your team with practical skills, resources, and playbooks.", icon: '<circle cx="9" cy="8" r="3"/><path d="M2.5 19c0-3 2.9-5.3 6.5-5.3s6.5 2.3 6.5 5.3"/><path d="M16 8.3a2.6 2.6 0 1 1 0-5.1"/><path d="M15 13.8c2.9.5 5 2.5 5 5.2"/>' },
  { num: "05", title: "Embed", text: "Roll out across the team with support, feedback loops, and champions.", icon: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9" stroke-linecap="round" stroke-linejoin="round"/>' },
  { num: "06", title: "Review", text: "Track impact, refine processes, and scale what works.", icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M7 19v-6M12 19V8M17 19v-9" stroke-linecap="round"/>' },
];

// --- Section 4: From manual and messy to clear and assisted ---
const beforeSteps = [
  { title: "Brief created", text: "(Email / Chat)" },
  { title: "Research", text: "Multiple tabs, docs, links" },
  { title: "Draft content", text: "Manual writing and edits" },
  { title: "Feedback", text: "Long email threads" },
  { title: "Repurpose", text: "Start from scratch again" },
  { title: "Finalise & publish", text: "Last-minute changes" },
];
const beforeTags = ["Time-consuming", "Inconsistent", "Hard to scale", "Hard to track"];

const afterSteps = [
  { title: "Brief & plan", text: "Clear goals and success metrics", icon: '<path d="M4 5h16v10H9l-4 4v-4H4z" stroke-linejoin="round"/>' },
  { title: "Research & insights", text: "AI-accelerated research", icon: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5" stroke-linecap="round"/>' },
  { title: "Draft with AI", text: "Quality first drafts and outlines", icon: '<path d="M17 3.5a2.1 2.1 0 0 1 3 3L8.5 18 4 19l1-4.5L17 3.5z" stroke-linejoin="round"/>' },
  { title: "Review & refine", text: "Faster feedback and edits", icon: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9" stroke-linecap="round" stroke-linejoin="round"/>' },
  { title: "Repurpose at scale", text: "Multiple formats from one source", icon: '<path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 17v-4.5H7.5"/>' },
  { title: "Publish & measure", text: "Consistent output and insights", icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M7 19v-6M12 19V8M17 19v-9" stroke-linecap="round"/>' },
];
const afterTags = ["Faster", "Consistent", "Scalable", "Measurable"];

// --- Section 5: Who this helps most ---
const audiences = [
  {
    title: "Stretched marketing teams",
    text: "Do more with less and save time on the work that slows you down.",
    icon: '<circle cx="9" cy="8" r="3"/><path d="M2.5 19c0-3 2.9-5.3 6.5-5.3s6.5 2.3 6.5 5.3"/><path d="M16 8.3a2.6 2.6 0 1 1 0-5.1"/><path d="M15 13.8c2.9.5 5 2.5 5 5.2"/>',
  },
  {
    title: "Businesses ready to adopt AI practically",
    text: "Move beyond experimentation and build useful, repeatable capabilities.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 3a6 6 0 0 0 0 18c1.4 0 2-.8 2-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H16a5 5 0 0 0 5-5 8 8 0 0 0-9-7z"/>',
  },
  {
    title: "Organisations needing consistency and governance",
    text: "Maintain brand standards, reduce risk, and improve quality at scale.",
    icon: '<path d="M12 3l8 4v5c0 5-3.4 8.4-8 9.5-4.6-1.1-8-4.5-8-9.5V7l8-4z" stroke-linejoin="round"/><path d="M9 12.5l2 2 4-4.5" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
---
<Layout title="AI Enablement" description="AI enablement for marketing teams.">
  <div class="bg-[var(--color-paper-dim)]">
    <Header currentPage="/services/integrations-ai-processes" />

    <!-- Section 0: Hero -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-16 md:pb-20">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10 items-center">
        <div>
          <PageHeading as="h1" class="mb-6">AI enablement for marketing teams</PageHeading>
          <p class="text-lg text-[var(--color-slate)] mb-10">
            We help marketing teams identify where AI creates real value, design practical workflows, and adopt tools without unnecessary complexity.
          </p>
          <a
            href={`${base}/contact`}
            class="inline-flex items-center gap-4 rounded-2xl bg-[var(--color-paper)] border border-[var(--color-line)] px-8 py-5 text-lg text-[var(--color-ink)] hover:border-[var(--color-slate)] transition-colors"
          >
            <span
              class="w-9 h-9 rounded-full shrink-0 ring-2 ring-white"
              style="background: var(--gradient-orb); box-shadow: var(--shadow-orb);"
            ></span>
            Book a strategy call
          </a>
        </div>

        <!-- Deliberately empty — see frontmatter note. -->
        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </section>
  </div>

  <div class="bg-[var(--color-paper)]">
    <!-- Section 1: Where AI actually helps -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-16 md:pt-20 pb-16 md:pb-20">
      <div class="grid lg:grid-cols-[minmax(0,34%)_minmax(0,66%)] gap-10 items-start">
        <div>
          <Eyebrow class="mb-3">Where AI actually helps</Eyebrow>
          <h2 class="text-2xl md:text-3xl font-semibold text-[var(--color-ink)] mb-4">Smarter work across your marketing workflow</h2>
          <p class="text-[var(--color-slate)] max-w-sm">
            AI can support many parts of the marketing process. We focus on the areas that save time, lift quality, and free your team to focus on higher-impact work.
          </p>
        </div>
        <SystemDiagram
          hubText="AI enabled marketing"
          hubIcon={hubIcon}
          leftColumn={helpLeft.map(withIcon)}
          rightColumn={helpRight.map(withIcon)}
        />
      </div>
    </section>

    <!-- Section 2: A practical enablement system your team can use every day -->
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 pb-16 md:pb-20">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-paper-dim)] p-6 md:p-10">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-[minmax(0,34%)_minmax(0,66%)] gap-10 items-start">
          <div>
            <Eyebrow class="mb-3">What we help you put in place</Eyebrow>
            <h2 class="text-2xl md:text-3xl font-semibold text-[var(--color-ink)] mb-4">A practical enablement system your team can use every day</h2>
            <p class="text-[var(--color-slate)] max-w-sm">
              We don't just recommend tools. We build the system around them&mdash;so your team can work confidently and consistently.
            </p>
          </div>
          <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
            {systemItems.map((item) => (
              <div class="flex items-start gap-3">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white text-[var(--color-accent)] shrink-0 [box-shadow:var(--shadow-card)]">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                </span>
                <div>
                  <p class="text-xs font-bold text-[var(--color-accent)] mb-0.5">{item.num}</p>
                  <p class="font-semibold text-[var(--color-ink)] mb-1">{item.title}</p>
                  <p class="text-sm text-[var(--color-slate)] leading-relaxed">{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Section 3: How enablement typically works -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-20">
      <SectionHeading
        eyebrow="How enablement typically works"
        heading="A clear path from potential to performance"
      />
      <CadenceSteps
        steps={processSteps}
        gridClass="sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6"
        connectorBreakpoint="xl"
      />
    </section>

    <!-- Section 4: From manual and messy to clear and assisted -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-20">
      <SectionHeading
        eyebrow="From manual and messy to clear and assisted"
        heading="A simpler workflow that gets better results"
      />
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-[var(--radius-card)] border border-[rgba(138,90,82,0.2)] bg-[var(--color-bad-soft)] p-6 md:p-7">
          <p class="text-sm font-semibold text-[var(--color-bad)] mb-4">Before: manual and disconnected</p>
          <ul class="space-y-3 mb-5">
            {beforeSteps.map((step, i) => (
              <li class:list={["flex items-center justify-between gap-3 py-2.5", i < beforeSteps.length - 1 && "border-b border-[rgba(138,90,82,0.15)]"]}>
                <span class="text-sm font-medium text-[var(--color-ink)]">{step.title}</span>
                <span class="text-xs text-[var(--color-slate)] text-right">{step.text}</span>
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-2">
            {beforeTags.map((tag) => (
              <span class="text-xs font-medium text-[var(--color-bad)] bg-white/60 rounded-full px-3 py-1">{tag}</span>
            ))}
          </div>
        </div>

        <div class="rounded-[var(--radius-card)] border border-[rgba(47,143,78,0.2)] bg-[var(--color-good-soft)] p-6 md:p-7">
          <p class="text-sm font-semibold text-[var(--color-good)] mb-4">After: AI-assisted and streamlined</p>
          <ul class="space-y-3 mb-5">
            {afterSteps.map((step, i) => (
              <li class:list={["flex items-center gap-3 py-1.5", i < afterSteps.length - 1 && "border-b border-[rgba(47,143,78,0.15)] pb-3"]}>
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-white/70 text-[var(--color-good)] shrink-0">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-[var(--color-ink)]">{step.title}</span>
                  <span class="block text-xs text-[var(--color-slate)]">{step.text}</span>
                </span>
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-2">
            {afterTags.map((tag) => (
              <span class="text-xs font-medium text-[var(--color-good)] bg-white/60 rounded-full px-3 py-1">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Who this helps most -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <SectionHeading
        eyebrow="Who this helps most"
        heading="Built for marketing teams under pressure to do more"
      />
      <div class="grid sm:grid-cols-3 gap-5">
        {audiences.map((item) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6">
            <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-4">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </span>
            <p class="font-semibold text-[var(--color-ink)] mb-1.5">{item.title}</p>
            <p class="text-sm text-[var(--color-slate)] leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <CtaBand />
  <Footer />
</Layout>

---
// The shared page hero. What is LOCKED here, on purpose, so every page hero
// feels like the same site: the heading style (PageHeading), the intro text,
// the vertical rhythm, and the height (header + hero = 706px at 1440, via
// lg:min-h-[578px] centring). What is FREE per page: the column split, what
// sits on the art side, and any extras. Andrew's rule (2026-10-27): authentic
// per page, not squeezed into one layout.
//
// Slots
//   title    the h1 text
//   intro    the short paragraph under it
//   (default) anything after the intro, usually <OrbButton>
//   art      the art side. Optional; when absent the column stays as an empty
//            spacer so the text keeps its column width.
//   overlay  absolutely-positioned extras inside the section (Marketing
//            Support's still-life image)
//
// Props
//   currentPage   renders the tinted band + <Header> around the hero (HeroBand)
//   split         "balanced" 50/50 (default) | "art-lead" ~1/3 text, rest art
//                 (text column fixed at 384px so the heading keeps its wraps) |
//                 "text-lead" 3/5 text. No page uses text-lead yet.
//   from          breakpoint where it becomes two columns: "lg" (default) | "md"
//                 (the homepage). "md" supports "balanced" only.
//   artClass      classes for the art column wrapper. Default hides it below the
//                 breakpoint; pass your own to keep it visible when stacked.
//   sectionClass / gridClass / titleClass / introClass   per-page extras
import HeroBand from "./HeroBand.astro";
import PageHeading from "./PageHeading.astro";
interface Props {
  currentPage?: string;
  split?: "balanced" | "art-lead" | "text-lead";
  from?: "md" | "lg";
  artClass?: string;
  sectionClass?: string;
  gridClass?: string;
  titleClass?: string;
  introClass?: string;
}
const {
  currentPage,
  split = "balanced",
  from = "lg",
  artClass,
  sectionClass,
  gridClass,
  titleClass,
  introClass,
} = Astro.props as Props;

// Literal class strings (Tailwind only generates classes it can read as text).
const columns = {
  lg: {
    balanced: "lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10",
    "art-lead": "lg:grid-cols-[minmax(0,384px)_minmax(0,1fr)] gap-10 lg:gap-x-4",
    "text-lead": "lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-10",
  },
  md: {
    balanced: "md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10",
    "art-lead": "md:grid-cols-[minmax(0,384px)_minmax(0,1fr)] gap-10 md:gap-x-4",
    "text-lead": "md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-10",
  },
}[from][split];
const defaultArtClass = from === "md" ? "hidden md:block" : "hidden lg:block";
const hasArt = Astro.slots.has("art");
const hasExtras = Astro.slots.has("default");
---
<HeroBand currentPage={currentPage}>
  <section class:list={["max-w-7xl mx-auto px-6 md:px-10 py-20 md:py-28 lg:py-12 lg:min-h-[578px] lg:flex lg:items-center", sectionClass]}>
    <div class:list={["grid", columns, "items-center min-h-[339px] lg:min-h-[322px] lg:w-full", gridClass]}>
      <div>
        <PageHeading as="h1" class:list={["mb-6", titleClass]}><slot name="title" /></PageHeading>
        <p class:list={["t-intro", hasExtras && "mb-10", introClass]}><slot name="intro" /></p>
        <slot />
      </div>
      <div class={artClass ?? defaultArtClass} aria-hidden={hasArt ? undefined : "true"}>
        <slot name="art" />
      </div>
    </div>
    <slot name="overlay" />
  </section>
</HeroBand>

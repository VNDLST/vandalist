---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HelpGrid from "../components/HelpGrid.astro";
import CoverageTable from "../components/CoverageTable.astro";
import ProofGrid from "../components/ProofGrid.astro";
import HowWeWork from "../components/HowWeWork.astro";
import WhoThisIsFor from "../components/WhoThisIsFor.astro";
import LogoStrip from "../components/LogoStrip.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Marketing Strategy, Execution & Support">
  <!-- Hero: full-bleed camp-site background behind Header + hero (same
       pattern as how-we-work.astro). No overflow-hidden — the boosted
       campfire flame is meant to rise past its stage. The image is taller
       than the hero by half of HelpGrid's top padding (2rem of 4rem on
       mobile, 3rem of 6rem at md+), so the background's curves finish
       lower, clear of the hero text, while still leaving the first row a
       clear 50% of its own padding. Pure backdrop: it only ever overlaps
       that empty padding, never row-one content. -->
  <div class="relative">
    <img
      src={`${import.meta.env.BASE_URL}/home-hero-bg.svg`}
      alt=""
      class="absolute left-0 top-0 w-full h-[calc(100%+2rem)] md:h-[calc(100%+3rem)] object-cover object-bottom pointer-events-none"
      aria-hidden="true"
    />
    <div class="relative z-10">
      <Header />
      <Hero />
    </div>
  </div>
  <HelpGrid />
  <CoverageTable />
  <ProofGrid />
  <HowWeWork />
  <WhoThisIsFor />
  <LogoStrip />
  <CtaBand />
  <Footer />
</Layout>

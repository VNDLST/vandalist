---
// "Linked pairs": rows of two white cards joined by a pink link chip and thin pink
// lines, with a transparent icon on each card. First used for the SEO page's "How SEO
// and content work together" (Andrew's mock-up, 2026-11-02). The older
// SystemDiagram (hub circle in the middle) stays for about / AI Enablement /
// Websites.
//
// Layout: from lg each row is [card] [chip + lines] [card]; below lg each row
// stacks (card, chip on a short vertical line, card). Icons are transparent WebP
// files in public/<iconDir>/, named for what they show, shown plain at 77px (Andrew,
// 2026-11-02: his mock-up's pink blob and sparkle lines were both removed, and the
// icons reduced ~20% from 96px, so this row reads differently from the one above).
//
//   rows      [{ left: Card, right: Card }]    Card = { title, text, icon }  (icon = file name, no extension)
//   iconDir   folder under /public holding the icons, e.g. "seo-approach"
import IconChip from "./IconChip.astro";

interface Card { title: string; text: string; icon: string }
interface Props { rows: { left: Card; right: Card }[]; iconDir: string }
const { rows, iconDir } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const linkIcon = '<path d="M9 15l6-6"/><path d="M11 7l1-1a3.5 3.5 0 0 1 5 5l-1 1"/><path d="M13 17l-1 1a3.5 3.5 0 0 1-5-5l1-1"/>';
const cards = rows.flatMap((r, i) => [
  { ...r.left, key: `l${i}` },
  { ...r.right, key: `r${i}` },
]);
const find = (key: string) => cards.find((c) => c.key === key)!;
---
<div class="space-y-5 md:space-y-6">
  {rows.map((_, i) => (
    <div class="flex flex-col items-stretch lg:grid lg:grid-cols-[minmax(0,1fr)_88px_minmax(0,1fr)]">
      {["l", "r"].map((side, s) => {
        const c = find(`${side}${i}`);
        const card = (
          <div class="flex items-center gap-4 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 [box-shadow:var(--shadow-card)]">
            <img src={`${base}/${iconDir}/${c.icon}.webp`} alt="" class="h-[77px] w-[77px] shrink-0 object-contain" loading="lazy" />
            <div class="min-w-0">
              <p class="t-title mb-1">{c.title}</p>
              <p class="t-body">{c.text}</p>
            </div>
          </div>
        );
        return s === 0 ? (
          <>
            {card}
            <div class="relative flex h-14 items-center justify-center lg:h-auto">
              <span class="absolute inset-y-0 left-1/2 w-px bg-[var(--color-accent-line-soft)] lg:inset-y-auto lg:inset-x-0 lg:left-auto lg:top-1/2 lg:h-px lg:w-auto" aria-hidden="true"></span>
              <IconChip icon={linkIcon} size="lg" class="relative" />
            </div>
          </>
        ) : (
          card
        );
      })}
    </div>
  ))}
</div>

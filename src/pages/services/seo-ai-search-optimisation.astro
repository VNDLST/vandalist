---
// Third of the 5 planned service pages to be built from a supplied
// mockup. Nav, CtaBand and Footer are the site's shared chrome and
// untouched here.
//
// Per Andrew: the mockup had a white background strip behind "Search
// visibility now happens in more places" (Section 1) — ignored, that
// section just uses the standard page background like everywhere else,
// not a new one-off white band. "How SEO and content work together"
// (Section 2) explicitly DOES get the darker bg-paper-dim band, per
// Andrew's direct instruction — same treatment as every hero on the site,
// just used mid-page here instead.
//
// "How SEO and content work together" is three linked pairs of cards (LinkedPairs.astro,
// from Andrew's 2026-11-02 mock-up). It used to be a hub-and-spoke diagram, then a
// SystemDiagram (still used by about / AI Enablement / Websites).
//
// Hero gets the darker bg-paper-dim band + empty second column, same as
// every other service page.
import Layout from "../../layouts/Layout.astro";
import Band from "../../components/Band.astro";
import Section from "../../components/Section.astro";
import IconChip from "../../components/IconChip.astro";
import PageHero from "../../components/PageHero.astro";
import OrbButton from "../../components/OrbButton.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CadenceSteps from "../../components/CadenceSteps.astro";
import LinkedPairs from "../../components/LinkedPairs.astro";
import HeroRocket from "../../components/HeroRocket.astro";
import HeroClouds from "../../components/HeroClouds.astro";
import AskingPerson from "../../components/AskingPerson.astro";

const base = import.meta.env.BASE_URL;

// --- Section 1: The new search landscape ---
// Four cards (layout + copy + illustrations supplied by Andrew, 2026-11-02; images in public/search-landscape/).
const landscapeCards = [
  { title: "Beyond Google", text: "People are finding answers through AI tools, social platforms and video, not just traditional search results.", icon: "beyond-google" },
  { title: "Different search behaviour", text: "Users ask longer, more conversational questions and expect quick, useful answers across multiple platforms.", icon: "search-behaviour" },
  { title: "Content works harder", text: "Well-structured, helpful content can appear in Google results, AI overviews, video platforms and more.", icon: "content-works-harder" },
  { title: "Opportunities are bigger", text: "When your content is optimised for search and AI, you can reach more of the right people across more channels.", icon: "bigger-opportunities" },
];

// --- Section 2: How SEO and content work together ---
// Three linked pairs (Andrew's mock-up, 2026-11-02). Icons: public/seo-approach/.
const approachRows = [
  {
    left: { title: "Topic planning", text: "Build a focused plan around priority topics and intent.", icon: "topic-planning" },
    right: { title: "Audience questions", text: "Understand what your audience is searching for and why.", icon: "audience-questions" },
  },
  {
    left: { title: "Technical structure", text: "Ensure your site is fast, crawlable and easy to understand.", icon: "technical-structure" },
    right: { title: "Pages & articles", text: "Create and optimise content that answers and converts.", icon: "pages-and-articles" },
  },
  {
    left: { title: "Measurement & refinement", text: "Track visibility, learn what works and refine over time.", icon: "measurement-and-refinement" },
    right: { title: "Internal linking", text: "Connect related content to share authority and context.", icon: "internal-linking" },
  },
];

// --- Section 3: What we work on ---
// Four numbered areas, each with a summary and a checklist (Andrew's mock-up, 2026-11-02).
const workAreas = [
  {
    num: "01",
    title: "Strategy & opportunities",
    text: "Research, priorities and a clear direction for growth.",
    items: ["SEO audits & opportunity mapping", "Keyword & intent research", "Competitor analysis & prioritisation", "Roadmaps aligned to business goals"],
  },
  {
    num: "02",
    title: "Content creation & optimisation",
    text: "Useful content that answers questions and builds authority.",
    items: ["Topic clusters & content plans", "Landing pages & service pages", "Blog content & thought leadership", "Optimisation for AI summaries"],
  },
  {
    num: "03",
    title: "Technical & on-page clarity",
    text: "A stronger technical foundation for search engines and users.",
    items: ["Technical SEO foundations", "Site structure & internal linking", "Page speed & Core Web Vitals", "Schema & implementation notes"],
  },
  {
    num: "04",
    title: "Measurement & growth",
    text: "Performance tracking, refinement and ongoing improvement.",
    items: ["Rank tracking & visibility reporting", "AI overview & snippet tracking", "Conversion insights & reporting", "Ongoing refinement & iteration"],
  },
];

// --- Section 4: Momentum builds over time ---
// Six steps (Andrew, 2026-11-09: dropped "Improve key pages", retitled to one word each).
// Icons are his single-colour SVGs in public/seo-journey-icons/ (recoloured by CadenceSteps).
const journeySteps = [
  { num: "01", title: "Audit", text: "Uncover opportunities and technical issues holding you back.", icon: "audit" },
  { num: "02", title: "Prioritise", text: "Focus on high-impact topics and pages that move the needle.", icon: "prioritise" },
  { num: "03", title: "Content", text: "Build in-depth content that answers real questions.", icon: "content" },
  { num: "04", title: "Technical", text: "Review and refine site performance from a user's perspective.", icon: "technical" },
  { num: "05", title: "Measure", text: "Track rankings, AI visibility, search trends, and traffic that matters.", icon: "measure" },
  { num: "06", title: "Refine", text: "Double down on what works and continuously improve.", icon: "refine" },
];

// --- Section 5: Where this works well ---
// Three cards, each with a row of four plain pink icons (Andrew, 2026-11-09; his SVGs in
// public/seo-audiences/). The first icon of each card was specified by him; the rest are
// grouped by theme and their order is free.
const audiences = [
  {
    title: "Trade Services",
    text: "Generate more qualified enquiries and be found by people ready to buy.",
    icons: ["manufacturing", "powertools", "electrical", "plumber"],
  },
  {
    title: "Professional Services",
    text: "Turn expertise into discoverable content and reach more of the right audience.",
    icons: ["documentation", "legal", "accounting", "infotech"],
  },
  {
    title: "Existing Websites",
    text: "Increase authority, improve rankings and win more visibility in competitive markets.",
    icons: ["website", "ecom", "coding", "analytics"],
  },
];

// --- Section 6: The impact (Andrew's mock-up, 2026-11-09) ---
// Illustrative report card: every number below is made up for the picture and the card
// says so ("Illustrative performance snapshot").
const kpis = [
  { label: "Organic sessions", value: "12,842", change: "+48%" },
  { label: "Qualified enquiries", value: "356", change: "+62%" },
  { label: "AI visibility", value: "38%", change: "+29%" },
  { label: "Top 3 rankings", value: "215", change: "+41%" },
];
const topQueries = [
  { query: "commercial fitout sydney", pct: 82 },
  { query: "office renovation cost", pct: 66 },
  { query: "workplace design trends", pct: 46 },
];
const topPages = [
  { page: "/services/office-fitouts", views: "3,421" },
  { page: "/blog/workplace-trends-2024", views: "2,108" },
  { page: "/services/office-renovations", views: "1,997" },
  { page: "/about/our-approach", views: "1,654" },
  { page: "/previous-work/fit-tech-office", views: "1,203" },
];
const calendarIcon = '<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/>';
---
<Layout title="SEO & AI Search Optimisation" description="Search results and AI snippets that help the right people find you.">
  <PageHero currentPage="/services/seo-ai-search-optimisation" sectionClass="relative">
    <Fragment slot="title">Search results and AI snippets that help the right people find you</Fragment>
    <Fragment slot="intro">We improve your visibility through search intent, useful content, structure and steady optimisation&mdash;so your business is found in traditional search results and emerging AI-driven answer surfaces.</Fragment>
    <OrbButton href={`${base}/contact`}>Book a strategy call</OrbButton>
    <HeroRocket slot="art" />
    <HeroClouds slot="overlay" />
  </PageHero>

  <div class="bg-[var(--color-paper)]">
    <!-- Section 1: The new search landscape (no special background — see
         frontmatter note re: the mockup's white strip). -->
    <Section top>
      <SectionHeading
        eyebrow="The new search landscape"
        heading="Search visibility now happens in more places"
        subtext="Audiences are searching across all manner of resources - Google, AI tools, social media and more. We help businesses get found in the right places."
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {landscapeCards.map((card) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]">
            <img src={`${base}/search-landscape/${card.icon}.webp`} alt="" class="h-24 w-auto mb-4" loading="lazy" />
            <p class="t-title mb-2">{card.title}</p>
            <p class="t-body">{card.text}</p>
          </div>
        ))}
      </div>
    </Section>
  </div>

  <!-- Section 2: How SEO and content work together — darker bg-paper-dim
       band, per Andrew's explicit instruction. -->
  <Band>
    <div class="max-w-7xl mx-auto grid xl:grid-cols-[minmax(0,30%)_minmax(0,70%)] gap-10 items-center">
      <div>
        <Eyebrow class="mb-3">Our approach</Eyebrow>
        <h2 class="t-heading text-balance mb-4">How SEO and content work together</h2>
        <p class="t-body max-w-xl xl:max-w-sm">
          We connect strategy, content and technical foundations into a cohesive system that builds topical depth, earns trust and improves visibility across search and AI experiences.
        </p>
      </div>
      <LinkedPairs rows={approachRows} iconDir="seo-approach" />
    </div>
  </Band>

  <div class="bg-[var(--color-paper)]">
    <!-- Section 3: What we work on -->
    <Section top>
      <div class="grid xl:grid-cols-[minmax(0,30%)_minmax(0,70%)] gap-10 xl:gap-12">
        <div>
          <Eyebrow class="mb-3">What we work on</Eyebrow>
          <h2 class="t-heading text-balance mb-6">A complete visibility system</h2>
          <p class="t-intro max-w-md">Four connected areas. One coordinated approach to improving your visibility.</p>
        </div>
        <div class="divide-y divide-[var(--color-line)]">
          {workAreas.map((area) => (
            <div class="grid md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] gap-5 md:gap-0 py-8 first:pt-0 last:pb-0">
              <div class="md:pr-8">
                <p class="t-eyebrow mb-1">{area.num}</p>
                <p class="t-subheading mb-2">{area.title}</p>
                <p class="t-body">{area.text}</p>
              </div>
              <ul class="space-y-2 md:border-l md:border-[var(--color-accent-line-soft)] md:pl-8">
                {area.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" class="mt-1 shrink-0" aria-hidden="true">
                      <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="t-body">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <!-- Section 4: Momentum builds over time -->
    <Section>
      <SectionHeading
        eyebrow="The journey"
        heading="Momentum builds over time"
        subtext="Great SEO isn't a one-off. We follow a proven rhythm that creates compounding visibility and sustainable growth."
      />
      <CadenceSteps
        steps={journeySteps}
        gridClass="sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6"
        connectorBreakpoint="xl"
        iconMode="image"
        iconBase={`${base}/seo-journey-icons`}
      />
    </Section>

    <!-- Section 5: Where this works well -->
    <Section>
      <SectionHeading
        eyebrow="Best suited for"
        heading="Where this works well"
      />
      <div class="grid lg:grid-cols-3 gap-5">
        {audiences.map((item) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6">
            <div class="mb-5" aria-hidden="true">
              <div class="inline-flex flex-wrap gap-3 xl:gap-4 rounded-xl bg-[var(--color-paper-dim)] px-4 xl:px-5 py-3.5">
                {item.icons.map((name) => (
                  <img src={`${base}/seo-audiences/${name}.svg`} alt="" class="h-10 w-10 xl:h-12 xl:w-12 object-contain" loading="lazy" />
                ))}
              </div>
            </div>
            <p class="t-title mb-1.5">{item.title}</p>
            <p class="t-small">{item.text}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- Section 6: The impact. Left: heading, intro, button and the "asking person" scene
         (the question the report answers). Right: an illustrative report card. -->
    <Section>
      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-10 xl:gap-12">
        <div class="flex flex-col">
          <Eyebrow class="mb-3">The impact</Eyebrow>
          <h2 class="t-heading text-balance mb-4">Know what's working, and what isn't</h2>
          <p class="t-body mb-6 max-w-md">
            Our reporting provides a clear, objective view of your visibility, the results being achieved and the opportunities ahead - so you can see what's working and where to focus next.
          </p>
          <a
            href={`${base}/previous-work`}
            class="group inline-flex items-center gap-3 rounded-[var(--radius-pill)] bg-white border border-[var(--color-line)] pl-2.5 pr-5 py-2.5 [box-shadow:var(--shadow-card)] transition-all hover:[box-shadow:var(--shadow-panel)] hover:-translate-y-0.5"
          >
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 18V6M4 18h16" stroke-linecap="round"/><path d="M7 14l4-4 3 3 5-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="t-small-strong">See previous work</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" class="transition-transform group-hover:translate-x-1">
              <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <!-- From lg the scene drops to the bottom of the column and past the section's bottom
               padding (lg:-mb-20), so the person's cut-off shoulders sit exactly on the top edge of the
               call-to-action band, as if rising from behind it. Below lg the card comes after it. -->
          <div class="mt-10 lg:mt-auto lg:pt-10 lg:-mb-20"><AskingPerson /></div>
        </div>

        <!-- Illustrative report card: made-up numbers, labelled as such, hidden from screen readers. -->
        <div class="lg:self-start rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 md:p-8 [box-shadow:var(--shadow-panel)]" aria-hidden="true">
          <div class="flex items-start justify-between gap-4 mb-6">
            <div>
              <p class="t-subheading mb-1">Search visibility report</p>
              <p class="t-small">Illustrative performance snapshot</p>
            </div>
            <span class="inline-flex shrink-0 items-center gap-2 rounded-full bg-[var(--color-paper-dim)] px-4 py-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-slate)]" set:html={calendarIcon} />
              <span class="t-small-strong">Monthly</span>
            </span>
          </div>

          <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 md:gap-4 mb-5">
            {kpis.map((k) => (
              <div class="rounded-lg bg-[var(--color-paper-dim)] p-4">
                <p class="t-small mb-1">{k.label}</p>
                <p class="t-subheading mb-1">{k.value}</p>
                <p class="t-small-strong text-[var(--color-good)]">&uarr; {k.change}</p>
              </div>
            ))}
          </div>

          <div class="grid xl:grid-cols-2 gap-4 md:gap-5 mb-5">
            <div class="rounded-xl border border-[var(--color-line)] p-5">
              <p class="t-title mb-4">Top queries driving visibility</p>
              <div class="space-y-4">
                {topQueries.map((q) => (
                  <div>
                    <p class="t-small text-[var(--color-ink)] mb-1.5">{q.query}</p>
                    <div class="flex items-center gap-4">
                      <div class="h-2 flex-1 rounded-full bg-[var(--color-paper-dim)]">
                        <div class="h-2 rounded-full bg-[var(--color-accent)]" style={`width: ${q.pct}%`}></div>
                      </div>
                      <span class="t-small-strong w-10 text-right">{q.pct}%</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="rounded-xl border border-[var(--color-line)] p-5">
              <p class="t-title mb-3">Top-performing pages</p>
              <div class="divide-y divide-[var(--color-line)]">
                {topPages.map((row) => (
                  <div class="flex items-center justify-between gap-3 py-2 first:pt-0 last:pb-0">
                    <span class="t-small text-[var(--color-ink)] truncate">{row.page}</span>
                    <span class="t-small-strong shrink-0">{row.views}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="flex items-center gap-5 rounded-xl bg-[var(--color-accent-soft)] p-5 md:p-6">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 hidden sm:block">
              <path d="M12 0.8v1.4M5 3.8l1 1M19 3.8l-1 1" />
              <path d="M12 4.5a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 4.5z" />
              <path d="M9.5 20h5M10.5 22.5h3" />
            </svg>
            <span class="hidden sm:block self-stretch w-px bg-[var(--color-accent-line-soft)]"></span>
            <div>
              <p class="t-title mb-1">What the results tell us</p>
              <p class="t-small">Visibility is improving across priority searches, and service pages are attracting stronger engagement. This helps guide where to focus next for continued growth.</p>
            </div>
          </div>
        </div>
      </div>
    </Section>
  </div>

  <CtaBand />
  <Footer />
</Layout>

---
// "Hub and spoke" diagram: a center circle with up to 6 related items
// flanking it (3 left, 3 right), connected by dotted lines. Extracted as a
// shared component because it showed up on two different supplied mockups
// (AI Enablement's "Where AI actually helps" and the SEO & AI Search
// Optimisation page's "How SEO and content work together") — same
// reasoning CadenceSteps was extracted for: a second page needing the same
// pattern, so it should be one component, not two hand-rolled versions
// drifting apart.
//
// The connector lines are approximate, not pixel-measured — same
// philosophy as CadenceSteps' own connector math (see that component's
// comment): assumes 3 evenly-spaced stacked cards per side, and relies on
// the opaque white cards occluding most of each line's length so it reads
// as "connecting" without needing to land on an exact point. Good enough
// for a decorative connector; not worth a JS-measured version for this.
interface Spoke {
  title: string;
  text?: string;
  icon: string;
}
interface Props {
  hubTitle: string;
  hubIcon: string;
  spokes: Spoke[]; // exactly 6 — first 3 render left, last 3 render right
}
const { hubTitle, hubIcon, spokes } = Astro.props as Props;
const left = spokes.slice(0, 3);
const right = spokes.slice(3, 6);
---
<div class="relative">
  <svg class="absolute inset-0 w-full h-full hidden lg:block" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <line x1="26" y1="16.6" x2="50" y2="50" stroke="var(--color-accent)" stroke-width="0.35" stroke-dasharray="1.2 1.6" opacity="0.45" />
    <line x1="26" y1="50" x2="50" y2="50" stroke="var(--color-accent)" stroke-width="0.35" stroke-dasharray="1.2 1.6" opacity="0.45" />
    <line x1="26" y1="83.4" x2="50" y2="50" stroke="var(--color-accent)" stroke-width="0.35" stroke-dasharray="1.2 1.6" opacity="0.45" />
    <line x1="74" y1="16.6" x2="50" y2="50" stroke="var(--color-accent)" stroke-width="0.35" stroke-dasharray="1.2 1.6" opacity="0.45" />
    <line x1="74" y1="50" x2="50" y2="50" stroke="var(--color-accent)" stroke-width="0.35" stroke-dasharray="1.2 1.6" opacity="0.45" />
    <line x1="74" y1="83.4" x2="50" y2="50" stroke="var(--color-accent)" stroke-width="0.35" stroke-dasharray="1.2 1.6" opacity="0.45" />
  </svg>

  <div class="grid lg:grid-cols-[1fr_auto_1fr] gap-x-8 gap-y-4 items-center relative z-10">
    <div class="flex flex-col gap-4">
      {left.map((spoke) => (
        <div class="rounded-xl border border-[var(--color-line)] bg-white p-4 flex items-start gap-3 [box-shadow:var(--shadow-card)]">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={spoke.icon} />
          </span>
          <div>
            <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{spoke.title}</p>
            {spoke.text && <p class="text-xs text-[var(--color-slate)] leading-relaxed">{spoke.text}</p>}
          </div>
        </div>
      ))}
    </div>

    <div class="justify-self-center my-4 lg:my-0 w-44 h-44 rounded-full bg-white border-2 border-[var(--color-accent)] flex flex-col items-center justify-center text-center px-5 [box-shadow:var(--shadow-panel)]">
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={hubIcon} />
      </span>
      <p class="font-semibold text-[var(--color-ink)] text-sm leading-snug">{hubTitle}</p>
    </div>

    <div class="flex flex-col gap-4">
      {right.map((spoke) => (
        <div class="rounded-xl border border-[var(--color-line)] bg-white p-4 flex items-start gap-3 [box-shadow:var(--shadow-card)]">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={spoke.icon} />
          </span>
          <div>
            <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{spoke.title}</p>
            {spoke.text && <p class="text-xs text-[var(--color-slate)] leading-relaxed">{spoke.text}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

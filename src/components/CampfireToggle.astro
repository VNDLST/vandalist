---
// Campfire toggle concept for the "How We Work" page.
//
// Toggle mechanic adapted from "CSSspark" by Ivan Grozdic (MIT licensed):
// https://codepen.io/ig_design/pen/NeRxzj — simplified (scene chrome
// removed, since this needs to sit on the site's light background) and
// rebuilt as a proper toggle switch.
//
// v3 feedback (Andrew): keep the calm/small state exactly as-is (an "egg
// shape... under control"). On boost, don't shift toward pink — it read as
// looking chemical, not fiery — keep it in warm amber/orange tones instead.
//
// v5 feedback: skip subtle hints entirely — on boost, cross-fade straight
// into the actual flame structure from "Campfire -- Codevember #15" by
// Rose Liu (https://codepen.io/Rosefae/pen/oQBRXe, MIT licensed): 3 outer
// + 3 inner lopsided blobs (border-radius rounds two opposite corners hard,
// leaves the other two square), each pivoting from the same bottom-right
// corner, one rotated 30deg, one mirrored — recoloured to warm amber/red
// (the original uses flat rgba fills that build up depth through overlap,
// not gradients, so kept that approach here too) and rescaled to fit this
// component's own box instead of that pen's 80rem viewport-relative stage.
//
// v5.1: the direct port "goes a bit spaz" (Andrew) — the reference's hard
// 0%/huge-radius corner pair plus its fast, wide-swinging wave/flicker/size
// keyframes read as sharp and twitchy at this small scale, rather than a
// calm flicker. Softened the corners (18%/82% instead of 0/huge), reduced
// the boosted size and the wave/size oscillation ranges, slowed every wild-
// flame animation duration, and pulled the rotated copy in from 30deg to
// 16deg so the three layers overlap more than they splay apart.
---
<div class="campfire-demo" data-campfire-root>
  <div class="campfire-stage">
    <div class="campfire-glow" aria-hidden="true"></div>
    <div class="campfire-embers" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="campfire-logs" aria-hidden="true"></div>

    <!-- Calm flame: visible at rest, fades out on boost -->
    <div class="campfire-fire campfire-fire-calm" aria-hidden="true">
      <div class="flame-outer"></div>
      <div class="flame-inner"></div>
    </div>

    <!-- Wild flame: hidden at rest, fades in and becomes the visible one on
         boost. Structure matches the reference pen: two nested wrapper
         levels per tongue so the static rotation (on the wrapper) and the
         animated wave (on the .wild-flame itself) don't fight over the
         same transform. -->
    <div class="campfire-fire campfire-fire-wild" aria-hidden="true">
      <div class="wild-flames">
        <div class="wild-one"><div class="wild-flame"></div></div>
        <div class="wild-two"><div class="wild-flame"></div></div>
        <div class="wild-three"><div class="wild-flame"></div></div>
      </div>
      <div class="wild-flames wild-flames-inner">
        <div class="wild-one"><div class="wild-flame"></div></div>
        <div class="wild-two"><div class="wild-flame"></div></div>
        <div class="wild-three"><div class="wild-flame"></div></div>
      </div>
    </div>
  </div>

  <div class="campfire-control">
    <span class="campfire-control-label">Add a little Vandalist</span>
    <button
      type="button"
      class="campfire-switch"
      role="switch"
      aria-checked="false"
      aria-label="Increase flame intensity"
      data-campfire-switch
    >
      <span class="campfire-knob"></span>
    </button>
  </div>
</div>

<style>
  .campfire-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  /* No background/border here on purpose — this sits directly on whatever
     the page behind it is, so we can judge it against the real site bg.
     Sized as a rough approximation of an in-page footprint, not a big
     standalone hero demo — exact final size depends on where this lands. */
  .campfire-stage {
    position: relative;
    width: 100%;
    max-width: 300px;
    height: 220px;
    margin: 0 auto;
  }

  /* Soft warm pool of light at the base — subtle on purpose; a hazy radial
     glow that read fine over black turns into a muddy smudge over white. */
  .campfire-glow {
    position: absolute;
    left: 50%;
    bottom: 48px;
    width: 65%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 157, 31, 0.22), rgba(255, 157, 31, 0) 70%);
    filter: blur(8px);
    transition: transform 900ms cubic-bezier(0.4, 0, 0.2, 1), background 900ms ease;
  }
  .is-boosted .campfire-glow {
    transform: translateX(-50%) scale(1.35);
    background: radial-gradient(circle, rgba(255, 122, 26, 0.32), rgba(255, 122, 26, 0) 70%);
  }

  /* Simple crossed logs, no external image asset */
  .campfire-logs {
    position: absolute;
    left: 50%;
    bottom: 58px;
    width: 80px;
    height: 12px;
    transform: translateX(-50%);
  }
  .campfire-logs::before,
  .campfire-logs::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 12px;
    border-radius: 6px;
    background: linear-gradient(#4a3a2e, #2e2319);
  }
  .campfire-logs::before {
    transform: rotate(-7deg);
  }
  .campfire-logs::after {
    transform: rotate(7deg);
  }

  /* Both flame states occupy the same box, cross-fading via opacity. Sizing
     transitions on boost (shared by both), wave/flicker animation differs
     per state (set below on each). */
  .campfire-fire {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 63px;
    width: 50px;
    height: 76px;
    margin-left: -25px;
    transform-origin: 50% 100%;
    transition:
      width 900ms cubic-bezier(0.4, 0, 0.2, 1),
      height 900ms cubic-bezier(0.4, 0, 0.2, 1),
      margin-left 900ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 500ms ease;
  }
  .is-boosted .campfire-fire {
    width: 64px;
    height: 96px;
    margin-left: -32px;
  }

  .campfire-fire-calm {
    opacity: 1;
    animation: campfire-sway 3.2s ease-in-out infinite;
  }
  .is-boosted .campfire-fire-calm {
    opacity: 0;
  }

  .campfire-fire-wild {
    opacity: 0;
    animation: campfire-sway-wild 2s ease-in-out infinite;
  }
  .is-boosted .campfire-fire-wild {
    opacity: 1;
  }

  .flame-outer {
    position: absolute;
    inset: 0;
    border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    background: linear-gradient(180deg, #ffd23f 0%, #ff9d1f 45%, #f4560f 100%);
    filter: drop-shadow(0 10px 16px rgba(244, 86, 15, 0.32));
    animation: campfire-flicker-shape 2.4s ease-in-out infinite alternate;
  }

  .flame-inner {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 56%;
    height: 62%;
    margin-left: -28%;
    border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    background: linear-gradient(180deg, #fff6da 0%, #ffd23f 55%, #ff9d1f 100%);
    animation: campfire-shimmer 2.1s ease-in-out infinite;
  }

  /* Wild flame — same shape technique as the reference pen: each "flame" is
     a box with two opposite corners rounded almost to a full circle and the
     other two much less rounded (not perfectly square — a hard 0/huge-radius
     mix read as sharp/jagged at this small size, softened here), anchored at
     the bottom-right so it reads as a tongue leaning up-left. Three of these
     per layer (upright, rotated slightly, mirrored) pivoting from the same
     corner overlap into one silhouette instead of three separate flames.
     Flat semi-transparent fills (not gradients) so overlaps build up their
     own depth, same as the reference. Timing/amplitude slowed and narrowed
     from the reference's own values — its fast, wide-swinging original read
     as twitchy/chaotic at this scale rather than a calm flicker. */
  .wild-flames {
    position: absolute;
    inset: 0;
  }
  .wild-one,
  .wild-two,
  .wild-three {
    position: absolute;
    inset: 0;
  }
  .wild-two {
    transform: rotate(16deg);
  }
  .wild-three {
    transform: scaleX(-1);
  }
  .wild-flame {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 78%;
    height: 100%;
    background: rgba(244, 86, 15, 0.5);
    border-radius: 18% 82% 18% 82% / 18% 82% 18% 82%;
    transform-origin: 100% 100%;
    animation:
      wild-wave 1.8s ease-in-out infinite alternate,
      wild-flicker 0.6s ease-in-out infinite alternate,
      wild-size 0.9s ease infinite alternate;
  }
  .wild-one .wild-flame {
    animation-delay: -0.2s;
  }
  .wild-two .wild-flame {
    animation-delay: -0.6s;
  }
  .wild-three .wild-flame {
    animation-delay: -1.1s;
  }
  .wild-flames-inner .wild-flame {
    width: 46%;
    height: 54%;
    background: rgba(255, 210, 63, 0.4);
    animation-name: wild-wave, wild-flicker, wild-size-inner;
    animation-duration: 1.4s, 0.45s, 0.6s;
  }

  @keyframes campfire-flicker-shape {
    0%,
    100% {
      transform: scale(1, 1);
      border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    }
    50% {
      transform: scale(0.94, 1.04);
      border-radius: 48% 52% 46% 54% / 60% 65% 35% 40%;
    }
  }
  @keyframes campfire-shimmer {
    0%,
    100% {
      opacity: 0.92;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.05);
    }
  }
  @keyframes campfire-sway {
    0%,
    100% {
      transform: rotate(-1.5deg);
    }
    50% {
      transform: rotate(1.5deg);
    }
  }
  @keyframes campfire-sway-wild {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }
  @keyframes wild-wave {
    from {
      transform: rotate(-2.5deg);
    }
    to {
      transform: rotate(2.5deg);
    }
  }
  @keyframes wild-flicker {
    from {
      opacity: 0.85;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes wild-size {
    from {
      width: 78%;
      height: 100%;
    }
    to {
      width: 73%;
      height: 95%;
    }
  }
  @keyframes wild-size-inner {
    from {
      width: 46%;
      height: 54%;
    }
    to {
      width: 43%;
      height: 51%;
    }
  }

  /* Embers — small sparks drifting up, brighter/faster once boosted, still
     warm amber-red rather than shifting to brand pink */
  .campfire-embers span {
    position: absolute;
    bottom: 108px;
    left: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #febd08;
    opacity: 0;
    animation: campfire-ember 3.2s linear infinite;
    transition: background 900ms ease;
  }
  .campfire-embers span:nth-child(1) {
    left: 46%;
    animation-delay: 0s;
    --drift: 8px;
  }
  .campfire-embers span:nth-child(2) {
    left: 54%;
    animation-delay: 0.6s;
    --drift: -6px;
  }
  .campfire-embers span:nth-child(3) {
    left: 50%;
    animation-delay: 1.2s;
    --drift: 4px;
  }
  .campfire-embers span:nth-child(4) {
    left: 44%;
    animation-delay: 1.8s;
    --drift: -10px;
  }
  .campfire-embers span:nth-child(5) {
    left: 56%;
    animation-delay: 2.4s;
    --drift: 6px;
  }
  .campfire-embers span:nth-child(6) {
    left: 48%;
    animation-delay: 3s;
    --drift: -4px;
  }
  @keyframes campfire-ember {
    0% {
      transform: translateY(0) translateX(0) scale(1);
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(-110px) translateX(var(--drift, 6px)) scale(0.4);
      opacity: 0;
    }
  }
  .is-boosted .campfire-embers span {
    background: #ff5a1f;
    animation-duration: 2s;
  }

  /* Toggle switch */
  .campfire-control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .campfire-control-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .campfire-switch {
    width: 52px;
    height: 30px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-paper-dim);
    position: relative;
    cursor: pointer;
    padding: 0;
    transition: background 300ms ease, border-color 300ms ease;
  }
  .campfire-switch[aria-checked="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-orb);
  }
  .campfire-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 2px 4px rgba(28, 27, 26, 0.25);
    transition: transform 300ms cubic-bezier(0.54, 1.6, 0.5, 1);
  }
  .campfire-switch[aria-checked="true"] .campfire-knob {
    transform: translateX(22px);
  }

  @media (prefers-reduced-motion: reduce) {
    .campfire-fire-calm,
    .campfire-fire-wild,
    .flame-outer,
    .flame-inner,
    .wild-flame,
    .campfire-embers span {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-campfire-switch]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const root = btn.closest("[data-campfire-root]");
      const boosted = btn.getAttribute("aria-checked") === "true";
      btn.setAttribute("aria-checked", String(!boosted));
      root?.classList.toggle("is-boosted", !boosted);
    });
  });
</script>

---
// Large horizontal/editorial featured card at the top of the case-studies
// archive — deliberately not just another grid item. Works with or without
// `results` (per the brief: "must work even if numerical results are not
// available").
import type { CollectionEntry } from "astro:content";
import CaseStudyImage from "./CaseStudyImage.astro";
import ServiceTagPill from "./ServiceTagPill.astro";
import { serviceLabel } from "../lib/services";

interface Props {
  entry: CollectionEntry<"case-studies">;
}
const { entry } = Astro.props as Props;
const { data } = entry;
const base = import.meta.env.BASE_URL;
---
<a
  href={`${base}/case-studies/${entry.slug}`}
  class="group grid md:grid-cols-[1.1fr_1fr] rounded-[var(--radius-card)] bg-white overflow-hidden [box-shadow:var(--shadow-panel)]"
>
  <div class="min-h-[220px] md:min-h-[360px]">
    <CaseStudyImage src={data.featuredImage} alt={data.title} rounded="rounded-none" />
  </div>

  <div class="p-6 md:p-10 flex flex-col justify-center">
    <p class="text-sm tracking-wide text-[var(--color-accent)] font-medium mb-3">Featured case study</p>
    <p class="text-2xl md:text-3xl font-semibold text-[var(--color-ink)] mb-3">{data.title}</p>
    <p class="text-[var(--color-slate)] mb-5">{data.summary}</p>

    <div class="flex flex-wrap gap-2 mb-6">
      {data.services.map((s) => <ServiceTagPill label={serviceLabel(s)} />)}
    </div>

    {data.results?.length ? (
      <div class="grid grid-cols-3 gap-4 mb-6">
        {data.results.slice(0, 3).map((r) => (
          <div>
            <p class="text-xl md:text-2xl font-semibold text-[var(--color-accent)]">{r.value}</p>
            <p class="text-xs text-[var(--color-slate)] leading-snug">{r.label}</p>
          </div>
        ))}
      </div>
    ) : null}

    <span class="text-[var(--color-accent)] text-sm font-medium inline-flex items-center gap-1">
      View case study <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>

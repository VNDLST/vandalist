---
// "System diagram": a hub circle + supporting cards arranged in a STABLE
// 3-COLUMN CSS GRID around it (left column, a middle column of an
// optional [top card, hub, bottom card], right column) — deliberately NO
// absolute positioning and NO connector lines. Extracted from about.astro's
// "A small team. A complete ecosystem." section, whose own original
// comment already stated the reasoning: "stable 3-column grid, no
// absolute positioning, no connector lines".
//
// Andrew pointed to that already-live section directly as his preferred
// model for other pages making a similar "central capability + supporting
// facets" point — after a connector-line hub-and-spoke diagram (built for
// AI Enablement/SEO, then reverted — see those pages' git history) turned
// out to just be the same message via a different, fussier visual tool.
// This reuses the pattern that already exists rather than inventing a
// second way to say the same thing.
//
// topCard/bottomCard are OPTIONAL: about.astro's own section has 8 total
// cards (3 left + 3 right + 1 flanking the hub above + 1 below), but a
// page with exactly 6 items (3 left + 3 right, hub alone in the middle)
// is an equally valid shape of this same pattern — don't force a 6-item
// page into 2+2+top+bottom just to fill slots that don't exist in its
// content. (Caught after first shipping AI Enablement/SEO with a forced
// top/bottom split — Andrew's own mockup for AI Enablement showed a plain
// 3-left/3-right hub-alone arrangement, matching neither the original
// 6-card flanking-lines HubDiagram nor the forced 2+2+top+bottom split.)
//
// Card shadow here is the proper --shadow-card token, not about.astro's
// own slightly-drifted hardcoded `shadow-[0_10px_24px_-10px_rgba(28,27,26,0.2)]`
// (close to but not exactly --shadow-card's `0 16px 32px -14px
// rgba(28,27,26,0.22)`) — worth pointing out to Andrew as a small existing
// inconsistency, not corrected in about.astro itself here since that
// wasn't asked for.
//
// Icons: about.astro uses supplied PNG assets; this component supports
// that (iconMode="image") but defaults to inline SVG paths (iconMode=
// "inline", same convention as CadenceSteps) since most pages don't have
// a custom icon set to hand.
//
// `title` is OPTIONAL: about.astro's own cards are a single terse line
// (`sub` alone, muted --color-slate, no separate heading) and that stays
// unchanged. AI Enablement/SEO's cards need a bold --color-ink title plus
// a supporting description — first shipped wrongly collapsed down to just
// `sub` (matching about.astro's terse style), which visually read as the
// whole diagram being washed-out/low-contrast next to the mockup, since
// every card's main label was muted grey instead of bold dark text.
interface Card {
  title?: string;
  sub: string;
  icon: string;
  align?: "start" | "center" | "end";
}
interface Props {
  hubText: string;
  hubIcon: string;
  leftColumn: Card[];
  rightColumn: Card[];
  topCard?: Card;
  bottomCard?: Card;
  iconMode?: "inline" | "image";
  iconBase?: string;
}
const {
  hubText,
  hubIcon,
  leftColumn,
  rightColumn,
  topCard,
  bottomCard,
  iconMode = "inline",
  iconBase = "",
} = Astro.props as Props;

const alignClass: Record<string, string> = { start: "self-start", center: "self-center", end: "self-end" };
const allCards = [topCard, ...leftColumn, ...rightColumn, bottomCard].filter((c): c is Card => Boolean(c));
---
<div>
  <!-- Desktop / tablet: stable 3-column grid -->
  <div class="hidden sm:grid grid-cols-3 gap-4 md:gap-6">
    <div class="flex flex-col justify-center gap-6 md:gap-8">
      {leftColumn.map((card) => (
        <div class:list={["flex items-center gap-3 rounded-xl bg-white p-4 [box-shadow:var(--shadow-card)] w-[80%] min-h-[104px]", alignClass[card.align ?? "center"]]}>
          {iconMode === "image" ? (
            <img src={`${iconBase}/${card.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
          ) : (
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </span>
          )}
          <span class="min-w-0 flex-1">
            {card.title ? (
              <>
                <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{card.title}</p>
                <p class="text-xs text-[var(--color-slate)] leading-snug">{card.sub}</p>
              </>
            ) : (
              <p class="text-sm text-[var(--color-slate)] leading-snug">{card.sub}</p>
            )}
          </span>
        </div>
      ))}
    </div>

    <div class="flex flex-col items-center gap-8 md:gap-10">
      {topCard && (
        <div class="flex items-center gap-3 rounded-xl bg-white p-4 [box-shadow:var(--shadow-card)] w-[80%] min-h-[104px]">
          {iconMode === "image" ? (
            <img src={`${iconBase}/${topCard.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
          ) : (
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={topCard.icon} />
            </span>
          )}
          <span class="min-w-0 flex-1">
            {topCard.title ? (
              <>
                <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{topCard.title}</p>
                <p class="text-xs text-[var(--color-slate)] leading-snug">{topCard.sub}</p>
              </>
            ) : (
              <p class="text-sm text-[var(--color-slate)] leading-snug">{topCard.sub}</p>
            )}
          </span>
        </div>
      )}

      <div
        class="rounded-full bg-white [box-shadow:var(--shadow-panel)] flex flex-col items-center justify-center text-center px-4"
        style="width: 190px; height: 190px; border: 10px solid var(--color-paper-dim);"
      >
        {iconMode === "image" ? (
          <img src={`${iconBase}/${hubIcon}.png`} alt="" class="w-16 h-16 rounded-lg mb-1" />
        ) : (
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={hubIcon} />
          </span>
        )}
        <p class="text-xs font-semibold text-[var(--color-ink)] leading-snug">{hubText}</p>
      </div>

      {bottomCard && (
        <div class="flex items-center gap-3 rounded-xl bg-white p-4 [box-shadow:var(--shadow-card)] w-[80%] min-h-[104px]">
          {iconMode === "image" ? (
            <img src={`${iconBase}/${bottomCard.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
          ) : (
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={bottomCard.icon} />
            </span>
          )}
          <span class="min-w-0 flex-1">
            {bottomCard.title ? (
              <>
                <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{bottomCard.title}</p>
                <p class="text-xs text-[var(--color-slate)] leading-snug">{bottomCard.sub}</p>
              </>
            ) : (
              <p class="text-sm text-[var(--color-slate)] leading-snug">{bottomCard.sub}</p>
            )}
          </span>
        </div>
      )}
    </div>

    <div class="flex flex-col justify-center gap-6 md:gap-8">
      {rightColumn.map((card) => (
        <div class:list={["flex items-center gap-3 rounded-xl bg-white p-4 [box-shadow:var(--shadow-card)] w-[80%] min-h-[104px]", alignClass[card.align ?? "center"]]}>
          {iconMode === "image" ? (
            <img src={`${iconBase}/${card.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
          ) : (
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </span>
          )}
          <span class="min-w-0 flex-1">
            {card.title ? (
              <>
                <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{card.title}</p>
                <p class="text-xs text-[var(--color-slate)] leading-snug">{card.sub}</p>
              </>
            ) : (
              <p class="text-sm text-[var(--color-slate)] leading-snug">{card.sub}</p>
            )}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- Mobile: hub first, then a simple 2-column card grid -->
  <div class="sm:hidden flex flex-col items-center gap-6">
    <div
      class="rounded-full bg-white [box-shadow:var(--shadow-panel)] flex flex-col items-center justify-center text-center px-4"
      style="width: 170px; height: 170px; border: 10px solid var(--color-paper-dim);"
    >
      {iconMode === "image" ? (
        <img src={`${iconBase}/${hubIcon}.png`} alt="" class="w-16 h-16 rounded-lg mb-1" />
      ) : (
        <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] mb-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={hubIcon} />
        </span>
      )}
      <p class="text-xs font-semibold text-[var(--color-ink)] leading-snug">{hubText}</p>
    </div>
    <div class="grid grid-cols-2 gap-3 w-full">
      {allCards.map((card) => (
        <div class="flex items-center gap-2.5 rounded-xl bg-white p-4 [box-shadow:var(--shadow-card)] min-h-[104px]">
          {iconMode === "image" ? (
            <img src={`${iconBase}/${card.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
          ) : (
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[var(--color-accent-soft)] text-[var(--color-accent)] shrink-0">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </span>
          )}
          <span>
            {card.title ? (
              <>
                <p class="font-semibold text-[var(--color-ink)] text-sm mb-0.5">{card.title}</p>
                <p class="text-xs text-[var(--color-slate)] leading-snug">{card.sub}</p>
              </>
            ) : (
              <p class="text-sm text-[var(--color-slate)] leading-snug">{card.sub}</p>
            )}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>

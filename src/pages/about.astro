---
import Layout from "../layouts/Layout.astro";
import Band from "../components/Band.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHeading from "../components/PageHeading.astro";
import Heading from "../components/Heading.astro";
import Eyebrow from "../components/Eyebrow.astro";

const base = import.meta.env.BASE_URL;

// Each card shows its label at rest and swaps to `meaning` on hover/focus/tap
// (Andrew's copy, 2026-10-13). Wording is his, reflowed from poster line breaks.
const coreValues = [
  { icon: "knowledge", label: "Never know enough", meaning: "Our best work comes from listening, researching, and executing. The more we know, the more we grow." },
  { icon: "fearless", label: "Pitch fearlessness", meaning: "We aim for excellence; being fearless with how we meet challenges, pitch ideas, and how we solve problems." },
  { icon: "shipit", label: "Ship it right", meaning: "Some things need time, some things just need to get done right now. We move with urgency and aim huge." },
  { icon: "excited", label: "Start excited, stay excited", meaning: "We are skilful, motivated professionals that do cool work. We don't get complacent; we get more valuable." },
  { icon: "different", label: "We aren't everyone", meaning: "We are confident in our talents but are not so arrogant to think that our way is the only way to go." },
];

// Radial "system" nodes, positioned evenly around the center circle (8 nodes, 45deg apart).
// top/left are percentages within a square relative container; computed from angle+radius.
// Three-column arrangement (no radial positioning): each column lists its
// cards top-to-bottom with an explicit alignment, per column.
const leftColumn = [
  { label: "Systems / AI", sub: "Integrations, AI & automated workflows", icon: "systems-ai", align: "end" },
  { label: "Community", sub: "E-marketing & social media engagement", icon: "community", align: "start" },
  { label: "SEO & Ads", sub: "SEO, GEO, Google & social Advertising", icon: "seo-ads", align: "end" },
];
const rightColumn = [
  { label: "Project Management", sub: "Project plans, management & delivery", icon: "project-management", align: "start" },
  { label: "Design", sub: "Style guides, templates & graphic design", icon: "design", align: "end" },
  { label: "Websites", sub: "Stylish, secure & user-friendly websites", icon: "websites", align: "start" },
];
const strategyCard = { label: "Strategy", sub: "Strategy, advice, execution & support", icon: "strategy" };
const contentCard = { label: "Content", sub: "Articles, blogs, & content for internal assets", icon: "content" };

const alignClass: Record<string, string> = { start: "self-start", center: "self-center", end: "self-end" };

// Six equal cells: cell 1 is the intro text (rendered directly in markup below),
// cells 2-6 are these partner entries in order.
const partnerCells = [
  {
    logo: "local-buy",
    eyebrow: "Approved supplier",
    title: "Local Buy Approved Supplier",
    text: "Part of Local Buy since 2022. We provide services to government entities and public organisations as part the Local Buy pre-qualified supplier program.",
    logoWidth: "65%",
  },
  {
    logo: "queensland-government",
    eyebrow: null,
    title: "QLD Government's Mentoring for Growth program",
    text: "A Mentoring for Growth member since 2019. We provide business owners with sustainable and practical marketing guidance specific to their business goals.",
    logoWidth: "65%",
  },
  {
    logo: "carbon-neutral",
    eyebrow: "Environmental commitment",
    title: "Carbon Neutral Plant-a-Tree program",
    text: "Our sponsorship contributes to the planting of native trees along damaged natural corridors throughout Australia to help resurrect the effects of deforestation.",
    logoWidth: "80%",
  },
  {
    logo: "university-of-queensland",
    eyebrow: "Mentoring & education",
    title: "UQ Industry Mentor",
    text: "Part of UQ's Industry Mentoring program since 2020. We help students transition from their studies to careers through mentoring and industry seminars.",
    logoWidth: "65%",
  },
  {
    logo: "qut",
    eyebrow: null,
    title: "QUT Industry Mentor",
    text: "A member of QUT's mentoring program since 2021. We work with students on career planning as well as with small teams working on assessible industry projects.",
    logoWidth: "65%",
  },
];
---
<Layout title="About">
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/about" />

    <!-- Intro -->
    <div class="max-w-4xl mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-20 md:pb-[93px] text-center">
      <PageHeading class="max-w-[850px] mx-auto mb-6">
        A marketing agency built around practicality and sustainability.
      </PageHeading>
      <p class="max-w-[700px] mx-auto text-lg text-[var(--color-slate)]">
        We partner with established businesses, marketing managers, and lean internal teams to get more capability without the bloat.
      </p>
    </div>

    <!-- Intro video -->
    <Band bottom="roomy">
        <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-8 items-center">
          <div>
            <Eyebrow class="mb-3">Intro video</Eyebrow>
            <Heading class="mb-4">A quick hello from Andrew.</Heading>
            <p class="text-[var(--color-ink)] max-w-md">
              A 97 second overview of why Vandalist was created, our approach to &lsquo;marketing&rsquo;, and what businesses can expect when working with us.
            </p>
          </div>

          <div class="relative rounded-[var(--radius-card)] overflow-hidden aspect-[4/3] bg-[var(--color-ink)]">
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="w-16 h-16 rounded-full bg-white/90 [box-shadow:var(--shadow-panel)] flex items-center justify-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--color-accent)"><path d="M6 4l14 8-14 8V4z" /></svg>
              </span>
            </div>
          </div>
        </div>
      </Band>

    <!-- Mission statement -->
    <div class="max-w-2xl mx-auto px-6 md:px-10 pb-20 md:pb-28 text-center space-y-6">
      <p class="text-[var(--color-ink)] text-lg leading-relaxed">
        We believe marketing should create momentum, not noise. That means strategic forethought, practical execution, and systems that make it easier to keep going.
      </p>
      <p class="text-[var(--color-ink)] text-lg leading-relaxed">
        Vandalist exists to help established businesses get more marketing capability on tap &mdash; so you can move faster, stay focused, and build something that lasts.
      </p>
    </div>

    <!-- Core values -->
    <div class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <Eyebrow class="text-center mb-10">Our values</Eyebrow>

      <div class="max-w-5xl mx-auto flex flex-wrap justify-center items-start gap-x-5 gap-y-7">
        {coreValues.map((value, i) => {
          const tilt = [
            "rotate(-1.5deg) translateY(-3px)",
            "rotate(1deg) translateY(7px)",
            "rotate(-1deg) translateY(-5px)",
            "rotate(1.5deg) translateY(4px)",
            "rotate(-2deg) translateY(-2px)",
          ][i % 5];
          return (
            <div
              class="value-card relative w-full sm:w-[320px] sm:min-h-[9.25rem] flex items-center gap-4 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white px-7 py-6 [box-shadow:var(--shadow-card)] cursor-default select-none"
              style={`transform: ${tilt};`}
              tabindex="0"
              role="group"
              aria-label={`${value.label}: ${value.meaning}`}
            >
              <span
                class="vc-icon w-14 h-14 shrink-0"
                style={`-webkit-mask-image:url(${base}/values-icons/${value.icon}.svg); mask-image:url(${base}/values-icons/${value.icon}.svg); -webkit-mask-size:contain; mask-size:contain; -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat; -webkit-mask-position:center; mask-position:center;`}
              ></span>
              <div class="grid min-w-0 flex-1" aria-hidden="true">
                <p class="vc-label [grid-area:1/1] self-center capitalize text-[var(--color-ink)] leading-snug" style="font-size: 1.3rem; font-weight: 600;">{value.label}</p>
                <p class="vc-meaning [grid-area:1/1] self-center text-white text-sm leading-snug font-medium">{value.meaning}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- How we work: system diagram -->
    <Band bottom="roomy" padding="roomy">
        <div class="max-w-7xl mx-auto grid md:grid-cols-[1fr_2fr] gap-10 items-center">
          <div>
            <Eyebrow class="mb-3">How we work</Eyebrow>
            <Heading class="mb-4">A small team. A complete ecosystem.</Heading>
            <p class="text-[var(--color-slate)] mb-6">
              We bring the right capabilities around the table &mdash; and connect them in a way that creates clarity, alignment, and results.
            </p>
            <a href={`${base}/how-we-work`} class="text-[var(--color-accent)] text-sm font-medium inline-flex items-center gap-1">
              See how we work <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <!-- Desktop / tablet: stable 3-column grid, no absolute positioning,
               no connector LINES — per Andrew's follow-up, the diagram read
               as "bloaty and disconnected" as pure whitespace between hub
               and cards. First pass added 2 sparkle marks at the column
               seams; Andrew's follow-up note showed the intent was a full
               radial burst instead — 8 short dashes just outside the hub's
               own edge, one pointing toward each of the 8 surrounding
               cards (evenly spaced 45° apart, same technique this
               diagram's own OLD radial-layout iteration used before it was
               simplified to this 3-column grid — see the top-of-file
               comment). Small dashes, not full lines, so it still doesn't
               cross into this diagram's "no connector lines" territory. -->
          <div class="hidden sm:grid grid-cols-3 gap-4 md:gap-6">
            <!-- Left column -->
            <div class="flex flex-col justify-center gap-6 md:gap-8">
              {leftColumn.map((card) => (
                <div class={`flex items-center gap-3 rounded-xl border-[5px] border-[var(--color-accent-soft)] bg-white p-4 shadow-[0_10px_24px_-10px_rgba(28,27,26,0.2)] w-[90%] min-h-[104px] ${alignClass[card.align]}`}>
                  <img src={`${base}/system-icons/icon-${card.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
                  <span class="min-w-0 flex-1">
                    <p class="text-sm text-[var(--color-slate)] leading-snug">{card.sub}</p>
                  </span>
                </div>
              ))}
            </div>

            <!-- Middle column -->
            <div class="flex flex-col items-center gap-8 md:gap-10">
              <div class="flex items-center gap-3 rounded-xl border-[5px] border-[var(--color-accent-soft)] bg-white p-4 shadow-[0_10px_24px_-10px_rgba(28,27,26,0.2)] w-[90%] min-h-[104px]">
                <img src={`${base}/system-icons/icon-${strategyCard.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
                <span class="min-w-0 flex-1">
                  <p class="text-sm text-[var(--color-slate)] leading-snug">{strategyCard.sub}</p>
                </span>
              </div>

              <div class="relative">
                <!-- 8 short dashes radiating from the hub's edge, one toward
                     each surrounding card — see comment above this grid. -->
                {Array.from({ length: 8 }, (_, i) => i * 45).map((angle) => (
                  <span
                    class="absolute top-1/2 left-1/2 w-[2px] h-[13px] rounded-full bg-[var(--color-accent)] pointer-events-none"
                    style={`transform: translate(-50%, -50%) rotate(${angle}deg) translateY(-107px);`}
                    aria-hidden="true"
                  ></span>
                ))}
                <div class="relative rounded-full bg-white [box-shadow:var(--shadow-panel)] flex flex-col items-center justify-center text-center px-4"
                     style="width: 190px; height: 190px; border: 10px solid var(--color-paper);">
                  <img src={`${base}/system-icons/icon-hub.png`} alt="" class="w-16 h-16 rounded-lg" />
                  <p class="text-xs font-semibold text-[var(--color-ink)] leading-snug">The right people working on the right projects</p>
                </div>
              </div>

              <div class="flex items-center gap-3 rounded-xl border-[5px] border-[var(--color-accent-soft)] bg-white p-4 shadow-[0_10px_24px_-10px_rgba(28,27,26,0.2)] w-[90%] min-h-[104px]">
                <img src={`${base}/system-icons/icon-${contentCard.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
                <span class="min-w-0 flex-1">
                  <p class="text-sm text-[var(--color-slate)] leading-snug">{contentCard.sub}</p>
                </span>
              </div>
            </div>

            <!-- Right column -->
            <div class="flex flex-col justify-center gap-6 md:gap-8">
              {rightColumn.map((card) => (
                <div class={`flex items-center gap-3 rounded-xl border-[5px] border-[var(--color-accent-soft)] bg-white p-4 shadow-[0_10px_24px_-10px_rgba(28,27,26,0.2)] w-[90%] min-h-[104px] ${alignClass[card.align]}`}>
                  <img src={`${base}/system-icons/icon-${card.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
                  <span class="min-w-0 flex-1">
                    <p class="text-sm text-[var(--color-slate)] leading-snug">{card.sub}</p>
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Mobile: hub first, then a simple 2-column card grid -->
          <div class="sm:hidden flex flex-col items-center gap-6">
            <div class="rounded-full bg-white [box-shadow:var(--shadow-panel)] flex flex-col items-center justify-center text-center px-4"
                 style="width: 170px; height: 170px; border: 10px solid var(--color-paper);">
              <img src={`${base}/system-icons/icon-hub.png`} alt="" class="w-16 h-16 rounded-lg" />
              <p class="text-xs font-semibold text-[var(--color-ink)] leading-snug">The right people working on the right projects</p>
            </div>
            <div class="grid grid-cols-2 gap-3 w-full">
              {[strategyCard, ...leftColumn, ...rightColumn, contentCard].map((card) => (
                <div class="flex items-center gap-2.5 rounded-xl border-[5px] border-[var(--color-accent-soft)] bg-white p-4 shadow-[0_10px_24px_-10px_rgba(28,27,26,0.2)] min-h-[104px]">
                  <img src={`${base}/system-icons/icon-${card.icon}.png`} alt="" class="w-10 h-10 shrink-0 rounded-lg" />
                  <span>
                    <p class="text-sm text-[var(--color-slate)] leading-snug">{card.sub}</p>
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </Band>

    <!-- Partnerships & trust -->
    <div class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-12">
        <!-- Cell 1: heading + intro — dashed border (paper-dim, the site's
             standard "darker background" tone) + white fill, so this reads
             as the information cell vs. the 5 actual partner/trust cells
             beside it, which stay plain/borderless as before. -->
        <div class="p-6 rounded-[var(--radius-card)] border-2 border-dashed border-[var(--color-paper-dim)] bg-white">
          <Eyebrow class="mb-3">Partnerships & trust</Eyebrow>
          <Heading class="mb-4">We are a small agency that believes in making a big contribution.</Heading>
          <div class="w-10 h-[3px] bg-[var(--color-accent)] rounded-full mb-4"></div>
          <p class="text-[var(--color-slate)]">
            Through mentoring, partnerships and local support, we are active contributors to the communities around us.
          </p>
        </div>

        <!-- Cells 2-6: partner logos -->
        {partnerCells.map((item) => (
          <div class:list={["p-2", !item.eyebrow && "pt-11"]}>
            {item.eyebrow && <Eyebrow class="mb-4">{item.eyebrow}</Eyebrow>}
            <div class:list={["flex items-center", item.title ? "mb-4" : ""]}>
              <img
                src={`${base}/partner-logos/${item.logo}.svg`}
                alt=""
                class="h-auto object-contain object-left"
                style={item.logoWidth ? `width: ${item.logoWidth};` : "width: auto; max-width: 100%;"}
              />
            </div>
            {item.title && <p class="font-semibold text-[var(--color-ink)] text-sm mb-1">{item.title}</p>}
            {item.text && <p class="text-[var(--color-slate)] text-sm">{item.text}</p>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <CtaBand />
  <Footer />
</Layout>

<script>
  // Touch has no hover: tap a value card to flip it, tap again or elsewhere to
  // flip back. (Mouse uses :hover and keyboard uses :focus-visible in CSS.)
  const cards = [...document.querySelectorAll<HTMLElement>(".value-card")];
  cards.forEach((card) => {
    card.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = card.classList.contains("is-open");
      cards.forEach((c) => c.classList.remove("is-open"));
      if (!open) card.classList.add("is-open");
    });
  });
  document.addEventListener("click", () => cards.forEach((c) => c.classList.remove("is-open")));
</script>

<style>
  .value-card {
    transition: background-color 250ms ease, border-color 250ms ease;
    outline-offset: 3px;
  }
  .value-card .vc-icon { background-color: var(--color-accent); transition: background-color 250ms ease; }
  .value-card .vc-label,
  .value-card .vc-meaning { transition: opacity 250ms ease; }
  .value-card .vc-meaning { opacity: 0; }
  .value-card:focus-visible,
  .value-card.is-open { background-color: var(--color-accent); border-color: var(--color-accent); }
  .value-card:focus-visible .vc-icon,
  .value-card.is-open .vc-icon { background-color: #fff; }
  .value-card:focus-visible .vc-label,
  .value-card.is-open .vc-label { opacity: 0; }
  .value-card:focus-visible .vc-meaning,
  .value-card.is-open .vc-meaning { opacity: 1; }
  @media (hover: hover) {
    .value-card:hover { background-color: var(--color-accent); border-color: var(--color-accent); }
    .value-card:hover .vc-icon { background-color: #fff; }
    .value-card:hover .vc-label { opacity: 0; }
    .value-card:hover .vc-meaning { opacity: 1; }
  }
  /* Peeling corner (Andrew's mockup, 2026-10-14), pure CSS, no images.
     ::before is the pink "underside" revealed in the top-right corner; ::after is
     the curled-over flap — a white triangle (mask) with a soft shading gradient along
     the fold, rounded at its free corner. Both sit over the 1px border (top/right -1px)
     and are painted by overlay rather than clip-path so the card's drop shadow isn't
     clipped. Once flipped (hover/focus/tap) the corner fades out entirely — Andrew:
     by then the visitor has worked out the interaction. Text sits above them
     (z-index 1). */
  .value-card::before,
  .value-card::after {
    content: "";
    position: absolute;
    top: -1px;
    right: -1px;
    width: 1.5rem;
    height: 1.5rem;
    pointer-events: none;
    transition: opacity 250ms ease;
  }
  @media (min-width: 640px) {
    .value-card::before,
    .value-card::after { width: 2rem; height: 2rem; }
  }
  .value-card::before {
    background: linear-gradient(225deg, var(--color-accent) 50%, transparent 50%);
    border-top-right-radius: var(--radius-card);
  }
  .value-card::after {
    background-color: #fff;
    background-image: linear-gradient(225deg, transparent 50%, rgba(28, 27, 26, 0.14) 51%, rgba(28, 27, 26, 0) 88%);
    -webkit-mask-image: linear-gradient(225deg, transparent 50%, #000 50%);
    mask-image: linear-gradient(225deg, transparent 50%, #000 50%);
    border-bottom-left-radius: 0.55rem;
  }
  .value-card > div { position: relative; z-index: 1; }
  .value-card:focus-visible::before,
  .value-card:focus-visible::after,
  .value-card.is-open::before,
  .value-card.is-open::after { opacity: 0; }
  @media (hover: hover) {
    .value-card:hover::before,
    .value-card:hover::after { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .value-card, .value-card::before, .value-card::after, .value-card .vc-icon, .value-card .vc-label, .value-card .vc-meaning { transition: none; }
  }
</style>

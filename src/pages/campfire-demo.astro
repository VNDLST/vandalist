---
// Internal concept preview — not a real site page, not linked from
// navigation. Delete once the "Add a little Vandalist" idea has been
// decided on / integrated into how-we-work.astro (or discarded).
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";
import CampfireToggle from "../components/CampfireToggle.astro";
---
<Layout title="Campfire Concept (Internal)">
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/campfire-demo" />

    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-20 md:pb-28">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <Eyebrow class="mb-3">Internal concept — not a real page</Eyebrow>
        <Heading as="h1" class="mb-4">Campfire toggle, adapted for Vandalist</Heading>
        <p class="text-[var(--color-slate)]">
          Concept for the "How We Work" page: a small campfire that grows and shifts
          toward the Vandalist pink when you flip the switch. Animation technique
          adapted from&nbsp;
          <a
            href="https://codepen.io/ig_design/pen/NeRxzj"
            class="text-[var(--color-accent)] underline underline-offset-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            "CSSspark" by Ivan Grozdic
          </a>
          (MIT licensed) — recoloured, simplified, and rebuilt as a proper toggle switch.
        </p>
      </div>

      <div class="flex justify-center">
        <CampfireToggle />
      </div>

      <p class="text-center text-sm text-[var(--color-slate-light)] mt-10">
        Flip the switch a few times, try it at different widths, then let&rsquo;s talk about whether
        (and how) this fits on the real page.
      </p>
    </section>
  </div>

  <Footer />
</Layout>

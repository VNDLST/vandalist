---
// The small icon-in-a-shape chip (pink tint with a pink line icon is the default
// look). Three sizes only, chosen 2026-10-27 (Andrew delegated the choice; he can
// review). Before that the site used six circle sizes (28 to 56px), nine icon
// sizes and two stroke weights across 40 hand-built copies:
//   sm  32px chip, 16px icon  (was 28, 32 and 36px chips: list rows, small labels)
//   md  44px chip, 20px icon  (was 40 and 44px chips: card icons)
//   lg  56px chip, 26px icon  (was 56px chips: feature pillars; lighter 1.5 stroke)
// Shapes: "full" (circle, default) or "lg" (rounded square). Tones as listed.
// `icon` is inline SVG path markup on a 24x24 viewBox, drawn in currentColor.
// (Not to be confused with IconBadge.astro, an older, currently unused
// check/cross status badge.)
interface Props {
  icon: string;
  size?: "sm" | "md" | "lg";
  shape?: "full" | "lg";
  tone?: "accent" | "white" | "whiteCard" | "whiteGood" | "whiteGood70" | "dim";
  class?: string;
}
const { icon, size = "sm", shape = "full", tone = "accent", class: className } = Astro.props as Props;

// Literal class strings so Tailwind's static scanner finds every one.
const spec = {
  sm: { box: "w-8 h-8", icon: 16, stroke: "1.75" },
  md: { box: "w-11 h-11", icon: 20, stroke: "1.75" },
  lg: { box: "w-14 h-14", icon: 26, stroke: "1.5" },
}[size];
const shapes = { full: "rounded-full", lg: "rounded-lg" }[shape];
const tones = {
  accent: "bg-[var(--color-accent-soft)] text-[var(--color-accent)]",
  white: "bg-white text-[var(--color-accent)]",
  whiteCard: "bg-white text-[var(--color-accent)] [box-shadow:var(--shadow-card)]",
  whiteGood: "bg-white text-[var(--color-good)]",
  whiteGood70: "bg-white/70 text-[var(--color-good)]",
  dim: "bg-[var(--color-paper-dim)] text-[var(--color-slate)]",
}[tone];
---
<span class:list={["inline-flex items-center justify-center", spec.box, shapes, tones, className]}>
  <svg
    width={spec.icon}
    height={spec.icon}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={spec.stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icon}
  />
</span>

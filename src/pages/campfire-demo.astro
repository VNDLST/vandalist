---
// Internal concept preview — not a real site page, not linked from
// navigation. Delete once the "Add a little Vandalist" idea has been
// decided on / integrated into how-we-work.astro (or discarded).
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";
import PageHeading from "../components/PageHeading.astro";
import CampfireToggle from "../components/CampfireToggle.astro";
---
<Layout title="Campfire Concept (Internal)">
  <div class="bg-[var(--color-paper)]">
    <Header currentPage="/campfire-demo" />

    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-20 md:pb-28">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <Eyebrow class="mb-3">Internal concept — not a real page</Eyebrow>
        <Heading as="h1" class="mb-4">Campfire toggle, adapted for Vandalist</Heading>
        <p class="text-[var(--color-slate)]">
          Concept for the "How We Work" page: a small, calm campfire that cross-fades
          into a bigger, wilder flame when you flip the switch — stays in warm
          amber/orange throughout rather than shifting toward brand pink, which read
          as chemical rather than fiery. The calm flame is a simple gradient teardrop;
          the boosted flame swaps in the actual multi-blob technique from&nbsp;
          <a
            href="https://codepen.io/Rosefae/pen/oQBRXe"
            class="text-[var(--color-accent)] underline underline-offset-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            "Campfire" by Rose Liu
          </a>
          — several lopsided rounded shapes all pivoting from the same corner,
          recoloured to warm tones. Base toggle mechanic adapted from&nbsp;
          <a
            href="https://codepen.io/ig_design/pen/NeRxzj"
            class="text-[var(--color-accent)] underline underline-offset-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            "CSSspark" by Ivan Grozdic
          </a>
          (both MIT licensed) — recoloured and rebuilt from scratch either way.
        </p>
      </div>

      <div class="flex justify-center">
        <CampfireToggle />
      </div>

      <p class="text-center text-sm text-[var(--color-slate-light)] mt-10">
        Flip the switch a few times, try it at different widths, then let&rsquo;s talk about whether
        (and how) this fits on the real page.
      </p>
    </section>

    <!-- In-context mockup: roughly the real how-we-work.astro hero layout
         (text left ~2/5, graphic right ~3/5), with the campfire standing in
         for that section's placeholder graphic, so size/placement can be
         judged against actual page proportions instead of in isolation. -->
    <section class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 pb-20 md:pb-28">
      <div class="rounded-[var(--radius-card)] bg-[var(--color-paper-dim)] p-6 md:p-10">
        <p class="text-sm font-medium text-[var(--color-slate-light)] mb-6">
          ↓ Mockup only — not a real section, just the how-we-work.astro hero grid for scale reference
        </p>
        <div class="grid lg:grid-cols-[2fr_3fr] gap-10 items-center">
          <div>
            <PageHeading as="h2" class="mb-6">Practical, sustainable, and easy to work with</PageHeading>
            <p class="max-w-md text-lg text-[var(--color-slate)]">
              We adapt to requirements whether that is being part of the strategic
              conversations, or being utilised for specific production tasks.
            </p>
          </div>
          <div class="relative flex justify-center">
            <!-- Minimalist backdrop so the fire reads as part of a scene
                 rather than floating alone — composition (receding trees +
                 a hill it sits on) borrowed from the reference mockup, but
                 recoloured into the site's own tokens instead of that
                 reference's pink: trees in --color-good (already the
                 site's "positive/aligned" green elsewhere) rather than flat
                 gray, a hill that peaks and descends under the fire instead
                 of plateauing into empty space, and a soft warm gradient
                 patch blending the fire's own glow into the ground so it
                 doesn't look pasted on top. Static, no animation. -->
            <svg
              class="absolute inset-0 w-full h-full pointer-events-none"
              viewBox="0 0 500 240"
              preserveAspectRatio="xMidYMax slice"
              aria-hidden="true"
            >
              <defs>
                <radialGradient id="campfire-scene-warmth" cx="50%" cy="28%" r="65%">
                  <stop offset="0%" stop-color="#ff9d1f" stop-opacity="0.32" />
                  <stop offset="100%" stop-color="#ff9d1f" stop-opacity="0" />
                </radialGradient>
              </defs>
              <path
                d="M0 225 Q 125 195 250 179 Q 375 196 500 222 L 500 240 L 0 240 Z"
                fill="var(--color-paper-deep)"
              />
              <ellipse cx="250" cy="206" rx="150" ry="55" fill="url(#campfire-scene-warmth)" />
              <polygon points="34,214 42,214 38,190" fill="var(--color-good)" opacity="0.32" />
              <polygon points="78,212 89,212 83.5,180" fill="var(--color-good)" opacity="0.38" />
              <polygon points="132,209 146,209 139,170" fill="var(--color-good)" opacity="0.44" />
              <polygon points="192,206 209,206 200.5,160" fill="var(--color-good)" opacity="0.5" />
              <polygon points="288,202 309,202 298.5,143" fill="var(--color-good)" opacity="0.56" />
              <ellipse cx="205" cy="216" rx="10" ry="5" fill="var(--color-slate-light)" opacity="0.4" />
              <ellipse cx="330" cy="214" rx="8" ry="4" fill="var(--color-slate-light)" opacity="0.4" />
            </svg>
            <div class="relative">
              <CampfireToggle />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Footer />
</Layout>

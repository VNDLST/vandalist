---
// Shared eyebrow + heading + optional subtext pattern, used by every content
// section so label styling, spacing, and hierarchy stay consistent site-wide.
// If a section doesn't have real subtext copy yet, pass placeholder Lorem
// Ipsum rather than omitting it — keeps rhythm consistent until real copy
// lands, and makes it obvious at a glance which sections still need copy.
import Eyebrow from "./Eyebrow.astro";
import Heading from "./Heading.astro";

interface Props {
  eyebrow: string;
  heading: string;
  subtext?: string;
  align?: "left" | "center";
  headingNoWrap?: boolean;
}
const { eyebrow, heading, subtext, align = "left", headingNoWrap = false } = Astro.props as Props;
const alignClass = align === "center" ? "text-center mx-auto" : "";
---
<div class={`mb-12 max-w-3xl ${alignClass}`}>
  <Eyebrow class="mb-3">{eyebrow}</Eyebrow>
  <Heading noWrap={headingNoWrap} class="mb-4">{heading}</Heading>
  {subtext && <p class={`text-[var(--color-slate)] max-w-2xl ${alignClass}`}>{subtext}</p>}
</div>

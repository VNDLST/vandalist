---
// The standard in-page section heading (below a page's hero): the t-heading
// style (30 / 36 / 40px, line-height 1.2; see global.css) with balanced line
// breaks. Defaults to <h2>. For the big page-hero headline use PageHeading.
// (Until 2026-10-27 there was also a smaller "section" size; Andrew chose the
// larger one as the single section-heading size.)
interface Props {
  as?: "h1" | "h2" | "h3";
  class?: string;
  noWrap?: boolean;
}
const { as: Tag = "h2", class: className, noWrap = false } = Astro.props as Props;
---
{/* noWrap uses sm:whitespace-nowrap, not a bare whitespace-nowrap — it exists to
   stop an awkward mid-phrase break at desktop widths, not to force one long line
   at mobile widths where there isn't room for it (that forced a page-wide
   horizontal-scroll bug: the heading's un-wrappable text pushed scrollWidth past
   the viewport with nothing downstream to clip it). */}
<Tag class:list={["t-heading text-balance", noWrap && "sm:whitespace-nowrap", className]}>
  <slot />
</Tag>

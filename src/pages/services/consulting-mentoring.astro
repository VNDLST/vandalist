---
// Third of 4-5 service pages, built from Andrew's supplied mockup ("get a
// start on" — first-pass template, not final). Nav, CtaBand and Footer are
// the site's shared chrome and untouched here per Andrew's instruction.
//
// This mockup's hero already had its 4 cards correctly below the hero (the
// marketing-support.astro mockup didn't — see that file's note). Hero copy and Sections 1-2
// rebuilt 2026-11-13.
//
// Hero art: a chat-style testimonial bubble with a drawn avatar (TestimonialBubble.astro, concept
// approved by Andrew 2026-11-13 after judging it on a demo page, since deleted). From lg it fills
// the right half of the hero: bubble high (just under the nav), avatar low (near the hero's
// bottom). Below lg the art side is hidden, so the same bubble shows at the top of Section 1.
// THE QUOTES BELOW ARE PLACEHOLDERS: real ones need Andrew's quotes, first names, workplaces and
// a line describing each person for the drawn avatars.
//
// Sections 1-2 follow the SEO page's conventions (Andrew, 2026-11-13: the services pages must share
// one style): Section 1 = opening text (eyebrow / heading / intro, PLACEHOLDER copy for now)
// above four cards with 96px illustrations and body-size text; Section 2 = the same band split as
// SEO's "Our approach" (30/70 from xl) with the card recipe from LinkedPairs (77px illustration
// beside the text).
import Layout from "../../layouts/Layout.astro";
import Band from "../../components/Band.astro";
import Section from "../../components/Section.astro";
import IconChip from "../../components/IconChip.astro";
import PageHero from "../../components/PageHero.astro";
import OrbButton from "../../components/OrbButton.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CadenceSteps from "../../components/CadenceSteps.astro";
import TestimonialBubble from "../../components/TestimonialBubble.astro";

const base = import.meta.env.BASE_URL;

// --- Hero: testimonial bubble (PLACEHOLDER quotes and rough placeholder avatars) ---
const testimonials = [
  { avatar: "a", name: "Sam", workplace: "Placeholder Co", quote: "Placeholder quote one. About twenty words long, so you can judge the reading time and how the bubble copes with the longest one." },
  { avatar: "b", name: "Alex", workplace: "Example Group", quote: "Placeholder quote two, a little shorter, to show that the bubble holds its size." },
  { avatar: "c", name: "Jo", workplace: "Sample Business", quote: "Placeholder quote three. Talking things through with an outsider changed how we planned our whole year, and the team felt more confident straight away." },
  { avatar: "d", name: "Chris", workplace: "Demo Council", quote: "Placeholder quote four. Practical, honest and never theoretical." },
] as const;

// --- Section 1: Service cards ---
// Rebuilt 2026-11-13 from Andrew's remodelled mock-up: his four illustrations
// (public/consulting-services/), recoloured to the site pink and cropped to one shared square
// frame so their relative sizes are as he drew them.
const services = [
  { title: "Strategic advice", text: "Clarity on priorities, direction, and next steps.", image: "strategic-advice" },
  { title: "Mentoring support", text: "Guidance for internal marketers and growing teams.", image: "mentoring-support" },
  { title: "Workshops & reviews", text: "Structured sessions to solve specific problems.", image: "workshops-and-reviews" },
  { title: "Independent perspective", text: "Outside input without agency theatre.", image: "independent-perspective" },
];

// --- Section 2: Our approach ---
// Rebuilt 2026-11-13 from the same mock-up: left, eyebrow/heading/paragraph + four ticks (the
// same tick treatment as the Marketing Support page); right, a 2x2 of white cards with his
// illustrations (public/consulting-approach/), same card recipe as Section 1.
const approachPoints = [
  "Practical, not theoretical",
  "Honest outside perspective",
  "Built around your context",
  "Designed to leave your team stronger",
];
const approachItems = [
  {
    title: "Strategic sounding board",
    text: "Talk through ideas, challenges, and decisions with an experienced marketing partner.",
    image: "sounding-board",
  },
  {
    title: "One-to-one mentoring",
    text: "Regular mentoring for internal marketers and growing teams who want support.",
    image: "one-to-one-mentoring",
  },
  {
    title: "Team workshops",
    text: "Focused, collaborative sessions to solve problems and build shared understanding.",
    image: "team-workshops",
  },
  {
    title: "Review & recommendations",
    text: "Objective review of plans, campaigns, or strategy with clear, practical recommendations.",
    image: "review-and-recommendations",
  },
];

// --- Section 3: Situations we often help with ---
const situations = [
  { title: "Need clearer priorities?", text: "We help cut through competing ideas and focus on what matters next.", icon: '<path d="M4 7h16M4 12h10M4 17h6" stroke-linecap="round"/>' },
  { title: "Internal marketer needs support?", text: "We provide mentoring, feedback, and experienced perspective.", icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.6 3.1-6.3 7-6.3s7 2.7 7 6.3"/>' },
  { title: "Campaign or plan needs review?", text: "We assess the approach and recommend practical improvements.", icon: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5" stroke-linecap="round"/>' },
  { title: "Team capability needs lifting?", text: "We help build confidence, knowledge, and useful ways of working.", icon: '<path d="M4 19h16" stroke-linecap="round"/><path d="M4 15l5-5 4 3 6-7" stroke-linecap="round" stroke-linejoin="round"/>' },
];

// --- Section 4: How this usually works ---
// Flow icons: Lucide (ISC licence), chosen 2026-11-12 while Andrew was away (swap any file in public/consulting-process-icons/).
const processSteps = [
  { num: "01", title: "Understand the situation", text: "We listen, ask good questions, and get to the heart of it.", icon: "understand" },
  { num: "02", title: "Recommend a path forward", text: "We share clear options and practical recommendations.", icon: "recommend" },
  { num: "03", title: "Support action and decisions", text: "We help you move forward with confidence.", icon: "act" },
  { num: "04", title: "Review, refine, and build confidence", text: "We reflect, adjust, and help you keep improving.", icon: "review" },
];

// --- Section 5a: Relevant experience ---
const experience = [
  { title: "University mentoring", text: "Supporting university students and emerging marketers through industry mentoring.", icon: '<path d="M2 8l10-4 10 4-10 4-10-4z" stroke-linejoin="round"/><path d="M6 10v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5" /><path d="M22 8v6" stroke-linecap="round"/>' },
  { title: "Business mentoring", text: "Providing practical guidance for business owners and marketing managers.", icon: '<rect x="3" y="7" width="18" height="12" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>' },
  { title: "Strategic review work", text: "Helping organisations assess plans, priorities, and capability gaps.", icon: '<rect x="6" y="4" width="12" height="16" rx="2"/><path d="M9 4h6v2a1 1 0 0 1-1 1H10a1 1 0 0 1-1-1V4z"/><path d="M9 13l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>' },
];

// --- Section 5b: Who it's for ---
const audiences = [
  { title: "Business owners", text: "who need informed marketing guidance.", icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.6 3.1-6.3 7-6.3s7 2.7 7 6.3"/>' },
  { title: "Internal marketing managers", text: "who want a sounding board.", icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.6 3.1-6.3 7-6.3s7 2.7 7 6.3"/>' },
  { title: "Growing teams", text: "building capability and confidence.", icon: '<circle cx="9" cy="8" r="3"/><path d="M2.5 19c0-3 2.9-5.3 6.5-5.3s6.5 2.3 6.5 5.3"/><path d="M16 8.3a2.6 2.6 0 1 1 0-5.1"/><path d="M15 13.8c2.9.5 5 2.5 5 5.2"/>' },
];
---
<Layout title="Consulting & Mentoring" description="Practical marketing advice, mentoring, and outside perspective.">
  <PageHero currentPage="/services/consulting-mentoring" sectionClass="relative">
    <Fragment slot="title">Real-world advice, mentoring and support as needed</Fragment>
    <Fragment slot="intro">From a one-off sounding board to ongoing mentoring, we help business owners, internal marketers and growing teams make clearer decisions, build confidence and keep moving.</Fragment>
    <OrbButton href={`${base}/contact`}>Book a mentoring call</OrbButton>
    <!-- From lg the bubble fills the right half of the hero, top to bottom (32px in from the hero's
         edges): bubble high, avatar low. left-1/2 + ml-5 starts it where the grid's right column
         starts (half way plus half the 40px gap); right-10 matches the section's side padding. -->
    <div slot="overlay" class="hidden lg:block absolute top-8 bottom-8 left-1/2 right-10 ml-5">
      <TestimonialBubble variant="hero" items={[...testimonials]} />
    </div>
  </PageHero>

  <div class="bg-[var(--color-paper)]">
    <!-- Section 1: opening text + service cards (SEO page pattern) -->
    <Section top>
      <!-- below lg the hero's art side is hidden, so the bubble shows here instead -->
      <div class="lg:hidden mb-12 flex justify-center">
        <TestimonialBubble items={[...testimonials]} />
      </div>
      <!-- PLACEHOLDER opening text (Andrew will write it) -->
      <SectionHeading
        eyebrow="How we can help"
        heading="Placeholder heading for the opening section"
        subtext="Placeholder text for the opening paragraph. Andrew will write the real wording, a sentence or two that introduces the four ways we help."
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {services.map((service) => (
          <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]">
            <img
              src={`${base}/consulting-services/${service.image}.webp`}
              alt=""
              width="300"
              height="300"
              loading="lazy"
              class="h-24 w-auto mb-4"
              aria-hidden="true"
            />
            <p class="t-title mb-2">{service.title}</p>
            <p class="t-body">{service.text}</p>
          </div>
        ))}
      </div>
    </Section>
  </div>

  <!-- Section 2: Our approach — bleed-wider band, same split as the SEO page's "Our approach" -->
  <Band>
    <div class="max-w-7xl mx-auto grid xl:grid-cols-[minmax(0,36%)_minmax(0,64%)] min-[1440px]:grid-cols-[minmax(0,40%)_minmax(0,60%)] gap-10 xl:gap-14 items-center">
      <div>
        <Eyebrow class="mb-3">Our approach</Eyebrow>
        <h2 class="t-heading text-balance mb-4">Advice that helps you think more clearly and act with confidence</h2>
        <p class="t-body mb-6 max-w-xl">
          Good marketing starts with good thinking. We bring experience, honesty, and practical ideas to help you make better decisions and move forward with confidence.
        </p>
        <ul class="space-y-3">
          {approachPoints.map((point) => (
            <li class="flex items-center gap-3">
              <IconChip icon={'<path d="M5 13l4 4L19 7"/>'} class="shrink-0" />
              <span class="t-small-strong">{point}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- card recipe = LinkedPairs.astro's (illustration beside the text), just without the link chips -->
      <div class="grid sm:grid-cols-2 gap-5 md:gap-6">
        {approachItems.map((item) => (
          <div class="flex items-center gap-4 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 [box-shadow:var(--shadow-card)]">
            <img
              src={`${base}/consulting-approach/${item.image}.webp`}
              alt=""
              width="300"
              height="300"
              loading="lazy"
              class="h-[77px] w-[77px] shrink-0 object-contain"
              aria-hidden="true"
            />
            <div class="min-w-0">
              <p class="t-title mb-1">{item.title}</p>
              <p class="t-body">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Band>

  <!-- Section 3: Situations we often help with -->
  <Section>
    <Eyebrow class="mb-8">Situations we often help with</Eyebrow>
    <div class="grid sm:grid-cols-2 border-t border-l border-[var(--color-line)] rounded-[var(--radius-card)] overflow-hidden">
      {situations.map((item) => (
        <div class="p-6 md:p-8 border-b border-r border-[var(--color-line)] flex items-start gap-4">
          <IconChip icon={item.icon} size="md" shape="lg" class="shrink-0" />
          <div>
            <p class="t-title mb-1">{item.title}</p>
            <p class="t-small">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Section 4: How this usually works -->
  <Section>
    <SectionHeading
      eyebrow="How this usually works"
      heading="A simple process for getting unstuck"
    />
    <CadenceSteps
      steps={processSteps}
      iconMode="image"
      iconBase={`${base}/consulting-process-icons`}
      gridClass="sm:grid-cols-2 lg:grid-cols-4"
      connectorBreakpoint="lg"
    />
  </Section>

  <!-- Section 5: Relevant experience + Who it's for -->
  <Section>
    <Eyebrow class="mb-6">Relevant experience</Eyebrow>
    <div class="grid sm:grid-cols-3 gap-5 mb-14">
      {experience.map((item) => (
        <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]">
          <IconChip icon={item.icon} size="md" shape="lg" class="mb-4" />
          <p class="t-title mb-1.5">{item.title}</p>
          <p class="t-small">{item.text}</p>
        </div>
      ))}
    </div>

    <Eyebrow class="mb-6">Who it's for</Eyebrow>
    <div class="grid sm:grid-cols-3 gap-5">
      {audiences.map((item) => (
        <div class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 [box-shadow:var(--shadow-card)]">
          <IconChip icon={item.icon} size="md" shape="lg" class="mb-4" />
          <p class="t-title mb-1.5">{item.title}</p>
          <p class="t-small">{item.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <CtaBand />
  <Footer />
</Layout>

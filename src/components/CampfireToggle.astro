---
// Campfire toggle concept for the "How We Work" page.
//
// Toggle mechanic adapted from "CSSspark" by Ivan Grozdic (MIT licensed):
// https://codepen.io/ig_design/pen/NeRxzj — simplified (scene chrome
// removed, since this needs to sit on the site's light background) and
// rebuilt as a proper toggle switch.
//
// v5/v5.1/v5.2: replaced the original simple gradient-teardrop flame with a
// petal-fan structure on boost only, cross-fading between the two — see git
// history for the iteration on getting that petal shape right (adapted
// from "Campfire -- Codevember #15" by Rose Liu,
// https://codepen.io/Rosefae/pen/oQBRXe, MIT licensed: a square box with
// border-radius 0 50% 0 50% points along its own diagonal; rotating it
// 45deg brings a sharp corner to point straight up from the opposite
// corner, now the shared pivot — three of these fanned per tier, three
// tiers nesting smaller/brighter for colour depth).
//
// v6 feedback (Andrew): the petal-fan flame (v5.2) is the better fire in
// general — use it as the ONE flame, always, rather than cross-fading
// between two different shapes. Toggle just makes that same flame bigger
// and faster, nothing more. Dropped the old simple-teardrop flame and the
// cross-fade entirely — this is a real simplification, not just a smaller
// version of the same complexity.
//
// v7: boosted size doubled again (rest stayed put) per feedback that the
// v6 boost wasn't big enough. The stage itself now grows on boost too
// (height 220->360px, transitioned) so the much taller flame has room —
// children are bottom-anchored, so this just adds headroom above them
// without moving anything. Glow scale and ember spawn height/travel
// distance bumped to stay proportional to the bigger flame.
---
<div class="campfire-demo" data-campfire-root>
  <div class="campfire-stage">
    <div class="campfire-glow" aria-hidden="true"></div>
    <div class="campfire-embers" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="campfire-logs" aria-hidden="true"></div>

    <!-- The one flame, always. Three tiers (outer/mid/core), each three
         petals fanned from a shared base point — two nested wrapper levels
         per petal so the static fan angle (on the wrapper) and the
         animated wave (on the .wild-flame itself) don't fight over the
         same transform. Toggle only changes size + speed (see below), not
         structure. -->
    <div class="campfire-fire" aria-hidden="true">
      <div class="wild-flames wild-flames-outer">
        <div class="wild-one"><div class="wild-flame"></div></div>
        <div class="wild-two"><div class="wild-flame"></div></div>
        <div class="wild-three"><div class="wild-flame"></div></div>
      </div>
      <div class="wild-flames wild-flames-mid">
        <div class="wild-one"><div class="wild-flame"></div></div>
        <div class="wild-two"><div class="wild-flame"></div></div>
        <div class="wild-three"><div class="wild-flame"></div></div>
      </div>
      <div class="wild-flames wild-flames-core">
        <div class="wild-one"><div class="wild-flame"></div></div>
        <div class="wild-two"><div class="wild-flame"></div></div>
        <div class="wild-three"><div class="wild-flame"></div></div>
      </div>
    </div>
  </div>

  <div class="campfire-control">
    <span class="campfire-control-label">Add a little Vandalist</span>
    <button
      type="button"
      class="campfire-switch"
      role="switch"
      aria-checked="false"
      aria-label="Increase flame intensity"
      data-campfire-switch
    >
      <span class="campfire-knob"></span>
    </button>
  </div>
</div>

<style>
  .campfire-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  /* No background/border here on purpose — this sits directly on whatever
     the page behind it is, so we can judge it against the real site bg.
     Sized as a rough approximation of an in-page footprint, not a big
     standalone hero demo — exact final size depends on where this lands. */
  .campfire-stage {
    position: relative;
    width: 100%;
    max-width: 300px;
    height: 220px;
    margin: 0 auto;
    transition: height 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* The boosted flame is much taller than the rest-state stage height —
     grow the stage itself so nothing clips. Children are bottom-anchored
     (bottom: Npx from the stage's own bottom edge), so growing the stage's
     height adds headroom above them without shifting their position. */
  .is-boosted .campfire-stage {
    height: 360px;
  }

  /* Soft warm pool of light at the base — subtle on purpose; a hazy radial
     glow that read fine over black turns into a muddy smudge over white. */
  .campfire-glow {
    position: absolute;
    left: 50%;
    bottom: 48px;
    width: 65%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 157, 31, 0.22), rgba(255, 157, 31, 0) 70%);
    filter: blur(8px);
    transition: transform 900ms cubic-bezier(0.4, 0, 0.2, 1), background 900ms ease;
  }
  .is-boosted .campfire-glow {
    transform: translateX(-50%) scale(1.9);
    background: radial-gradient(circle, rgba(255, 122, 26, 0.34), rgba(255, 122, 26, 0) 70%);
  }

  /* Simple crossed logs, no external image asset */
  .campfire-logs {
    position: absolute;
    left: 50%;
    bottom: 58px;
    width: 80px;
    height: 12px;
    transform: translateX(-50%);
  }
  .campfire-logs::before,
  .campfire-logs::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 12px;
    border-radius: 6px;
    background: linear-gradient(#4a3a2e, #2e2319);
  }
  .campfire-logs::before {
    transform: rotate(-7deg);
  }
  .campfire-logs::after {
    transform: rotate(7deg);
  }

  /* The flame's own gentle sway. Boost swaps to a faster, slightly wider
     sway (campfire-sway-fast) — same mechanism as the tier animations
     below: swap keyframe name + duration under .is-boosted rather than
     trying to transition an actively-animated property. */
  .campfire-fire {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 63px;
    width: 64px;
    height: 96px;
    margin-left: -32px;
    transform-origin: 50% 100%;
    animation: campfire-sway 2.4s ease-in-out infinite;
    transition:
      width 900ms cubic-bezier(0.4, 0, 0.2, 1),
      height 900ms cubic-bezier(0.4, 0, 0.2, 1),
      margin-left 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .is-boosted .campfire-fire {
    width: 176px;
    height: 264px;
    margin-left: -88px;
    animation: campfire-sway-fast 1.4s ease-in-out infinite;
  }

  /* Petal shape: a SQUARE box with two opposite corners rounded into a full
     circle and the other two left sharp (border-radius: 0 50% 0 50%), which
     on its own points diagonally — rotating that square 45deg brings one
     sharp corner to point straight up from the opposite corner (now the
     pivot), giving a symmetric pointed petal. Three petals per tier fan out
     from that shared base: the fan angle lives on the wrapper
     (.wild-one/two/three), the 45deg reorientation + wobble lives on the
     .wild-flame itself (baked into the wild-wave keyframe's centre, not a
     separate static transform, since animated transforms replace rather
     than combine with static ones on the same property). Three tiers
     (outer/mid/core) nest smaller and brighter inward for colour depth.
     Flat semi-transparent fills, not gradients, so overlaps build up their
     own depth. Size keyframes swap to larger *-boost variants under
     .is-boosted (can't just transition width — it's already animated by
     the same keyframe at rest, and a running animation always wins over a
     plain transition on the same property). */
  .wild-flames {
    position: absolute;
    inset: 0;
  }
  .wild-one,
  .wild-two,
  .wild-three {
    position: absolute;
    inset: 0;
    transform-origin: 50% 100%;
  }
  .wild-one {
    transform: rotate(0deg);
  }
  .wild-two {
    transform: rotate(-27deg);
  }
  .wild-three {
    transform: rotate(27deg);
  }
  .wild-flame {
    position: absolute;
    bottom: 0;
    right: 50%;
    width: 58px;
    aspect-ratio: 1;
    background: rgba(190, 75, 15, 0.55);
    border-radius: 0 50% 0 50%;
    transform-origin: 100% 100%;
    animation:
      wild-wave 1.8s ease-in-out infinite alternate,
      wild-flicker 0.6s ease-in-out infinite alternate,
      wild-size-outer 0.9s ease infinite alternate;
  }
  .wild-one .wild-flame {
    animation-delay: -0.2s;
  }
  .wild-two .wild-flame {
    animation-delay: -0.6s;
  }
  .wild-three .wild-flame {
    animation-delay: -1.1s;
  }
  .wild-flames-mid .wild-flame {
    width: 40px;
    background: rgba(255, 140, 20, 0.65);
    animation-name: wild-wave, wild-flicker, wild-size-mid;
    animation-duration: 1.4s, 0.45s, 0.6s;
  }
  .wild-flames-core .wild-flame {
    width: 24px;
    background: rgba(255, 205, 90, 0.75);
    animation-name: wild-wave, wild-flicker, wild-size-core;
    animation-duration: 1.1s, 0.35s, 0.45s;
  }

  /* Boost: same wave/flicker keyframes (faster only), but size needs its
     own larger keyframe per tier since the animated width can't just
     transition to a bigger static value. */
  .is-boosted .wild-flames-outer .wild-flame {
    animation-name: wild-wave, wild-flicker, wild-size-outer-boost;
    animation-duration: 1s, 0.35s, 0.5s;
  }
  .is-boosted .wild-flames-mid .wild-flame {
    animation-name: wild-wave, wild-flicker, wild-size-mid-boost;
    animation-duration: 0.8s, 0.28s, 0.35s;
  }
  .is-boosted .wild-flames-core .wild-flame {
    animation-name: wild-wave, wild-flicker, wild-size-core-boost;
    animation-duration: 0.6s, 0.22s, 0.28s;
  }

  @keyframes campfire-sway {
    0%,
    100% {
      transform: rotate(-2deg);
    }
    50% {
      transform: rotate(2deg);
    }
  }
  @keyframes campfire-sway-fast {
    0%,
    100% {
      transform: rotate(-3.5deg);
    }
    50% {
      transform: rotate(3.5deg);
    }
  }
  /* Centred on 45deg, not 0 — that's the reorientation that turns the
     lopsided square into an upright petal (see .wild-flame comment above).
     The ±2.5deg wobble rides on top of that base angle. Same at rest and
     boosted — only the duration differs (set per tier above). */
  @keyframes wild-wave {
    from {
      transform: rotate(42.5deg);
    }
    to {
      transform: rotate(47.5deg);
    }
  }
  @keyframes wild-flicker {
    from {
      opacity: 0.85;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes wild-size-outer {
    from {
      width: 58px;
    }
    to {
      width: 53px;
    }
  }
  @keyframes wild-size-mid {
    from {
      width: 40px;
    }
    to {
      width: 37px;
    }
  }
  @keyframes wild-size-core {
    from {
      width: 24px;
    }
    to {
      width: 22px;
    }
  }
  @keyframes wild-size-outer-boost {
    from {
      width: 160px;
    }
    to {
      width: 146px;
    }
  }
  @keyframes wild-size-mid-boost {
    from {
      width: 110px;
    }
    to {
      width: 100px;
    }
  }
  @keyframes wild-size-core-boost {
    from {
      width: 66px;
    }
    to {
      width: 60px;
    }
  }

  /* Embers — small sparks drifting up, brighter/faster once boosted, still
     warm amber-red rather than shifting to brand pink */
  .campfire-embers span {
    position: absolute;
    bottom: 108px;
    left: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #febd08;
    opacity: 0;
    animation: campfire-ember 3.2s linear infinite;
    transition: background 900ms ease;
  }
  .campfire-embers span:nth-child(1) {
    left: 46%;
    animation-delay: 0s;
    --drift: 8px;
  }
  .campfire-embers span:nth-child(2) {
    left: 54%;
    animation-delay: 0.6s;
    --drift: -6px;
  }
  .campfire-embers span:nth-child(3) {
    left: 50%;
    animation-delay: 1.2s;
    --drift: 4px;
  }
  .campfire-embers span:nth-child(4) {
    left: 44%;
    animation-delay: 1.8s;
    --drift: -10px;
  }
  .campfire-embers span:nth-child(5) {
    left: 56%;
    animation-delay: 2.4s;
    --drift: 6px;
  }
  .campfire-embers span:nth-child(6) {
    left: 48%;
    animation-delay: 3s;
    --drift: -4px;
  }
  @keyframes campfire-ember {
    0% {
      transform: translateY(0) translateX(0) scale(1);
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(-110px) translateX(var(--drift, 6px)) scale(0.4);
      opacity: 0;
    }
  }
  /* Boost travels further and starts higher — the flame's tip is much
     taller now, and embers spawning from a fixed low point would read as
     coming from the middle of the flame rather than its top. */
  @keyframes campfire-ember-boost {
    0% {
      transform: translateY(0) translateX(0) scale(1);
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(-180px) translateX(var(--drift, 6px)) scale(0.4);
      opacity: 0;
    }
  }
  .is-boosted .campfire-embers span {
    bottom: 220px;
    background: #ff5a1f;
    animation-name: campfire-ember-boost;
    animation-duration: 2s;
  }

  /* Toggle switch */
  .campfire-control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .campfire-control-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .campfire-switch {
    width: 52px;
    height: 30px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-paper-dim);
    position: relative;
    cursor: pointer;
    padding: 0;
    transition: background 300ms ease, border-color 300ms ease;
  }
  .campfire-switch[aria-checked="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-orb);
  }
  .campfire-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 2px 4px rgba(28, 27, 26, 0.25);
    transition: transform 300ms cubic-bezier(0.54, 1.6, 0.5, 1);
  }
  .campfire-switch[aria-checked="true"] .campfire-knob {
    transform: translateX(22px);
  }

  @media (prefers-reduced-motion: reduce) {
    .campfire-fire,
    .wild-flame,
    .campfire-embers span {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-campfire-switch]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const root = btn.closest("[data-campfire-root]");
      const boosted = btn.getAttribute("aria-checked") === "true";
      btn.setAttribute("aria-checked", String(!boosted));
      root?.classList.toggle("is-boosted", !boosted);
    });
  });
</script>
